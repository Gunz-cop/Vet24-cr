strado\",\"estado\"],\"properties\":{\"valorRegistrado\":{\"type\":\"boolean\"},\"estado\":{\"type\":\"string\",\"enum\":[\"afirmado\",\"no-confirmado\"]}}},\"atiendeGranja\":{\"type\":\"object\",\"required\":[\"valorRegistrado\",\"estado\"],\"properties\":{\"valorRegistrado\":{\"type\":\"boolean\"},\"estado\":{\"type\":\"string\",\"enum\":[\"afirmado\",\"no-confirmado\"]}}},\"atiendePeces\":{\"type\":\"object\",\"required\":[\"valorRegistrado\",\"estado\"],\"properties\":{\"valorRegistrado\":{\"type\":\"boolean\"},\"estado\":{\"type\":\"string\",\"enum\":[\"afirmado\",\"no-confirmado\"]}}},\"hotelMascotas\":{\"type\":\"object\",\"required\":[\"valorRegistrado\",\"estado\"],\"properties\":{\"valorRegistrado\":{\"type\":\"boolean\"},\"estado\":{\"type\":\"string\",\"enum\":[\"afirmado\",\"no-confirmado\"]}}},\"has_surgery\":{\"type\":\"object\",\"required\":[\"valorRegistrado\",\"estado\"],\"properties\":{\"valorRegistrado\":{\"type\":\"boolean\"},\"estado\":{\"type\":\"string\",\"enum\":[\"afirmado\",\"no-confirmado\"]}}},\"has_hospitalization\":{\"type\":\"object\",\"required\":[\"valorRegistrado\",\"estado\"],\"properties\":{\"valorRegistrado\":{\"type\":\"boolean\"},\"estado\":{\"type\":\"string\",\"enum\":[\"afirmado\",\"no-confirmado\"]}}},\"overnight_doctor_present\":{\"type\":\"object\",\"required\":[\"valorRegistrado\",\"estado\"],\"properties\":{\"valorRegistrado\":{\"type\":\"boolean\"},\"estado\":{\"type\":\"string\",\"enum\":[\"afirmado\",\"no-confirmado\"]}}},\"accepts_emergency_walkins\":{\"type\":\"object\",\"required\":[\"valorRegistrado\",\"estado\"],\"properties\":{\"valorRegistrado\":{\"type\":\"boolean\"},\"estado\":{\"type\":\"string\",\"enum\":[\"afirmado\",\"no-confirmado\"]}}}}},\"advertencias\":{\"type\":\"array\",\"items\":{\"type\":\"string\",\"enum\":[\"Confirma por teléfono el horario y la atención antes de trasladarte; este catálogo no informa disponibilidad en tiempo real.\",\"Una capacidad afirmada refleja lo registrado en la ficha; no confirmado no significa que el servicio no exista.\",\"Lee las notas y el texto de la ficha: los servicios pueden tener restricciones de especie, horario o reserva.\"]}}}}}}}}}}"
