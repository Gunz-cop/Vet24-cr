+---
+import type { TypedLink } from '../lib/blog-links';
+interface Props { links: TypedLink[]; title?: string }
+const { links, title = 'Guías relacionadas' } = Astro.props;
+---
+{links.length > 0 && (
+  <section data-blog-links aria-label={title} class="mt-8 rounded-2xl border border-brand-card-border bg-brand-card-bg p-6">
+    <h2 class="text-xl font-bold text-brand-text mb-4">{title}</h2>
+    <ul class="space-y-3">
+      {links.map(link => <li><a data-link-family={link.family} data-link-identity={link.identity} href={link.href} class="text-brand-primary underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-4">{link.label}</a></li>)}
+    </ul>
+  </section>
+)}
