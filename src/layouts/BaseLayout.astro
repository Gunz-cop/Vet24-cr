---
import '../styles/global.css';
import { canonicalUrl as buildCanonicalUrl } from '../lib/seo';
// Al activar Ezoic, AdSense se conecta como fuente de demanda desde el panel
// de Ezoic y su script deja de ser necesario en este head.
import { EZOIC_ENABLED } from '../config/ads';

interface Props {
  title: string;
  description?: string;
  canonicalUrl?: string;
  image?: string;
}

const { title, description, canonicalUrl, image } = Astro.props;
const siteName = "Vet24 Costa Rica";
const fullTitle = `${title} | ${siteName}`;
const metaDesc = description || "Directorio de clínicas veterinarias en Costa Rica con servicio de emergencias 24/7 y horarios nocturnos.";
const canonical = canonicalUrl || buildCanonicalUrl(Astro.url.pathname);

// Resolve absolute URL for the Open Graph image
const shareImage = image || "/images/og-share-default.png";
const shareImageUrl = new URL(shareImage, Astro.url.origin).href;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- AdSense: carga asíncrona para no bloquear el renderizado inicial. -->
    <script
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-5094917394495886"
      crossorigin="anonymous"
      is:inline
    ></script>

    {EZOIC_ENABLED && (
      <>
        <!-- Ezoic: integración JavaScript (la única compatible con hosting en
             Cloudflare Workers; la de nameservers rompería las rutas del Worker). -->
        <script async src="https://www.ezojs.com/ezoic/sa.min.js" is:inline></script>
        <script is:inline>
          window.ezstandalone = window.ezstandalone || {};
          ezstandalone.cmd = ezstandalone.cmd || [];
        </script>
      </>
    )}

    <!-- SEO Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="description" content={metaDesc} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDesc} />
    <meta property="og:image" content={shareImageUrl} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonical} />
    <meta property="twitter:title" content={fullTitle} />
    <meta property="twitter:description" content={metaDesc} />
    <meta property="twitter:image" content={shareImageUrl} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="icon" href="/favicon.ico?v=2" sizes="any" />
    <link rel="shortcut icon" href="/favicon.ico?v=2" type="image/x-icon" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Theme Manager Initialization Script (Blocks render to avoid flash of unstyled content) -->
    <script is:inline>
      const getTheme = () => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        return 'dark'; // default to dark mode
      };

      const theme = getTheme();
      if (theme === 'light') {
        document.documentElement.classList.add('light');
      } else {
        document.documentElement.classList.remove('light');
      }
    </script>
  </head>
  <body class="bg-brand-bg text-brand-text min-h-screen flex flex-col font-['Plus_Jakarta_Sans',sans-serif] antialiased selection:bg-brand-primary/25 transition-colors duration-200">
    <a href="#contenido" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60] focus:px-4 focus:py-2 focus:rounded-lg focus:bg-brand-primary focus:text-white focus:text-sm focus:font-bold">
      Saltar al contenido
    </a>

    <!-- Header / Navbar -->
    <header class="border-b border-brand-card-border bg-brand-bg/85 backdrop-blur-md sticky top-0 z-50 transition-colors duration-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-3">
        <a href="/" class="flex items-center gap-2.5 group shrink-0" id="nav-logo">
          <div class="w-9 h-9 rounded-xl bg-brand-primary/15 border border-brand-primary/30 flex items-center justify-center group-hover:bg-brand-primary/25 transition-colors">
            <!-- Cross/health icon -->
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5 text-brand-primary">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z" />
            </svg>
          </div>
          <div class="flex flex-col leading-none">
            <span class="font-['Outfit',sans-serif] text-lg font-bold tracking-tight text-brand-text">
              Vet<span class="text-brand-primary">24</span>
            </span>
            <span class="text-[10px] font-semibold text-brand-text-muted tracking-wide">Costa Rica</span>
          </div>
        </a>

        <nav class="flex items-center gap-2 sm:gap-4" aria-label="Navegación principal">
          <a href="/" class="hidden md:inline-block text-sm font-semibold text-brand-text-muted hover:text-brand-text transition-colors px-2 py-1" id="nav-home">
            Inicio
          </a>
          <a href="/#directorio" class="hidden md:inline-block text-sm font-semibold text-brand-text-muted hover:text-brand-text transition-colors px-2 py-1" id="nav-directory">
            Directorio
          </a>

          <!-- Theme Switcher Button -->
          <button
            id="btn-theme-toggle"
            class="p-2.5 rounded-xl border border-brand-card-border bg-brand-card-bg hover:border-brand-primary/40 text-brand-text-muted hover:text-brand-primary transition-colors cursor-pointer"
            aria-label="Alternar tema claro u oscuro"
          >
            <!-- Sun Icon (shown in dark theme) -->
            <svg id="theme-toggle-sun" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 hidden">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m0 13.5V21M4.72 4.72l1.59 1.59M16.127 16.127l1.59 1.59M3 12h2.25m13.5 0H21M4.72 19.28l1.59-1.59M16.127 7.873l1.59-1.59M12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10Z" />
            </svg>
            <!-- Moon Icon (shown in light theme) -->
            <svg id="theme-toggle-moon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 hidden">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z" />
            </svg>
          </button>

          <button
            id="btn-sos-emergency"
            data-sos-trigger
            class="inline-flex items-center gap-2 px-3.5 py-2 sm:px-4 sm:py-2.5 text-xs sm:text-sm font-bold rounded-xl bg-brand-emergency hover:bg-brand-emergency-hover text-white transition-colors cursor-pointer shadow-lg shadow-brand-emergency/20"
            title="Encuentra la veterinaria abierta más cercana ahora"
          >
            <span class="relative flex h-2 w-2">
              <span class="animate-sos-ping absolute inline-flex h-full w-full rounded-full bg-white opacity-80"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-white"></span>
            </span>
            Emergencia
          </button>
        </nav>
      </div>
    </header>

    <!-- Main Content -->
    <main id="contenido" class="flex-grow max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-brand-card-border bg-brand-bg py-10 mt-12 text-brand-text-muted transition-colors duration-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col gap-8">
        <div class="flex flex-col md:flex-row md:items-start justify-between gap-6">
          <div class="max-w-md">
            <span class="font-['Outfit',sans-serif] text-base font-bold text-brand-text">
              Vet<span class="text-brand-primary">24</span> Costa Rica
            </span>
            <p class="text-sm mt-2 leading-relaxed">
              Herramienta gratuita para encontrar veterinarias abiertas, de guardia y 24/7 en Costa Rica. En una emergencia, llama siempre antes de trasladarte.
            </p>
          </div>
          <nav class="flex flex-wrap items-center gap-x-6 gap-y-3 text-sm" aria-label="Enlaces del sitio">
            <a href="/#directorio" class="hover:text-brand-text transition-colors">Directorio</a>
            <a href="/acerca/" class="hover:text-brand-text transition-colors">Acerca de</a>
            <a href="/terminos/" class="hover:text-brand-text transition-colors">Términos</a>
            <a href="/privacidad/" class="hover:text-brand-text transition-colors">Privacidad</a>
            <a href="/cookies/" class="hover:text-brand-text transition-colors">Cookies</a>
          </nav>
        </div>
        <p class="text-xs text-brand-text-muted/80 border-t border-brand-card-border pt-5">
          © {new Date().getFullYear()} Vet24 Costa Rica. Sitio informativo: los horarios y servicios pueden cambiar sin previo aviso; confírmalos por teléfono.
        </p>
      </div>
    </footer>

    <script>
      // SOS button handling
      const triggerSOSFlow = () => {
        const path = window.location.pathname;
        const isHomepage = path === '/' || path === '/index.html' || path.endsWith('/veterinarias-cr/dist/index.html');
        if (isHomepage) {
          window.dispatchEvent(new CustomEvent('sos-trigger'));
        } else {
          try {
            window.sessionStorage.setItem('vet24-sos-pending', 'true');
          } catch (e) {
            console.warn('No se pudo guardar el estado SOS:', e);
          }
          window.location.href = '/?sos=true#directorio';
        }
      };

      document.querySelectorAll('[data-sos-trigger]').forEach((btn) => {
        btn.addEventListener('click', triggerSOSFlow);
      });

      // Theme toggle handling
      const themeToggleBtn = document.getElementById('btn-theme-toggle');
      const sunIcon = document.getElementById('theme-toggle-sun');
      const moonIcon = document.getElementById('theme-toggle-moon');

      const updateIcons = () => {
        const isLight = document.documentElement.classList.contains('light');
        if (isLight) {
          sunIcon?.classList.add('hidden');
          moonIcon?.classList.remove('hidden');
        } else {
          sunIcon?.classList.remove('hidden');
          moonIcon?.classList.add('hidden');
        }
      };

      // Set initial icon states
      updateIcons();

      themeToggleBtn?.addEventListener('click', () => {
        const isCurrentlyLight = document.documentElement.classList.toggle('light');
        localStorage.setItem('theme', isCurrentlyLight ? 'light' : 'dark');
        updateIcons();

        // Dispatch theme change event so that Leaflet map can refresh
        window.dispatchEvent(new CustomEvent('theme-changed', {
          detail: { theme: isCurrentlyLight ? 'light' : 'dark' }
        }));
      });

      // Lightweight conversion analytics for SEO landing pages.
      document.addEventListener('click', (event) => {
        const target = event.target as HTMLElement | null;
        const el = target?.closest('a,button') as HTMLElement | null;
        if (!el) return;

        const href = el instanceof HTMLAnchorElement ? el.href : '';
        const id = el.id || '';
        let action = '';

        if (href.startsWith('tel:')) action = 'call_click';
        else if (href.includes('wa.me')) action = 'whatsapp_click';
        else if (href.includes('waze.com')) action = 'waze_click';
        else if (href.includes('google.com/maps')) action = 'maps_click';
        else if (el.classList.contains('share-btn')) action = 'share_click';
        else if (id === 'btn-open-report') action = 'report_open';

        if (!action) return;

        const payload = JSON.stringify({
          query: window.location.pathname,
          province: document.querySelector('[data-page-province]')?.getAttribute('data-page-province') || null,
          canton: document.querySelector('[data-page-zone]')?.getAttribute('data-page-zone') || null,
          filter_type: action,
        });

        if (navigator.sendBeacon) {
          navigator.sendBeacon('/api/analytics', new Blob([payload], { type: 'application/json' }));
          return;
        }

        fetch('/api/analytics', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: payload,
          keepalive: true,
        }).catch(() => {});
      }, { capture: true });
    </script>
    {EZOIC_ENABLED && (
      <script is:inline>
        // Una sola llamada con todos los placeholders presentes en la página.
        (() => {
          const ids = window.__vet24EzoicIds || [];
          if (!ids.length) return;
          window.ezstandalone = window.ezstandalone || {};
          ezstandalone.cmd = ezstandalone.cmd || [];
          ezstandalone.cmd.push(() => ezstandalone.showAds(...ids));
        })();
      </script>
    )}
  </body>
</html>
