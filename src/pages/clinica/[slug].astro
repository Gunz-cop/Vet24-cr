---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BadgeHorario from '../../components/BadgeHorario.astro';

export async function getStaticPaths() {
  const allClinicas = await getCollection('clinicas');
  
  return allClinicas.map(clinica => ({
    params: { slug: clinica.data.slug },
    props: { clinica }
  }));
}

const { clinica } = Astro.props;
const { Content } = await render(clinica);

const {
  nombre,
  provincia,
  zona,
  direccion,
  telefono1,
  telefono2,
  whatsapp,
  horarioTexto,
  categoriaHorario,
  emergencias24h,
  atiendeExoticos,
  cirugiaEmergencia,
  web,
  facebook,
  instagram,
  copyDiferenciador,
  confidence_score = "medium",
  record_status = "PARTIAL",
  emergency_tier = "Tier C",
  last_verified = "",
  phone_verified = false,
  address_verified = false,
  schedule_verified = false,
  emergency_verified = false,
  has_surgery = false,
  has_hospitalization = false,
  overnight_doctor_present = false,
  accepts_emergency_walkins = false,
  verification_notes = [],
  verification_source = "",
  waze_url = "",
  maps_url = ""
} = clinica.data;

// Clean phone numbers for href links
const cleanPhone = (num: string) => num.replace(/\D/g, '');
const tel1Href = telefono1 ? `tel:+506${cleanPhone(telefono1)}` : null;
const tel2Href = telefono2 ? `tel:+506${cleanPhone(telefono2)}` : null;
const whatsappHref = whatsapp ? `https://wa.me/506${cleanPhone(whatsapp)}` : null;
const webUrl = web ? (web.startsWith('http') ? web : `https://${web}`) : null;

// JSON-LD Schema Markup
const schemaMarkup = {
  "@context": "https://schema.org",
  "@type": ["LocalBusiness", "VeterinaryCare"],
  "@id": Astro.url.href,
  "name": nombre,
  "description": copyDiferenciador,
  "image": "https://images.unsplash.com/photo-1584132967334-10e028bd69f7?auto=format&fit=crop&q=80&w=800",
  "url": webUrl || Astro.url.href,
  "telephone": telefono1 || whatsapp || "",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": direccion,
    "addressLocality": zona,
    "addressRegion": provincia,
    "addressCountry": "CR"
  },
  "openingHoursSpecification": emergencias24h ? [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": [
        "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"
      ],
      "opens": "00:00",
      "closes": "23:59"
    }
  ] : undefined
};

const pageTitle = `${nombre} | Vet24 Costa Rica`;
const pageDesc = `${nombre} en ${zona}, ${provincia}. ${copyDiferenciador}`;
---

<BaseLayout title={pageTitle} description={pageDesc}>
  <!-- Inject Schema Markup -->
  <script type="application/ld+json" set:html={JSON.stringify(schemaMarkup)} />

  <div class="max-w-5xl mx-auto py-4">
    <!-- Back Button -->
    <a href="/" class="inline-flex items-center gap-1.5 text-xs font-semibold text-rose-400 hover:text-rose-300 mb-6 transition-colors" id="btn-back">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-3.5 h-3.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
      </svg>
      Volver al Directorio
    </a>

    <!-- Grid Container -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Main Content Info (2 Cols) -->
      <div class="lg:col-span-2 flex flex-col gap-6">
        
        <!-- Header Info -->
        <header class="bg-slate-900/20 border border-slate-900 rounded-2xl p-6 sm:p-8 relative overflow-hidden">
          <div class="absolute -top-[10%] -left-[10%] w-[30%] h-[30%] rounded-full bg-rose-500/5 blur-2xl"></div>
          
          <div class="flex flex-wrap items-center gap-2.5 mb-4 relative z-10">
            <BadgeHorario categoriaHorario={categoriaHorario} />
            {record_status === 'VERIFIED' ? (
              <span class="inline-flex items-center gap-1 px-2.5 py-0.5 text-xs font-bold rounded-full bg-emerald-500/10 text-emerald-450 border border-emerald-500/25 shadow-sm shadow-emerald-950/20" title="Información auditada por llamada de prueba">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-3.5 h-3.5">
                  <path fill-rule="evenodd" d="M16.403 12.652a3 3 0 0 0 0-5.304 3 3 0 0 0-3.75-3.751 3 3 0 0 0-5.305 0 3 3 0 0 0-3.751 3.75 3 3 0 0 0 0 5.305 3 3 0 0 0 3.75 3.751 3 3 0 0 0 5.305 0 3 3 0 0 0 3.751-3.75Zm-7.446-3.998a.75.75 0 1 1 1.086-1.032l2.5 2.625a.75.75 0 0 1-.035 1.066l-3.5 3.25a.75.75 0 0 1-1.086-1.033l2.94-2.73-1.905-2.001Z" clip-rule="evenodd" />
                </svg>
                Guardia Auditada
              </span>
            ) : record_status === 'REVIEW_REQUIRED' ? (
              <span class="inline-flex items-center gap-1 px-2.5 py-0.5 text-xs font-bold rounded-full bg-amber-500/10 text-amber-450 border border-amber-500/25">
                ⚠️ Pendiente de Auditoría
              </span>
            ) : (
              <span class="inline-flex items-center gap-1 px-2.5 py-0.5 text-xs font-bold rounded-full bg-slate-800 text-slate-350 border border-slate-700">
                Información Parcial
              </span>
            )}
          </div>

          <h1 class="text-3xl sm:text-4xl font-extrabold text-white mb-3 font-['Outfit',sans-serif] relative z-10" id="clinica-name">
            {nombre}
          </h1>

          <div class="flex items-start gap-1.5 text-sm text-slate-400 mb-4 relative z-10">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 mt-0.5 text-slate-500 shrink-0">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
            </svg>
            <span class="font-medium text-slate-200">
              {zona}, {provincia} — {direccion}
            </span>
          </div>
        </header>

        <!-- Quick Emergency Actions Bar (Dominant CTAs) -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          {tel1Href ? (
            <a href={tel1Href} class="flex flex-col items-center justify-center gap-1.5 p-4 rounded-2xl bg-gradient-to-br from-rose-500 to-red-600 text-white hover:from-rose-600 hover:to-red-700 shadow-lg shadow-rose-950/20 active:scale-95 transition-all text-center group" id="btn-quick-call">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-6 h-6 animate-pulse group-hover:scale-110 transition-transform">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.824-1.802-5.14-4.117-6.942-6.942l1.293-.97c.362-.272.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
              </svg>
              <span class="text-xs font-black uppercase tracking-wider">Llamar Ahora</span>
              <span class="text-[10px] text-rose-100 font-semibold opacity-90">{telefono1}</span>
            </a>
          ) : (
            <div class="flex flex-col items-center justify-center p-4 rounded-2xl bg-slate-900/40 border border-slate-800 text-slate-500 text-center opacity-50 cursor-not-allowed">
              <span class="text-xs font-black uppercase tracking-wider">Sin Teléfono</span>
            </div>
          )}

          {whatsappHref ? (
            <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="flex flex-col items-center justify-center gap-1.5 p-4 rounded-2xl bg-slate-900/30 border border-emerald-500/20 hover:bg-emerald-500/5 hover:border-emerald-500/40 text-emerald-400 active:scale-95 transition-all text-center group" id="btn-quick-wa">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16" class="group-hover:scale-110 transition-transform">
                <path d="M13.601 2.326A7.85 7.85 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.93a7.9 7.9 0 0 0 1.08 3.951L0 16l4.2-1.1a7.9 7.9 0 0 0 3.79 1.1h.004c4.368 0 7.926-3.558 7.93-7.93A7.9 7.9 0 0 0 13.6 2.326zM7.994 14.521a6.6 6.6 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.56 6.56 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592m3.69-4.98c-.202-.101-1.202-.594-1.385-.66-.18-.066-.313-.1-.443.1-.129.199-.5.63-.614.763-.114.133-.227.15-.429.049-.202-.102-.852-.314-1.624-.997-.6-.537-1.005-1.201-1.123-1.401-.118-.2-.012-.307.089-.408.09-.091.201-.233.301-.35.1-.117.135-.198.201-.33.067-.133.033-.25-.017-.35-.05-.1-1.385-3.322-1.385-3.322-.202-.489-.406-.407-.55-.407h-.469c-.18 0-.47.067-.716.337-.247.27-1.17 1.144-1.17 2.789s1.202 3.23 1.368 3.45c.166.22 2.36 3.6 5.717 5.048.8.345 1.424.551 1.912.707.8.254 1.528.218 2.102.132.64-.096 1.202-.492 1.372-1.026.17-.534.17-1.001.12-1.096-.05-.095-.18-.147-.38-.25"/>
              </svg>
              <span class="text-xs font-black uppercase tracking-wider">WhatsApp</span>
              <span class="text-[10px] text-emerald-400 font-semibold opacity-90">Enviar mensaje</span>
            </a>
          ) : (
            <div class="flex flex-col items-center justify-center p-4 rounded-2xl bg-slate-900/40 border border-slate-800 text-slate-500 text-center opacity-50 cursor-not-allowed">
              <span class="text-xs font-black uppercase tracking-wider">Sin WhatsApp</span>
            </div>
          )}

          {waze_url ? (
            <a href={waze_url} target="_blank" rel="noopener noreferrer" class="flex flex-col items-center justify-center gap-1.5 p-4 rounded-2xl bg-slate-900/30 border border-cyan-500/20 hover:bg-cyan-500/5 hover:border-cyan-500/40 text-cyan-400 active:scale-95 transition-all text-center group" id="btn-quick-waze">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:scale-110 transition-transform">
                <circle cx="12" cy="12" r="10" />
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
                <path d="M2 12h20" />
              </svg>
              <span class="text-xs font-black uppercase tracking-wider">Waze</span>
              <span class="text-[10px] text-cyan-400 font-semibold opacity-90">Iniciar Ruta</span>
            </a>
          ) : (
            <a href={`https://waze.com/ul?q=${encodeURIComponent(nombre + ', ' + direccion)}`} target="_blank" rel="noopener noreferrer" class="flex flex-col items-center justify-center gap-1.5 p-4 rounded-2xl bg-slate-900/30 border border-slate-850 hover:bg-slate-800/20 text-slate-400 active:scale-95 transition-all text-center group" id="btn-quick-waze-search">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:scale-110 transition-transform opacity-70">
                <circle cx="12" cy="12" r="10" />
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
                <path d="M2 12h20" />
              </svg>
              <span class="text-xs font-black uppercase tracking-wider">Waze Web</span>
              <span class="text-[10px] text-slate-500 font-semibold">Iniciar Navegación</span>
            </a>
          )}

          {maps_url ? (
            <a href={maps_url} target="_blank" rel="noopener noreferrer" class="flex flex-col items-center justify-center gap-1.5 p-4 rounded-2xl bg-slate-900/30 border border-amber-500/20 hover:bg-amber-500/5 hover:border-amber-500/40 text-amber-400 active:scale-95 transition-all text-center group" id="btn-quick-maps">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:scale-110 transition-transform">
                <polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21" />
                <line x1="9" y1="3" x2="9" y2="18" />
                <line x1="15" y1="6" x2="15" y2="21" />
              </svg>
              <span class="text-xs font-black uppercase tracking-wider">Google Maps</span>
              <span class="text-[10px] text-amber-400 font-semibold opacity-90">Ver en Mapa</span>
            </a>
          ) : (
            <a href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(nombre + ', ' + direccion)}`} target="_blank" rel="noopener noreferrer" class="flex flex-col items-center justify-center gap-1.5 p-4 rounded-2xl bg-slate-900/30 border border-slate-850 hover:bg-slate-800/20 text-slate-400 active:scale-95 transition-all text-center group" id="btn-quick-maps-search">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:scale-110 transition-transform opacity-70">
                <polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21" />
                <line x1="9" y1="3" x2="9" y2="18" />
                <line x1="15" y1="6" x2="15" y2="21" />
              </svg>
              <span class="text-xs font-black uppercase tracking-wider">Google Maps</span>
              <span class="text-[10px] text-slate-500 font-semibold">Buscar Ubicación</span>
            </a>
          )}
        </div>

        <!-- Verification & Trust Panel -->
        <section class="bg-slate-900/30 border border-slate-900 rounded-2xl p-6 sm:p-8 flex flex-col gap-4 relative overflow-hidden" aria-labelledby="auditoria-title">
          <div class="absolute -bottom-[20%] -right-[10%] w-[40%] h-[40%] rounded-full bg-emerald-500/5 blur-3xl"></div>
          
          <div class="flex flex-wrap items-center justify-between gap-4 border-b border-slate-900 pb-4">
            <div>
              <h2 id="auditoria-title" class="text-lg font-bold text-white font-['Outfit',sans-serif] flex items-center gap-1.5">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5 text-emerald-450">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 0 1-1.043 3.296 3.745 3.745 0 0 1-3.296 1.043A3.745 3.745 0 0 1 12 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 0 1-3.296-1.043 3.745 3.745 0 0 1-1.043-3.296A3.745 3.745 0 0 1 3 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 0 1 1.043-3.296 3.746 3.746 0 0 1 3.296-1.043A3.746 3.746 0 0 1 12 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 0 1 3.296 1.043 3.746 3.746 0 0 1 1.043 3.296A3.745 3.745 0 0 1 21 12Z" />
                </svg>
                Confiabilidad del Registro
              </h2>
              <p class="text-xs text-slate-400 mt-0.5">
                Nivel de confiabilidad y verificación operativa bajo situaciones de estrés.
              </p>
            </div>
            
            <div class="flex items-center gap-2">
              <span class={`px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider border ${
                confidence_score === 'high' ? 'bg-emerald-500/10 border-emerald-500/30 text-emerald-400' :
                confidence_score === 'medium' ? 'bg-amber-500/10 border-amber-500/30 text-amber-400' :
                'bg-rose-500/10 border-rose-500/30 text-rose-400'
              }`}>
                {confidence_score === 'high' ? 'Alta Confiabilidad 🟢' :
                 confidence_score === 'medium' ? 'Media Confiabilidad 🟡' :
                 'Baja Confiabilidad 🔴'}
              </span>
            </div>
          </div>

          <!-- Audit Checklist Grid -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 my-2">
            <!-- Tier Badge -->
            <div class="p-4 rounded-xl bg-slate-950/45 border border-slate-900 flex flex-col justify-between">
              <span class="text-[10px] text-slate-500 font-extrabold uppercase tracking-wider">Clasificación Operativa</span>
              <span class="text-sm font-bold text-slate-200 mt-1 flex items-center gap-1.5">
                <span class="px-2 py-0.5 rounded bg-rose-500/20 text-rose-450 border border-rose-500/30 text-xs font-black">{emergency_tier}</span>
                {emergency_tier === 'Tier A' ? 'Emergencia Real 24/7' :
                 emergency_tier === 'Tier B' ? 'Emergencia Parcial' :
                 emergency_tier === 'Tier C' ? 'Clínica Diurna' :
                 'Pendiente de Auditoría'}
              </span>
            </div>

            <!-- Overnight Doctor Present -->
            <div class="p-4 rounded-xl bg-slate-950/45 border border-slate-900 flex flex-col justify-between">
              <span class="text-[10px] text-slate-500 font-extrabold uppercase tracking-wider">Médico Físico Permanente en Sitio</span>
              <span class="text-sm font-bold mt-1 flex items-center gap-1.5">
                {overnight_doctor_present ? (
                  <span class="text-emerald-450 flex items-center gap-1">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.857-9.809a.75.75 0 0 0-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 1 0-1.06 1.061l2.5 2.5a.75.75 0 0 0 1.137-.089l4-5.5Z" clip-rule="evenodd" />
                    </svg>
                    Confirmado Permanente
                  </span>
                ) : (
                  <span class="text-slate-500 flex items-center gap-1">
                    🚫 No confirmado / Solo llamado
                  </span>
                )}
              </span>
            </div>

            <!-- Hospitalization -->
            <div class="p-4 rounded-xl bg-slate-950/45 border border-slate-900 flex flex-col justify-between">
              <span class="text-[10px] text-slate-500 font-extrabold uppercase tracking-wider">Facilidad de Hospitalización</span>
              <span class="text-sm font-bold mt-1 flex items-center gap-1.5">
                {has_hospitalization ? (
                  <span class="text-emerald-450 flex items-center gap-1">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.857-9.809a.75.75 0 0 0-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 1 0-1.06 1.061l2.5 2.5a.75.75 0 0 0 1.137-.089l4-5.5Z" clip-rule="evenodd" />
                    </svg>
                    Disponible
                  </span>
                ) : (
                  <span class="text-slate-500 flex items-center gap-1">
                    🚫 No disponible / No confirmado
                  </span>
                )}
              </span>
            </div>

            <!-- Last Audit Date -->
            <div class="p-4 rounded-xl bg-slate-950/45 border border-slate-900 flex flex-col justify-between">
              <span class="text-[10px] text-slate-500 font-extrabold uppercase tracking-wider">Última Auditoría Operativa</span>
              <span class="text-sm font-bold text-slate-200 mt-1 flex items-center gap-1">
                {last_verified ? (
                  <span>📅 {last_verified} ({verification_source || 'Llamada directa'})</span>
                ) : (
                  <span class="text-amber-400">⚠️ Pendiente de validar</span>
                )}
              </span>
            </div>
          </div>

          <!-- Verification Notes -->
          {verification_notes.length > 0 && (
            <div class="mt-2 p-4 rounded-xl bg-rose-500/5 border border-rose-500/15">
              <span class="block text-[10px] text-rose-450 font-extrabold uppercase tracking-wider mb-2">Notas de Auditoría Médica:</span>
              <ul class="list-disc list-inside text-xs text-slate-300 flex flex-col gap-1.5">
                {verification_notes.map((note) => (
                  <li>{note}</li>
                ))}
              </ul>
            </div>
          )}
        </section>


        <!-- Services & Specs -->
        <section class="bg-slate-900/20 border border-slate-900 rounded-2xl p-6 sm:p-8" aria-labelledby="servicios-title">
          <h2 id="servicios-title" class="text-xl font-bold text-white mb-4 font-['Outfit',sans-serif]">
            Servicios y Especialidades
          </h2>
          
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div class={`p-4 rounded-xl border flex flex-col justify-between ${
              emergencias24h ? "bg-rose-500/5 border-rose-500/20 text-rose-300" : "bg-slate-950/40 border-slate-800 text-slate-400"
            }`}>
              <span class="text-xs font-semibold uppercase tracking-wider mb-2">Emergencias 24/7</span>
              <div class="flex items-center gap-1.5 font-bold text-sm">
                {emergencias24h ? (
                  <span class="text-rose-400 flex items-center gap-1">
                    <span class="h-2 w-2 rounded-full bg-rose-500 animate-pulse"></span>
                    SÍ Disponible
                  </span>
                ) : (
                  <span class="text-slate-500">No Disponible</span>
                )}
              </div>
            </div>

            <div class={`p-4 rounded-xl border flex flex-col justify-between ${
              atiendeExoticos ? "bg-emerald-500/5 border-emerald-500/20 text-emerald-300" : "bg-slate-950/40 border-slate-800 text-slate-400"
