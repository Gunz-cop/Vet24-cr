---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BadgeHorario from '../../components/BadgeHorario.astro';
import linkzipCache from '../../linkzip-cache.json';
import { absoluteUrl, canonicalUrl } from '../../lib/seo';
import { getClinicZoneSlug } from '../../lib/zones';
import AdBanner from '../../components/AdBanner.astro';
import {
  overnightDoctorStatus,
  hospitalizationStatus,
  emergency247Status,
  petHotelStatus,
  capabilityStatus,
  recordStatusBadge,
  reviewEvidenceBadge,
  lastReviewLabel,
} from '../../lib/capabilityStatus';

export async function getStaticPaths() {
  const allClinicas = await getCollection('clinicas');
  
  return allClinicas.map(clinica => ({
    params: { slug: clinica.data.slug },
    props: { clinica }
  }));
}

const { clinica } = Astro.props;
const { Content } = await render(clinica);

const {
  nombre,
  provincia,
  zona,
  direccion,
  telefono1,
  telefono2,
  whatsapp,
  horarioTexto,
  categoriaHorario,
  emergencias24h,
  atiendeExoticos,
  hotelMascotas = false,
  hotelVerificacion = "no-confirmado",
  hotelFuente = "",
  cirugiaEmergencia,
  web,
  facebook,
  instagram,
  copyDiferenciador,
  confidence_score = "medium",
  record_status = "PARTIAL",
  emergency_tier = "Tier C",
  last_verified = "",
  phone_verified = false,
  address_verified = false,
  schedule_verified = false,
  emergency_verified = false,
  has_surgery = false,
  has_hospitalization = false,
  overnight_doctor_present = false,
  accepts_emergency_walkins = false,
  verification_notes = [],
  verification_source = "",
  latitude = 0,
  longitude = 0,
  waze_url = "",
  maps_url = ""
} = clinica.data;

// Hotfix semántico: `false` en estos campos NO demuestra ausencia del servicio,
// solo que no está confirmado. Ver src/lib/capabilityStatus.ts.
const overnightStatus = overnightDoctorStatus(overnight_doctor_present);
const hospitalizationState = hospitalizationStatus(has_hospitalization);
const emergency247Fact = emergency247Status(emergencias24h, 'Confirmada en esta ficha');
const emergency247Service = emergency247Status(emergencias24h);
const hotelFact = petHotelStatus(hotelMascotas, hotelVerificacion);
const hotelService = petHotelStatus(hotelMascotas, hotelVerificacion, 'Sí Disponible');
const exoticsStatus = capabilityStatus(atiendeExoticos, 'SÍ Atiende');
const emergencySurgeryStatus = capabilityStatus(cirugiaEmergencia, 'SÍ Disponible');

// Auditoría: `record_status` por sí solo no prueba una llamada de verificación.
const verificationInput = {
  record_status,
  last_verified,
  verification_source,
  phone_verified,
  address_verified,
  schedule_verified,
};
const statusBadge = recordStatusBadge(record_status);
const evidenceBadge = reviewEvidenceBadge(verificationInput);
const lastReview = lastReviewLabel(verificationInput);

// Clean phone numbers for href links
const cleanPhone = (num: string) => num.replace(/\D/g, '');
const tel1Href = telefono1 ? `tel:+506${cleanPhone(telefono1)}` : null;
const tel2Href = telefono2 ? `tel:+506${cleanPhone(telefono2)}` : null;
const whatsappHref = whatsapp ? `https://wa.me/506${cleanPhone(whatsapp)}` : null;
const webUrl = web ? (web.startsWith('http') ? web : `https://${web}`) : null;
const facebookUrl = facebook ? (facebook.startsWith('http') ? facebook : `https://${facebook}`) : null;
const instagramUrl = instagram ? (instagram.startsWith('http') ? instagram : `https://instagram.com/${instagram.replace('@', '')}`) : null;

// Shortened links using Linkzip API cache (falling back to original URLs)
const shortenedWeb = webUrl ? (linkzipCache[webUrl] || webUrl) : null;
const shortenedFacebook = facebookUrl ? (linkzipCache[facebookUrl] || facebookUrl) : null;
const shortenedInstagram = instagramUrl ? (linkzipCache[instagramUrl] || instagramUrl) : null;

const normalizeHours = (text: string) => {
  return text
    .toLowerCase()
    .replace(/\s+/g, '')
    .replace(/:00/g, '')
    .replace(/a\.m\.|am/g, 'am')
    .replace(/p\.m\.|pm/g, 'pm');
};

const hourTo24 = (value: string) => {
  const match = value.match(/^(\d{1,2})(am|pm)$/);
  if (!match) return null;
  let hour = Number(match[1]);
  const period = match[2];
  if (period === 'pm' && hour < 12) hour += 12;
  if (period === 'am' && hour === 12) hour = 0;
  return hour;
};

const rangeToSchedule = (days: string, start: string, end: string) => {
  const startHour = hourTo24(start);
  const endHour = hourTo24(end);
  if (startHour === null || endHour === null) return "";
  return `${days}:${startHour}-${endHour}`;
};

const getClientScheduleAttr = () => {
  if (emergencias24h) return "24h";

  const text = normalizeHours(horarioTexto);
  if (text.includes("oxígeno") || text.includes("10am-9pm")) {
    return "1-6:10-21,0:10-20";
  }
  if (text.includes("concasa") || text.includes("8am-9pm")) {
    return "1-5:8-21,6:9-19,0:9-17";
  }
  if (text.includes("medical care") || text.includes("9am-9pm")) {
    return "1-0:9-21";
  }
  if (text.includes("hems") || text.includes("9am-7pm")) {
    return "1-5:9-19,6-0:10-17";
  }

  const rules: string[] = [];
  const dayPatterns = [
    { pattern: /l-d(\d{1,2}(?:am|pm))-(\d{1,2}(?:am|pm))/, days: "1-0" },
    { pattern: /l-s(\d{1,2}(?:am|pm))-(\d{1,2}(?:am|pm))/, days: "1-6" },
    { pattern: /l-v(\d{1,2}(?:am|pm))-(\d{1,2}(?:am|pm))/, days: "1-5" },
    { pattern: /s-d(?:soloemergencias)?(\d{1,2}(?:am|pm))-(\d{1,2}(?:am|pm))/, days: "6-0" },
    { pattern: /d(?:yferiados)?(\d{1,2}(?:am|pm))-(\d{1,2}(?:am|pm))/, days: "0" },
    { pattern: /s(\d{1,2}(?:am|pm))-(\d{1,2}(?:am|pm))/, days: "6" },
  ];

  for (const { pattern, days } of dayPatterns) {
    const match = text.match(pattern);
    if (match) {
      const rule = rangeToSchedule(days, match[1], match[2]);
      if (rule) rules.push(rule);
    }
  }

  return [...new Set(rules)].join(",");
};

const scheduleAttr = getClientScheduleAttr();

// Collect social media and website URLs for schema sameAs (must use original URLs for SEO)
const schemaSameAs: string[] = [];
if (webUrl) schemaSameAs.push(webUrl);
if (facebookUrl) schemaSameAs.push(facebookUrl);
if (instagramUrl) schemaSameAs.push(instagramUrl);

// Determine default schema image based on clinic characteristics for search listings
const schemaImage = emergencias24h
  ? "https://images.unsplash.com/photo-1584132967334-10e028bd69f7?auto=format&fit=crop&q=80&w=800" // Emergency/Hospital look
  : (atiendeExoticos
      ? "https://images.unsplash.com/photo-1535268647977-a403b69fc756?auto=format&fit=crop&q=80&w=800" // Exotic/Nature look
      : "https://images.unsplash.com/photo-1629909613654-28e377c37b09?auto=format&fit=crop&q=80&w=800"); // Standard vet clinic

interface OpeningHoursSpec {
  "@type": "OpeningHoursSpecification";
  dayOfWeek: string[];
  opens: string;
  closes: string;
}

const getOpeningHoursSpec = (): OpeningHoursSpec[] => {
  if (emergencias24h) {
    return [{
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
      "opens": "00:00",
      "closes": "23:59"
    }];
  }
  
  const text = horarioTexto.toLowerCase();
  if (text.includes("10am-9pm")) {
    return [
      {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
        "opens": "10:00",
        "closes": "21:00"
      },
      {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Sunday"],
        "opens": "10:00",
        "closes": "20:00"
      }
    ];
  } else if (text.includes("8am-9pm")) {
    return [
      {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
        "opens": "08:00",
        "closes": "21:00"
      },
      {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Saturday"],
        "opens": "09:00",
        "closes": "19:00"
      },
      {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Sunday"],
        "opens": "09:00",
        "closes": "17:00"
      }
    ];
  } else if (text.includes("9am-9pm")) {
    return [
      {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
        "opens": "09:00",
        "closes": "21:00"
      }
    ];
  } else if (text.includes("9am-7pm")) {
    return [
      {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
        "opens": "09:00",
        "closes": "19:00"
      },
      {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Saturday", "Sunday"],
        "opens": "10:00",
        "closes": "17:00"
      }
    ];
  } else {
    return [
      {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
        "opens": "08:00",
        "closes": "20:00"
      },
      {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Sunday"],
        "opens": "08:00",
        "closes": "19:00"
      }
    ];
  }
};

const getProvinceSlug = (prov: string) => {
  const map: Record<string, string> = {
    "san josé": "san-jose",
    "heredia": "heredia",
    "alajuela": "alajuela",
    "cartago": "cartago",
    "guanacaste": "guanacaste",
    "puntarenas": "puntarenas",
    "limón": "limon"
  };
  return map[prov.toLowerCase()] || prov.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/[^a-z0-9]/g, "-").replace(/-+/g, "-").replace(/^-+|-+$/g, "");
};

const clinicCanonical = canonicalUrl(`/clinica/${clinica.data.slug}/`);
const provinceCanonical = absoluteUrl(`/provincia/${getProvinceSlug(provincia)}/`);
const zoneCanonical = absoluteUrl(`/zona/${getClinicZoneSlug(zona)}/`);

// JSON-LD Schema Markup (Highly optimized for Local SEO)
const schemaMarkup = {
  "@context": "https://schema.org",
  "@type": ["LocalBusiness", "VeterinaryCare"],
  "@id": clinicCanonical,
  "name": nombre,
  "description": copyDiferenciador,
  "image": schemaImage,
  "url": clinicCanonical,
  "telephone": telefono1 || whatsapp || "",
  "priceRange": "$$",
  "sameAs": schemaSameAs.length > 0 ? schemaSameAs : undefined,
  "hasMap": maps_url || undefined,
  "geo": latitude && longitude ? {
    "@type": "GeoCoordinates",
    "latitude": latitude,
    "longitude": longitude
  } : undefined,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": direccion,
    "addressLocality": zona,
    "addressRegion": provincia,
    "addressCountry": "CR"
  },
  "areaServed": {
    "@type": "AdministrativeArea",
    "name": provincia
  },
  "openingHoursSpecification": getOpeningHoursSpec()
};

// Breadcrumb Schema Markup
const schemaBreadcrumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Inicio",
      "item": absoluteUrl("/")
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": provincia,
      "item": provinceCanonical
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": nombre,
      "item": clinicCanonical
    }
  ]
};

const pageTitle = nombre;

// Generate highly optimized meta description based on clinic emergency tier
const pageDesc = emergencias24h
  ? `¿Urgencia veterinaria? Contacta a ${nombre} en ${zona}, ${provincia}. Servicio de emergencias veterinarias 24/7. 📞 Llama ahora al ${telefono1 || whatsapp}. Atendemos de inmediato.`
  : `Horarios, teléfono y dirección de ${nombre} en ${zona}, ${provincia}. Encuentra servicios veterinarios y de consulta general para tu mascota en Costa Rica.`;

const schemaFaq = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": `¿Cuál es el horario de ${nombre}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `${nombre} reporta este horario: ${horarioTexto}. Recomendamos confirmar por teléfono o WhatsApp antes de trasladarte.`
      }
    },
      {
        "@type": "Question",
        "name": `¿${nombre} atiende emergencias 24 horas en ${zona}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": emergencias24h
          ? `${nombre} aparece marcado con emergencias 24/7 en ${zona}, ${provincia}.`
          : `${nombre} no aparece como emergencia 24/7 confirmada. Para urgencias nocturnas, revisa clínicas marcadas como 24/7 en Vet24 Costa Rica.`
      }
    },
    {
      "@type": "Question",
      "name": `¿${nombre} ofrece hotel para mascotas?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": hotelMascotas
          ? `${nombre} tiene servicio de hotel, hospedaje o guardería reportado en una fuente pública. Confirma cupo, especies aceptadas y condiciones antes de reservar.`
          : `${nombre} no tiene servicio de hotel para mascotas confirmado en la información pública revisada.`
      }
    }
  ]
};
---

<BaseLayout title={pageTitle} description={pageDesc} canonicalUrl={clinicCanonical}>
  <!-- Inject Schema Markup -->
  <script type="application/ld+json" set:html={JSON.stringify(schemaMarkup)} />
  <script type="application/ld+json" set:html={JSON.stringify(schemaBreadcrumbs)} />
  <script type="application/ld+json" set:html={JSON.stringify(schemaFaq)} />

  <div class="max-w-5xl mx-auto py-4" data-page-province={getProvinceSlug(provincia)} data-page-zone={getClinicZoneSlug(zona)}>
    <!-- Back Button -->
    <a href="/" class="inline-flex items-center gap-1.5 text-xs font-semibold text-brand-primary hover:text-brand-primary-hover mb-6 transition-colors" id="btn-back">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-3.5 h-3.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
      </svg>
      Volver al Directorio
    </a>

    <!-- Grid Container -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Main Content Info (2 Cols) -->
      <div class="lg:col-span-2 flex flex-col gap-6">
        
        <!-- Header Info -->
        <header class="relative overflow-hidden bg-brand-card-bg border border-brand-card-border rounded-2xl p-6 sm:p-8 transition-colors duration-200">
          <div class="flex flex-wrap items-center gap-2.5 mb-4 relative z-10">
            <BadgeHorario categoriaHorario={categoriaHorario} />
            <span
              class="detail-status-badge inline-flex items-center gap-1.5 px-3 py-1 text-xs font-bold rounded-full bg-brand-card-bg/80 text-brand-text-muted border border-brand-card-border"
              data-detail-status="inline"
              data-schedule={scheduleAttr}
            >
              Verificando horario...
            </span>
            <span
              class={`inline-flex items-center gap-1 px-3 py-1 text-xs font-bold rounded-full border ${
                statusBadge.tone === 'warning'
                  ? 'bg-brand-warning-bg text-brand-warning-text border-brand-warning-border'
                  : 'bg-brand-card-bg/80 text-brand-text-muted border-brand-card-border'
              }`}
              title={statusBadge.title}
              data-audit="record-status"
            >
              {statusBadge.label}
            </span>
          </div>

          <h1 class="text-3xl sm:text-4xl font-bold text-brand-text mb-3 font-['Outfit',sans-serif] tracking-tight relative z-10" id="clinica-name">
            {nombre}
          </h1>

          <div class="flex items-start gap-1.5 text-sm sm:text-base text-brand-text-muted mb-1 relative z-10 leading-relaxed">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 mt-1 text-brand-primary shrink-0">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
            </svg>
            <span>
              <strong class="text-brand-text font-bold">{zona}, {provincia}</strong> — {direccion}
            </span>
          </div>
        </header>

        <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3" aria-labelledby="seo-quick-facts-title">
          <h2 id="seo-quick-facts-title" class="sr-only">Datos rápidos de {nombre}</h2>
          <div class="rounded-2xl border border-brand-card-border bg-brand-card-bg/45 p-4">
            <span class="block text-[10px] font-bold uppercase tracking-wider text-brand-text-muted">Horario</span>
            <span
              class="detail-status-badge mt-2 inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-bold rounded-xl bg-brand-card-bg text-brand-text-muted border border-brand-card-border shadow-sm"
              data-detail-status="block"
              data-schedule={scheduleAttr}
            >
              Verificando horario...
            </span>
            <p class="mt-1 text-sm font-bold text-brand-text">{horarioTexto}</p>
          </div>
          <div class="rounded-2xl border border-brand-card-border bg-brand-card-bg/45 p-4">
            <span class="block text-[10px] font-bold uppercase tracking-wider text-brand-text-muted">Emergencia 24/7</span>
            <p
              class={`mt-1 text-sm font-bold ${emergency247Fact.confirmed ? 'text-brand-emergency' : 'text-brand-text-muted'}`}
              title={emergency247Fact.title}
              data-capability="emergency-247"
            >
              {emergency247Fact.label}
            </p>
          </div>
          <div class="rounded-2xl border border-brand-card-border bg-brand-card-bg/45 p-4">
            <span class="block text-[10px] font-bold uppercase tracking-wider text-brand-text-muted">Zona</span>
            <a href={zoneCanonical} class="mt-1 inline-flex text-sm font-bold text-brand-primary hover:text-brand-primary-hover">
              Veterinarias en {zona}
            </a>
          </div>
          <div class={`rounded-2xl border p-4 ${hotelMascotas ? (hotelVerificacion === 'confirmado' ? 'border-brand-success-border bg-brand-success-bg/40' : 'border-brand-warning-border bg-brand-warning-bg/40') : 'border-brand-card-border bg-brand-card-bg/45'}`}>
            <span class="block text-[10px] font-bold uppercase tracking-wider text-brand-text-muted">Hotel para mascotas</span>
            <p
              class={`mt-1 text-sm font-bold ${hotelFact.tone === 'positive' ? 'text-brand-success' : (hotelFact.tone === 'warning' ? 'text-brand-warning-text' : 'text-brand-text-muted')}`}
              title={hotelFact.title}
              data-capability="pet-hotel"
            >
              {hotelFact.label}
            </p>
          </div>
        </section>

        {!emergencias24h && (
          <div class="bg-brand-warning-bg border border-brand-warning-border rounded-2xl p-4 sm:p-5 flex items-start gap-3 relative overflow-hidden transition-colors duration-200" id="warning-diurnal-alert">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6 text-brand-warning-text shrink-0 mt-0.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
            </svg>
            <div>
              <h3 class="text-sm font-bold text-brand-warning-text">Sin servicio 24/7 confirmado</h3>
              <p class="text-sm text-brand-text-muted mt-1 leading-relaxed">
                Esta veterinaria <strong>no cuenta con servicio de emergencia confirmado las 24 horas</strong>. Si tienes una emergencia nocturna, busca clínicas marcadas como <strong class="text-brand-emergency">24/7</strong> en el directorio.
              </p>
            </div>
          </div>
        )}

        <!-- Quick Emergency Actions Bar (Dominant CTAs) -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          {tel1Href ? (
            <a href={tel1Href} class="flex flex-col items-center justify-center gap-2 p-5 rounded-2xl bg-brand-emergency hover:bg-brand-emergency-hover text-white shadow-lg shadow-brand-emergency/20 transition-colors text-center cursor-pointer" id="btn-quick-call">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.824-1.802-5.14-4.117-6.942-6.942l1.293-.97c.362-.272.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
              </svg>
              <span class="text-sm font-bold">Llamar ahora</span>
              <span class="text-xs text-white/85 font-semibold">{telefono1}</span>
            </a>
          ) : (
            <div class="flex flex-col items-center justify-center p-5 rounded-2xl bg-brand-card-bg border border-brand-card-border text-brand-text-muted/60 text-center cursor-not-allowed">
              <span class="text-sm font-bold">Sin teléfono</span>
            </div>
          )}

          {whatsappHref ? (
            <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="flex flex-col items-center justify-center gap-2 p-5 rounded-2xl bg-brand-success-bg border border-brand-success-border hover:bg-brand-success/20 text-brand-success transition-colors text-center cursor-pointer" id="btn-quick-wa">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
