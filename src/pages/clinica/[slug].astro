          <a href={maps_url || `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(nombre + ', ' + direccion)}`} target="_blank" rel="noopener noreferrer" class="flex flex-col items-center justify-center gap-2 p-5 rounded-2xl bg-brand-card-bg border border-brand-card-border hover:border-brand-primary/50 text-brand-primary transition-colors text-center cursor-pointer" id={maps_url ? "btn-quick-maps" : "btn-quick-maps-search"}>
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
