---
export const prerender = false;

import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import FiltrosProvincia from '../components/FiltrosProvincia.astro';
import ClinicaCard from '../components/ClinicaCard.astro';
import FiltrosDashboard from '../components/FiltrosDashboard.astro';
import MapaClinicas from '../components/MapaClinicas.astro';
import AdBanner from '../components/AdBanner.astro';
import { absoluteUrl, canonicalUrl } from '../lib/seo';
import { priorityZones } from '../lib/zones';

// Fetch all clinics
const allClinicas = await getCollection('clinicas');

// Show all clinics in the catalog
const publishedClinicas = allClinicas;

// Map of priority values for sorting
const sortingPriority = {
  "24/7 Emergencias": 3,
  "Cierra después 21h": 2,
  "Horario normal": 1
};

// Sort by schedule category priority
const sortedClinicas = [...publishedClinicas].sort((a, b) => {
  const priorityA = sortingPriority[a.data.categoriaHorario] || 0;
  const priorityB = sortingPriority[b.data.categoriaHorario] || 0;
  return priorityB - priorityA; // Descending order: highest priority first
});

// Haversine distance helper for server-side sorting
function haversineKm(lat1: number, lng1: number, lat2: number, lng2: number): number {
  const R = 6371;
  const dLat = (lat2 - lat1) * Math.PI / 180;
  const dLng = (lng2 - lng1) * Math.PI / 180;
  const a = Math.sin(dLat / 2) ** 2 +
    Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
    Math.sin(dLng / 2) ** 2;
  return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
}

// Attempt to read geolocation details from Cloudflare request (IP Geolocation)
let edgeLat: number | null = null;
let edgeLng: number | null = null;
let edgeCity: string | null = null;
let edgeGeoActive = false;

const cf = (Astro.request as any).cf;
if (cf) {
  if (cf.latitude && cf.longitude) {
    edgeLat = parseFloat(cf.latitude);
    edgeLng = parseFloat(cf.longitude);
    edgeCity = cf.city || null;
    edgeGeoActive = true;
  }
} else {
  // Check headers as a fallback
  const latHeader = Astro.request.headers.get('cf-iplatitude');
  const lngHeader = Astro.request.headers.get('cf-iplongitude');
  const cityHeader = Astro.request.headers.get('cf-ipcity');
  if (latHeader && lngHeader) {
    edgeLat = parseFloat(latHeader);
    edgeLng = parseFloat(lngHeader);
    edgeCity = cityHeader ? decodeURIComponent(cityHeader) : null;
    edgeGeoActive = true;
  }
}

// Sort by proximity if edge geolocation is available
let processedClinicas = [...sortedClinicas];
if (edgeGeoActive && edgeLat !== null && edgeLng !== null) {
  processedClinicas.sort((a, b) => {
    const aLat = a.data.latitude ?? 0;
    const aLng = a.data.longitude ?? 0;
    const bLat = b.data.latitude ?? 0;
    const bLng = b.data.longitude ?? 0;
    
    const aDist = (aLat === 0 && aLng === 0) ? Infinity : haversineKm(edgeLat!, edgeLng!, aLat, aLng);
    const bDist = (bLat === 0 && bLng === 0) ? Infinity : haversineKm(edgeLat!, edgeLng!, bLat, bLng);
    return aDist - bDist;
  });
}

// Title & SEO info
const pageTitle = "Veterinarias Abiertas Hoy, Cerca de Mí y 24 Horas en Costa Rica";
const pageDesc = "Encuentra veterinarias abiertas hoy, de guardia y 24 horas cerca de ti en Costa Rica. Llama, escribe por WhatsApp o abre la ruta en Waze.";
const canonical = canonicalUrl("/");

// Build map data array matching our sorted/processed order
const mapData = processedClinicas.map(c => ({
  nombre: c.data.nombre,
  slug: c.data.slug,
  zona: c.data.zona,
  telefono1: c.data.telefono1,
  emergencias24h: c.data.emergencias24h,
  latitude: c.data.latitude ?? 0,
  longitude: c.data.longitude ?? 0,
  waze_url: c.data.waze_url,
  maps_url: c.data.maps_url,
  emergency_tier: c.data.emergency_tier,
  confidence_score: c.data.confidence_score,
}));

// Build ItemList Schema Markup for Directory SEO
const schemaItemList = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Directorio de Veterinarias de Emergencia en Costa Rica",
  "description": "Lista de las mejores clínicas veterinarias con servicios de emergencias 24/7 y atención nocturna en Costa Rica.",
  "numberOfItems": processedClinicas.length,
  "itemListElement": processedClinicas.map((c, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "url": absoluteUrl(`/clinica/${c.data.slug}/`),
    "name": c.data.nombre
  }))
};
---

<BaseLayout title={pageTitle} description={pageDesc} canonicalUrl={canonical}>
  <!-- Inject Directory Schema Markup -->
  <script type="application/ld+json" set:html={JSON.stringify(schemaItemList)} />

  <!-- Hero Section -->
  <section class="text-center py-10 md:py-16" aria-labelledby="hero-title" data-page-province="costa-rica">
    <div class="max-w-3xl mx-auto px-4">
      <h1 id="hero-title" class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-brand-text mb-4 font-['Outfit',sans-serif] leading-[1.15]">
        Encuentra una veterinaria <span class="text-brand-primary">abierta ahora</span> en Costa Rica
      </h1>

      <p class="text-base sm:text-lg text-brand-text-muted mb-8 max-w-2xl mx-auto leading-relaxed">
        Emergencias 24/7, clínicas de guardia y consultas de todos los días. Llama, escribe por WhatsApp o abre la ruta en Waze en segundos.
      </p>

      <div class="flex flex-col sm:flex-row justify-center gap-3">
        <button
          type="button"
          data-sos-trigger
          class="inline-flex items-center justify-center gap-2.5 px-8 py-4 rounded-2xl bg-brand-emergency hover:bg-brand-emergency-hover text-white text-base font-bold transition-colors shadow-lg shadow-brand-emergency/25 cursor-pointer"
          id="cta-sos-hero"
        >
          <span class="relative flex h-2.5 w-2.5">
            <span class="animate-sos-ping absolute inline-flex h-full w-full rounded-full bg-white opacity-80"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-white"></span>
          </span>
          Es una emergencia
        </button>
        <a href="#directorio" class="inline-flex items-center justify-center px-8 py-4 rounded-2xl border border-brand-card-border bg-brand-card-bg hover:border-brand-primary/45 text-brand-text text-base font-bold transition-colors" id="cta-directorio">
          Buscar en el directorio
        </a>
      </div>

      <!-- Live status line -->
      <div class="mt-8 flex flex-wrap justify-center items-center gap-x-6 gap-y-2 text-sm text-brand-text-muted">
        <span class="inline-flex items-center gap-2">
          <span class="h-2 w-2 rounded-full bg-brand-success"></span>
          <span><strong class="text-brand-text font-bold" id="open-now-count">—</strong> abiertas en este momento</span>
        </span>
        <span class="inline-flex items-center gap-2">
          <span class="h-2 w-2 rounded-full bg-brand-primary"></span>
          <span><strong class="text-brand-text font-bold">{processedClinicas.length}</strong> veterinarias en todo el país</span>
        </span>
      </div>

      <AdBanner slot="home-inline" size="320x50" />
    </div>
  </section>

  <!-- Directory Section -->
  <section id="directorio" class="scroll-mt-20 py-6" aria-labelledby="directorio-title">
    <!-- Section Header -->
    <div class="mb-5">
      <h2 id="directorio-title" class="text-2xl md:text-3xl font-bold text-brand-text font-['Outfit',sans-serif]">
        Directorio de veterinarias
      </h2>
      <p class="text-sm sm:text-base text-brand-text-muted mt-1.5">
        Usa la búsqueda y los filtros para encontrar la clínica que necesitas. Las abiertas ahora se marcan en verde.
      </p>
    </div>

    <!-- Primary filters (banner + sticky toolbar + SOS/empty states) -->
    <FiltrosDashboard />

    <!-- Province Filter Component -->
    <FiltrosProvincia />

    <!-- Zone shortcuts: compact chip row so someone who knows their canton jumps straight there -->
    <div class="w-full mb-6" aria-labelledby="zonas-title">
      <h2 id="zonas-title" class="text-xs font-bold text-brand-text-muted uppercase tracking-wider mb-2.5 font-['Outfit',sans-serif]">
        Ir a mi zona
      </h2>
      <nav class="flex items-center gap-2 overflow-x-auto pb-2 -mx-4 px-4 sm:mx-0 sm:px-0 scrollbar-none" aria-label="Accesos directos por zona">
        {priorityZones.map((zone) => (
          <a href={`/zona/${zone.slug}/`} class="filter-chip shrink-0">
            {zone.nombre}
          </a>
        ))}
      </nav>
    </div>

    <!-- Interactive Map -->
    <MapaClinicas clinicas={mapData} />

    <!-- Clinics Grid -->
    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 scroll-mt-24"
      id="clinicas-grid"
      data-edge-lat={edgeLat}
      data-edge-lng={edgeLng}
      data-edge-city={edgeCity}
      data-edge-active={edgeGeoActive ? "true" : "false"}
    >
      {processedClinicas.map(clinica => {
        const cLat = clinica.data.latitude ?? 0;
        const cLng = clinica.data.longitude ?? 0;
        const dist = (edgeGeoActive && edgeLat !== null && edgeLng !== null && cLat !== 0 && cLng !== 0)
          ? haversineKm(edgeLat, edgeLng, cLat, cLng)
          : undefined;
        return <ClinicaCard clinica={clinica.data} distance={dist} />;
      })}
    </div>
  </section>

  <!-- SEO zone shortcuts (after results so they never bury them) -->
  <section class="mt-12 rounded-2xl border border-brand-card-border bg-brand-card-bg p-5 sm:p-6" aria-labelledby="zonas-title">
    <div class="flex flex-col gap-1.5 mb-4">
      <h2 id="zonas-title" class="text-base font-bold text-brand-text font-['Outfit',sans-serif]">
        Buscar por zona
      </h2>
      <p class="text-sm text-brand-text-muted">
        Accesos directos a veterinarias por cantón: horarios, teléfonos y opciones de emergencia.
      </p>
    </div>
    <div class="flex flex-wrap gap-2">
      {priorityZones.map((zone) => (
        <a href={`/zona/${zone.slug}/`} class="filter-chip">
          Veterinarias en {zone.nombre}
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
