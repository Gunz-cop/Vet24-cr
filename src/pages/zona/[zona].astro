---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ClinicaCard from '../../components/ClinicaCard.astro';
import FiltrosDashboard from '../../components/FiltrosDashboard.astro';
import FiltrosProvincia from '../../components/FiltrosProvincia.astro';
import MapaClinicas from '../../components/MapaClinicas.astro';
import { absoluteUrl, canonicalUrl } from '../../lib/seo';
import { getClinicZoneSlug, getPriorityZoneBySlug, priorityZones } from '../../lib/zones';

export async function getStaticPaths() {
  return priorityZones.map((zone) => ({
    params: { zona: zone.slug },
    props: { zone }
  }));
}

const { zone } = Astro.props;
const allClinicas = await getCollection('clinicas');
const selectedZone = getPriorityZoneBySlug(zone.slug) || zone;

const sortingPriority = {
  "24/7 Emergencias": 4,
  "Cierra después 21h": 2,
  "Horario normal": 1
};

const filteredClinicas = allClinicas
  .filter((c) => getClinicZoneSlug(c.data.zona) === selectedZone.slug)
  .sort((a, b) => {
    const tierA = a.data.emergency_tier === "Tier A" ? 2 : 0;
    const tierB = b.data.emergency_tier === "Tier A" ? 2 : 0;
    const verifiedA = a.data.record_status === "VERIFIED" ? 1 : 0;
    const verifiedB = b.data.record_status === "VERIFIED" ? 1 : 0;
    const priorityA = (sortingPriority[a.data.categoriaHorario] || 0) + tierA + verifiedA;
    const priorityB = (sortingPriority[b.data.categoriaHorario] || 0) + tierB + verifiedB;
    return priorityB - priorityA;
  });

const emergencyCount = filteredClinicas.filter((c) => c.data.emergencias24h).length;
const verifiedCount = filteredClinicas.filter((c) => c.data.record_status === "VERIFIED").length;
const provinceNames = [...new Set(filteredClinicas.map((c) => c.data.provincia))];
const provinceText = provinceNames.length > 0 ? provinceNames.join(", ") : "Costa Rica";

const mapData = filteredClinicas.map(c => ({
  nombre: c.data.nombre,
  slug: c.data.slug,
  zona: c.data.zona,
  telefono1: c.data.telefono1,
  emergencias24h: c.data.emergencias24h,
  latitude: c.data.latitude ?? 0,
  longitude: c.data.longitude ?? 0,
  waze_url: c.data.waze_url,
  maps_url: c.data.maps_url,
  emergency_tier: c.data.emergency_tier,
  confidence_score: c.data.confidence_score,
}));

const pageTitle = `Veterinarias en ${selectedZone.nombre}: abiertas hoy y 24 horas`;
const pageDesc = `Encuentra veterinarias en ${selectedZone.nombre}, ${provinceText}. Consulta horarios, teléfonos, WhatsApp, Waze y opciones de emergencia 24/7 verificadas.`;
const canonical = canonicalUrl(`/zona/${selectedZone.slug}/`);

const schemaItemList = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": `Veterinarias en ${selectedZone.nombre}`,
  "description": `Clínicas veterinarias en ${selectedZone.nombre} con horarios, teléfonos y opciones de emergencia.`,
  "numberOfItems": filteredClinicas.length,
  "itemListElement": filteredClinicas.map((c, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "url": absoluteUrl(`/clinica/${c.data.slug}/`),
    "name": c.data.nombre
  }))
};

const schemaBreadcrumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Inicio",
      "item": absoluteUrl("/")
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": selectedZone.nombre,
      "item": canonical
    }
  ]
};

const schemaFaq = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": `¿Hay veterinarias abiertas hoy en ${selectedZone.nombre}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Sí. Esta página lista veterinarias en ${selectedZone.nombre} con horarios, teléfonos y acceso rápido a llamada, WhatsApp, Waze y Google Maps.`
      }
    },
    {
      "@type": "Question",
      "name": `¿Hay veterinarias 24 horas en ${selectedZone.nombre}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": emergencyCount > 0
          ? `Hay ${emergencyCount} opción u opciones marcadas como 24/7 en ${selectedZone.nombre}. Confirma disponibilidad antes de trasladarte.`
          : `No hay opciones 24/7 confirmadas en ${selectedZone.nombre} dentro del directorio actual. Revisa el horario de cada ficha antes de trasladarte.`
      }
    }
  ]
};
---

<BaseLayout title={pageTitle} description={pageDesc} canonicalUrl={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(schemaItemList)} />
  <script type="application/ld+json" set:html={JSON.stringify(schemaBreadcrumbs)} />
  <script type="application/ld+json" set:html={JSON.stringify(schemaFaq)} />

  <section class="py-6 scroll-mt-20" aria-labelledby="zona-title" data-page-zone={selectedZone.slug}>
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-6 border-b border-brand-card-border pb-6">
      <div>
        <a href="/" class="inline-flex items-center gap-1.5 text-xs font-semibold text-brand-primary hover:text-brand-primary-hover mb-2 transition-colors">
          Volver al directorio
        </a>
        <h1 id="zona-title" class="text-3xl md:text-4xl font-extrabold text-brand-text font-['Outfit',sans-serif] tracking-tight">
          Veterinarias en <span class="bg-gradient-to-r from-brand-primary via-brand-secondary to-brand-primary bg-clip-text text-transparent">{selectedZone.nombre}</span>
        </h1>
        <p class="text-sm text-brand-text-muted mt-2 max-w-3xl">
          Consulta clínicas veterinarias abiertas hoy en {selectedZone.nombre}, teléfonos, WhatsApp y rutas. Las opciones 24/7 o verificadas se muestran con prioridad.
        </p>
      </div>
      <div class="grid grid-cols-3 gap-2 text-center">
        <div class="rounded-xl border border-brand-card-border bg-brand-card-bg px-3 py-2">
          <span class="block text-lg font-black text-brand-text">{filteredClinicas.length}</span>
          <span class="text-[10px] font-bold uppercase text-brand-text-muted">Clínicas</span>
        </div>
        <div class="rounded-xl border border-brand-card-border bg-brand-card-bg px-3 py-2">
          <span class="block text-lg font-black text-brand-primary">{emergencyCount}</span>
          <span class="text-[10px] font-bold uppercase text-brand-text-muted">24/7</span>
        </div>
        <div class="rounded-xl border border-brand-card-border bg-brand-card-bg px-3 py-2">
          <span class="block text-lg font-black text-brand-success">{verifiedCount}</span>
          <span class="text-[10px] font-bold uppercase text-brand-text-muted">Verificadas</span>
        </div>
      </div>
    </div>

    <FiltrosDashboard />

    <FiltrosProvincia />

    <section class="mb-8 grid gap-3 md:grid-cols-2" aria-labelledby="faq-zona-title">
      <h2 id="faq-zona-title" class="sr-only">Preguntas frecuentes de veterinarias en {selectedZone.nombre}</h2>
      <div class="rounded-2xl border border-brand-card-border bg-brand-card-bg/35 p-5">
        <h3 class="text-sm font-black text-brand-text mb-2">¿Hay veterinarias abiertas hoy en {selectedZone.nombre}?</h3>
        <p class="text-sm text-brand-text-muted">Sí. Revisa el horario de cada ficha y confirma por teléfono o WhatsApp antes de trasladarte.</p>
      </div>
      <div class="rounded-2xl border border-brand-card-border bg-brand-card-bg/35 p-5">
        <h3 class="text-sm font-black text-brand-text mb-2">¿Hay veterinarias 24 horas en {selectedZone.nombre}?</h3>
        <p class="text-sm text-brand-text-muted">
          {emergencyCount > 0
            ? `Hay ${emergencyCount} opción u opciones marcadas como 24/7 en esta zona.`
            : 'No hay opciones 24/7 confirmadas en esta zona dentro del directorio actual.'}
        </p>
      </div>
    </section>

    <MapaClinicas clinicas={mapData} />

    {filteredClinicas.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 scroll-mt-24" id="clinicas-grid" data-edge-active="false">
        {filteredClinicas.map(clinica => (
          <ClinicaCard clinica={clinica.data} />
        ))}
      </div>
    ) : (
      <div class="text-center py-16 bg-brand-card-bg/20 border border-dashed border-brand-card-border rounded-2xl p-8">
        <h3 class="text-base font-semibold text-brand-text">No hay clínicas activas en {selectedZone.nombre}</h3>
        <p class="text-sm text-brand-text-muted mt-1">Estamos ampliando la cobertura de esta zona.</p>
      </div>
    )}
  </section>
</BaseLayout>
