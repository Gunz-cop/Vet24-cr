---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import GuiasRelacionadas from '../../../components/GuiasRelacionadas.astro';
import { directoryLinks, directoryNames, crossPillarLinks } from '../../../lib/blog-links';
import { priorityZones } from '../../../lib/zones';
import BlogLayout from '../../../layouts/BlogLayout.astro';
import { getPublishedBlogEntries } from '../../../lib/blog';
export async function getStaticPaths() {
  return (await getPublishedBlogEntries()).map((entry) => ({ params: { pilar: entry.data.pilar, slug: entry.data.slug }, props: { entry } }));
}
const { entry } = Astro.props as { entry: CollectionEntry<'blog'> };
const { Content } = await render(entry);
const names = directoryNames(await getCollection('clinicas'), priorityZones);
---
<BlogLayout entry={entry}><Content /><GuiasRelacionadas title="Clínicas y zonas del directorio" links={directoryLinks(entry, names)} /><GuiasRelacionadas links={crossPillarLinks(entry, await getPublishedBlogEntries())} /></BlogLayout>
