---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FiltrosProvincia from '../../components/FiltrosProvincia.astro';
import ClinicaCard from '../../components/ClinicaCard.astro';
import FiltrosDashboard from '../../components/FiltrosDashboard.astro';
import MapaClinicas from '../../components/MapaClinicas.astro';

export async function getStaticPaths() {
  const provincesMap = [
    { nombre: "San José", slug: "san-jose" },
    { nombre: "Heredia", slug: "heredia" },
    { nombre: "Alajuela", slug: "alajuela" },
    { nombre: "Cartago", slug: "cartago" },
    { nombre: "Guanacaste", slug: "guanacaste" },
    { nombre: "Puntarenas", slug: "puntarenas" },
    { nombre: "Limón", slug: "limon" }
  ];
  
  return provincesMap.map(prov => ({
    params: { provincia: prov.slug },
    props: { 
      nombreProvincia: prov.nombre, 
      slugProvincia: prov.slug 
    }
  }));
}

const { nombreProvincia, slugProvincia } = Astro.props;

// Fetch all clinics
const allClinicas = await getCollection('clinicas');

// Helper to normalize strings to slugs (matches the path format)
const normalizeText = (text: string) => {
  return text
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/[^a-z0-9]/g, "-")
    .replace(/-+/g, "-")
    .replace(/^-+|-+$/g, "");
};

// Filter clinics by province
const filteredClinicas = allClinicas.filter(c => {
  return normalizeText(c.data.provincia) === slugProvincia;
});

// Map of priority values for sorting
const sortingPriority = {
  "24/7 Emergencias": 3,
  "Cierra después 21h": 2,
  "Horario normal": 1
};

// Sort clinics
const sortedClinicas = [...filteredClinicas].sort((a, b) => {
  const priorityA = sortingPriority[a.data.categoriaHorario] || 0;
  const priorityB = sortingPriority[b.data.categoriaHorario] || 0;
  return priorityB - priorityA;
});

// Build map data array
const mapData = sortedClinicas.map(c => ({
  nombre: c.data.nombre,
  slug: c.data.slug,
  zona: c.data.zona,
  telefono1: c.data.telefono1,
  emergencias24h: c.data.emergencias24h,
  latitude: c.data.latitude ?? 0,
  longitude: c.data.longitude ?? 0,
  waze_url: c.data.waze_url,
  maps_url: c.data.maps_url,
  emergency_tier: c.data.emergency_tier,
  confidence_score: c.data.confidence_score,
}));

const pageTitle = `Veterinarias de Emergencias en ${nombreProvincia}`;
const pageDesc = `Encuentra clínicas veterinarias de emergencias 24/7 y atención nocturna en la provincia de ${nombreProvincia}, Costa Rica.`;
---

<BaseLayout title={pageTitle} description={pageDesc}>
  <!-- Section Header -->
  <section class="py-6 scroll-mt-20" aria-labelledby="provincia-title">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-6 border-b border-brand-card-border pb-6 transition-colors duration-200">
      <div>
        <a href="/" class="inline-flex items-center gap-1.5 text-xs font-semibold text-brand-primary hover:text-brand-primary-hover mb-2 transition-colors" id="btn-back-home">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-3.5 h-3.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
          </svg>
          Volver al Inicio
        </a>
        <h1 id="provincia-title" class="text-3xl md:text-4xl font-extrabold text-brand-text font-['Outfit',sans-serif] tracking-tight">
          Veterinarias en <span class="text-brand-primary">{nombreProvincia}</span>
        </h1>
        <p class="text-sm text-brand-text-muted mt-1">
          Directorio especializado en urgencias médicas y atención nocturna.
        </p>
      </div>
      <div class="text-sm font-medium text-brand-text-muted">
        Total: <span class="text-brand-text font-bold bg-brand-card-bg px-2.5 py-1 rounded-md border border-brand-card-border transition-colors duration-200">{sortedClinicas.length} clínicas</span>
      </div>
    </div>

    <!-- Province Filter Component (Highlights Active Province) -->
    <FiltrosProvincia activeProvincia={slugProvincia} />

    <!-- Interactive Map -->
    <MapaClinicas clinicas={mapData} />

    <!-- Quick Filters Dashboard -->
    <FiltrosDashboard />

    <!-- Clinics Grid -->
    {sortedClinicas.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="clinicas-grid">
        {sortedClinicas.map(clinica => (
          <ClinicaCard clinica={clinica.data} />
        ))}
      </div>
    ) : (
      <div class="text-center py-16 bg-brand-card-bg border border-dashed border-brand-card-border rounded-xl p-8" id="empty-state">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="mx-auto h-12 w-12 text-brand-text-muted/65 mb-4">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 7.5h.008v.008H12v-.008Z" />
        </svg>
        <h3 class="text-base font-semibold text-brand-text">No hay clínicas activas en {nombreProvincia}</h3>
        <p class="text-sm text-brand-text-muted mt-1">Actualmente no disponemos de registros verificados o publicados en esta zona.</p>
        <a href="/" class="inline-flex items-center gap-1 mt-4 px-4 py-2 text-xs font-semibold rounded-xl bg-brand-card-bg hover:bg-brand-primary/10 text-brand-text border border-brand-card-border hover:border-brand-primary/35 transition-colors" id="btn-fallback-home">
          Ver todas las provincias
        </a>
      </div>
    )}
  </section>
</BaseLayout>
