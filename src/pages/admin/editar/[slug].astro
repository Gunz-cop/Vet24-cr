---
export const prerender = false;
import Shell from '../../../components/admin/Shell.astro';
const slug = Astro.params.slug || '';
---
<Shell title="Editar ficha">
  <p class="admin-muted">Los campos derivados y la evidencia se conservan en servidor. Los cambios permanentes generan una propuesta; no publican por sí solos.</p>
  <div id="editor-status" class="admin-status" aria-live="polite">Cargando ficha…</div>
  <form id="editor" class="admin-form" data-slug={slug}>
    <fieldset><legend>Identidad y ubicación</legend><div class="admin-form-grid">
      <div><label for="id">ID histórico</label><input id="id" name="id" readonly /></div><div><label for="nombre">Nombre <span>(obligatorio)</span></label><input id="nombre" name="nombre" required /></div><div><label for="slug">Slug</label><input id="slug" name="slug" readonly /></div><div><label for="provincia">Provincia</label><input id="provincia" name="provincia" required /></div><div><label for="zona">Zona</label><input id="zona" name="zona" required /></div><div><label for="direccion">Dirección</label><input id="direccion" name="direccion" required /></div><div><label for="latitude">Latitud</label><input id="latitude" name="latitude" type="number" step="any" inputmode="decimal" /><p class="admin-help">0,0 no es una ubicación válida.</p></div><div><label for="longitude">Longitud</label><input id="longitude" name="longitude" type="number" step="any" inputmode="decimal" /></div>
    </div></fieldset>
    <fieldset><legend>Contacto</legend><div class="admin-form-grid"><div><label for="telefono1">Teléfono</label><input id="telefono1" name="telefono1" type="tel" /></div><div><label for="telefono2">Teléfono secundario</label><input id="telefono2" name="telefono2" type="tel" /></div><div><label for="whatsapp">WhatsApp</label><input id="whatsapp" name="whatsapp" type="tel" /></div><div><label for="web">Web HTTPS</label><input id="web" name="web" type="url" /></div><div><label for="facebook">Facebook HTTPS</label><input id="facebook" name="facebook" type="url" /></div><div><label for="instagram">Instagram HTTPS</label><input id="instagram" name="instagram" type="url" /></div><div><label for="maps_url">Maps HTTPS</label><input id="maps_url" name="maps_url" type="url" /></div><div><label for="waze_url">Waze HTTPS</label><input id="waze_url" name="waze_url" type="url" /></div></div></fieldset>
    <fieldset><legend>Capacidades independientes</legend><div class="admin-form-grid admin-check-grid">
      <label><input type="checkbox" name="emergencias24h" /> Emergencias 24h</label><label><input type="checkbox" name="atiendeExoticos" /> Animales exóticos</label><label><input type="checkbox" name="cirugiaEmergencia" /> Cirugía de emergencia</label><label><input type="checkbox" name="atiendeGranja" /> Animales de granja</label><label><input type="checkbox" name="atiendePeces" /> Peces ornamentales</label><label><input type="checkbox" name="hotelMascotas" /> Hotel para mascotas</label><label><input type="checkbox" name="has_surgery" /> Cirugía</label><label><input type="checkbox" name="has_hospitalization" /> Hospitalización</label><label><input type="checkbox" name="overnight_doctor_present" /> Médico nocturno presente</label><label><input type="checkbox" name="accepts_emergency_walkins" /> Recibe emergencias presenciales</label>
    </div><label for="verification_notes">Notas de verificación</label><textarea id="verification_notes" name="verification_notes" rows="3"></textarea><p class="admin-help">Cada capacidad se conserva por separado; no se deduce una de otra.</p></fieldset>
    <fieldset><legend>Horario estructurado</legend><p class="admin-help">Minutos exactos, extremos [inicio, fin), máximo ocho intervalos por día. “Por confirmar” no es “cerrado”.</p><div id="schedule-editor" class="schedule-editor" aria-label="Editor de horario semanal"></div><div class="admin-actions"><button id="add-exception" type="button" class="secondary">Añadir excepción fechada</button></div><div id="schedule-exceptions" aria-label="Excepciones de horario"></div><pre id="schedule-preview" aria-label="Vista previa del horario"></pre></fieldset>
    <fieldset><legend>Evidencia</legend><div class="admin-form-grid"><div><label for="observedAt">Fecha observada UTC</label><input id="observedAt" type="datetime-local" /></div><div><label for="sourceUrl">Fuente pública HTTPS</label><input id="sourceUrl" type="url" /></div><div><label for="evidenceField">Hecho respaldado</label><input id="evidenceField" placeholder="ej. horario" /></div><div><label for="evidenceValue">Valor observado</label><input id="evidenceValue" /></div><div><label for="evidenceConfidence">Confianza</label><select id="evidenceConfidence"><option>high</option><option selected>medium</option><option>low</option></select></div><div><label for="conflictField">Campo en conflicto (opcional)</label><input id="conflictField" /></div><div><label for="conflictValues">Valores en conflicto</label><input id="conflictValues" placeholder="separados por coma" /></div><div><label for="conflictResolution">Resolución</label><input id="conflictResolution" /></div></div><p class="admin-help">Una URL no confirma por sí sola el domicilio, horario ni una emergencia. Las referencias y conflictos se conservan en el sidecar.</p></fieldset>
    <fieldset><legend>Cuerpo editorial</legend><label for="bodyMarkdown">Markdown de la ficha</label><textarea id="bodyMarkdown" rows="10" spellcheck="true"></textarea><p class="admin-help">El cuerpo se preserva fuera del frontmatter y solo se modifica al proponer explícitamente un cambio.</p></fieldset>
    <fieldset><legend>Alerta temporal</legend><div class="admin-form-grid"><div><label for="temporarilyClosed">Estado</label><select id="temporarilyClosed"><option value="false">Sin cierre temporal</option><option value="true">Cierre temporal</option></select></div><div><label for="expiresAt">Expira en</label><input id="expiresAt" type="datetime-local" /></div><div><label for="message">Mensaje (máximo 500)</label><textarea id="message" maxlength="500"></textarea></div></div><div class="admin-actions"><button id="save-override" type="button">Guardar alerta temporal</button><button id="remove-override" class="secondary" type="button">Quitar alerta</button></div></fieldset>
    <div class="admin-actions"><button id="propose" type="button">Proponer cambio permanente</button><a class="secondary" href="/admin/">Cancelar</a></div>
  </form>
</Shell>
<script>
  // @ts-nocheck
  const form = document.querySelector('#editor');
  const slug = form.dataset.slug;
  const status = document.querySelector('#editor-status');
  const dayNames = ['Domingo', 'Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado'];
  let detail = null;
  let scheduleDraft = null;
  let scheduleChanged = false;
  let originalSchedulePresent = false;
  const mutationKeys = new Map();
  const emptySchedule = () => ({ version: 1, timeZone: 'America/Costa_Rica', days: dayNames.map(() => ({ kind: 'unknown' })), exceptions: [] });
  const setField = (id, value) => { const element = document.querySelector(`#${id}`); if (element) element.value = value ?? ''; };
  const setStatus = (message, kind = '') => { status.textContent = message; status.className = `admin-status ${kind}`; };
  const minuteText = minute => minute === 1440 ? '24:00' : `${String(Math.floor(minute / 60)).padStart(2, '0')}:${String(minute % 60).padStart(2, '0')}`;
  function renderSchedule() {
    const root = document.querySelector('#schedule-editor');
    root.innerHTML = scheduleDraft.days.map((day, index) => {
      const intervals = day.kind === 'open' ? day.intervals.map((range, rangeIndex) => `<div class="schedule-interval"><label for="start-${index}-${rangeIndex}">Inicio</label><input id="start-${index}-${rangeIndex}" type="text" inputmode="numeric" pattern="(?:[01]?[0-9]|2[0-4]):[0-5][0-9]" value="${minuteText(range.start)}" data-day="${index}" data-range="${rangeIndex}" data-edge="start" /><label for="end-${index}-${rangeIndex}">Fin</label><input id="end-${index}-${rangeIndex}" type="text" inputmode="numeric" pattern="(?:[01]?[0-9]|2[0-4]):[0-5][0-9]" value="${minuteText(range.end)}" data-day="${index}" data-range="${rangeIndex}" data-edge="end" /></div>`).join('') : '<span class="admin-muted">Sin intervalo confirmado</span>';
      return `<div class="schedule-day"><label for="kind-${index}">${dayNames[index]}</label><select id="kind-${index}" class="schedule-kind" data-day="${index}"><option value="unknown" ${day.kind === 'unknown' ? 'selected' : ''}>Por confirmar</option><option value="closed" ${day.kind === 'closed' ? 'selected' : ''}>Cerrado</option><option value="appointment" ${day.kind === 'appointment' ? 'selected' : ''}>Cita previa</option><option value="open" ${day.kind === 'open' ? 'selected' : ''}>Abierto</option></select><div class="schedule-intervals">${intervals}</div>${day.kind === 'open' ? `<button type="button" class="secondary add-interval" data-day="${index}">Añadir intervalo</button>` : ''}</div>`;
    }).join('');
    root.querySelectorAll('.schedule-kind').forEach(select => select.addEventListener('change', () => { scheduleChanged = true; const day = scheduleDraft.days[Number(select.dataset.day)]; day.kind = select.value; if (day.kind === 'open') day.intervals = day.intervals || [{ start: 540, end: 1020 }]; else delete day.intervals; renderSchedule(); }));
    root.querySelectorAll('.add-interval').forEach(button => button.addEventListener('click', () => { scheduleChanged = true; scheduleDraft.days[Number(button.dataset.day)].intervals.push({ start: 540, end: 1020 }); renderSchedule(); }));
    root.querySelectorAll('input[data-edge]').forEach(input => input.addEventListener('change', () => { const match = /^([01]?\d|2[0-4]):([0-5]\d)$/.exec(input.value); if (!match) { setStatus('Hora inválida: usa HH:mm, con fin máximo 24:00.', 'error'); return; } scheduleChanged = true; const day = scheduleDraft.days[Number(input.dataset.day)]; const range = day.intervals[Number(input.dataset.range)]; range[input.dataset.edge] = Number(match[1]) * 60 + Number(match[2]); renderSchedule(); }));
    renderExceptions();
    document.querySelector('#schedule-preview').textContent = JSON.stringify(scheduleDraft, null, 2);
  }
  function renderExceptions() {
    const root = document.querySelector('#schedule-exceptions');
    root.innerHTML = scheduleDraft.exceptions.map((exception, index) => `<div class="schedule-exception"><label for="exception-date-${index}">Fecha</label><input id="exception-date-${index}" type="date" value="${exception.date}" data-exception="${index}" /><label for="exception-kind-${index}">Estado</label><select id="exception-kind-${index}" data-exception="${index}"><option value="unknown" ${exception.day.kind === 'unknown' ? 'selected' : ''}>Por confirmar</option><option value="closed" ${exception.day.kind === 'closed' ? 'selected' : ''}>Cerrado</option><option value="appointment" ${exception.day.kind === 'appointment' ? 'selected' : ''}>Cita previa</option><option value="open" ${exception.day.kind === 'open' ? 'selected' : ''}>Abierto</option></select><button type="button" class="secondary remove-exception" data-exception="${index}">Eliminar</button></div>`).join('');
    root.querySelectorAll('input[data-exception]').forEach(input => input.addEventListener('change', () => { scheduleChanged = true; scheduleDraft.exceptions[Number(input.dataset.exception)].date = input.value; renderExceptions(); document.querySelector('#schedule-preview').textContent = JSON.stringify(scheduleDraft, null, 2); }));
    root.querySelectorAll('select[data-exception]').forEach(select => select.addEventListener('change', () => { scheduleChanged = true; const item = scheduleDraft.exceptions[Number(select.dataset.exception)]; item.day = select.value === 'open' ? { kind: 'open', intervals: [{ start: 540, end: 1020 }] } : { kind: select.value }; renderExceptions(); document.querySelector('#schedule-preview').textContent = JSON.stringify(scheduleDraft, null, 2); }));
    root.querySelectorAll('.remove-exception').forEach(button => button.addEventListener('click', () => { scheduleChanged = true; scheduleDraft.exceptions.splice(Number(button.dataset.exception), 1); renderExceptions(); document.querySelector('#schedule-preview').textContent = JSON.stringify(scheduleDraft, null, 2); }));
  }
  document.querySelector('#add-exception').onclick = () => { if (scheduleDraft.exceptions.length >= 60) { setStatus('No puedes añadir más de 60 excepciones.', 'error'); return; } scheduleChanged = true; const date = new Date(Date.now() + 86400000).toISOString().slice(0, 10); scheduleDraft.exceptions.push({ date, day: { kind: 'unknown' } }); renderExceptions(); document.querySelector('#schedule-preview').textContent = JSON.stringify(scheduleDraft, null, 2); };
  async function load() { try { const response = await fetch(`/api/admin/clinics/${encodeURIComponent(slug)}/`, { cache: 'no-store' }); detail = await response.json(); if (!response.ok) throw new Error(detail.message || detail.error); const clinic = detail.clinic; ['id', 'nombre', 'slug', 'provincia', 'zona', 'direccion', 'telefono1', 'telefono2', 'whatsapp', 'web', 'facebook', 'instagram', 'maps_url', 'waze_url', 'latitude', 'longitude'].forEach(key => setField(key, clinic[key])); ['emergencias24h', 'atiendeExoticos', 'cirugiaEmergencia', 'atiendeGranja', 'atiendePeces', 'hotelMascotas', 'has_surgery', 'has_hospitalization', 'overnight_doctor_present', 'accepts_emergency_walkins'].forEach(key => { const input = document.querySelector(`input[name="${key}"]`); if (input) input.checked = clinic[key] === true; }); setField('verification_notes', Array.isArray(clinic.verification_notes) ? clinic.verification_notes.join('\n') : ''); setField('bodyMarkdown', detail.bodyMarkdown || ''); originalSchedulePresent = Boolean(clinic.schedule_v1); scheduleDraft = clinic.schedule_v1 ? structuredClone(clinic.schedule_v1) : emptySchedule(); scheduleChanged = false; renderSchedule(); setStatus(`Ficha cargada. Estado live: ${detail.operationalState?.liveState || 'UNCONFIRMED'}.`); } catch (error) { setStatus(error.message, 'error'); } }
  async function mutate(path, method, body, button) { if (button) button.disabled = true; setStatus('Guardando…'); const mutationId = `${method}:${path}`; const key = mutationKeys.get(mutationId) || crypto.randomUUID(); mutationKeys.set(mutationId, key); const request = { method, headers: { 'Content-Type': 'application/json', 'X-Vet24-Admin': '1', 'Idempotency-Key': key }, body: JSON.stringify(body) }; try { const response = await fetch(path, request); const result = await response.json(); if (!response.ok) throw new Error(result.message || result.error || 'No se pudo guardar'); setStatus('Guardado correctamente.', 'success'); mutationKeys.delete(mutationId); if (detail && result.revision !== undefined) detail.overrideRevision = result.revision; return result; } catch (error) { setStatus(`${error.message} El formulario se conserva; puedes reintentar con la misma petición.`, 'error'); return null; } finally { if (button) button.disabled = false; } }
  document.querySelector('#save-override').onclick = event => { const closed = document.querySelector('#temporarilyClosed').value === 'true'; const expiryValue = document.querySelector('#expiresAt').value; if (closed && !expiryValue) { setStatus('Indica la expiración de la alerta.', 'error'); return; } mutate(`/api/admin/overrides/${encodeURIComponent(slug)}/`, 'PUT', { expectedRevision: detail?.overrideRevision || 0, temporarilyClosed: closed, message: document.querySelector('#message').value, schedule: null, expiresAt: closed ? new Date(expiryValue).toISOString() : null }, event.currentTarget); };
  document.querySelector('#remove-override').onclick = event => mutate(`/api/admin/overrides/${encodeURIComponent(slug)}/`, 'DELETE', { expectedRevision: detail?.overrideRevision || 0 }, event.currentTarget);
  document.querySelector('#propose').onclick = event => {
    if (!form.reportValidity() || !detail) return;
    const source = document.querySelector('#sourceUrl').value.trim();
    if (!source) { setStatus('Agrega una fuente pública antes de proponer.', 'error'); return; }
    const clinic = { ...detail.clinic };
    form.querySelectorAll('input[name]').forEach(input => { if (!input.readOnly) clinic[input.name] = input.type === 'checkbox' ? input.checked : (input.value !== '' ? (input.type === 'number' ? Number(input.value) : input.value) : clinic[input.name]); });
    clinic.verification_notes = document.querySelector('#verification_notes').value.split('\n').map(value => value.trim()).filter(Boolean);
    // An editor visit that only changes contact data must not manufacture an
    // unknown schedule or replace an existing one.
    if (scheduleChanged) clinic.schedule_v1 = structuredClone(scheduleDraft);
    else if (!originalSchedulePresent) delete clinic.schedule_v1;
    const existing = detail.evidence?.sidecar;
    const evidence = existing ? structuredClone(existing) : { schemaVersion: 1, slug, observedAt: new Date().toISOString(), fuentes: [], facts: [], conflicts: [] };
    evidence.slug = slug;
    evidence.observedAt = new Date().toISOString();
    evidence.fuentes = Array.isArray(evidence.fuentes) ? evidence.fuentes : [];
    let sourceIndex = evidence.fuentes.findIndex(item => item?.url === source);
    if (sourceIndex < 0) { sourceIndex = evidence.fuentes.length; evidence.fuentes.push({ url: source, tipo: 'publica' }); }
    evidence.facts = Array.isArray(evidence.facts) ? evidence.facts.filter(fact => fact?.field !== 'direccion' && fact?.field !== 'address') : [];
    evidence.facts.push({ field: 'direccion', value: clinic.direccion, references: [sourceIndex], confidence: 'medium' });
    evidence.conflicts = Array.isArray(evidence.conflicts) ? evidence.conflicts : [];
    const evidenceField = document.querySelector('#evidenceField').value.trim();
    const evidenceValue = document.querySelector('#evidenceValue').value.trim();
    if (evidenceField && evidenceValue) evidence.facts.push({ field: evidenceField, value: evidenceValue, references: [sourceIndex], confidence: document.querySelector('#evidenceConfidence').value });
    const conflictField = document.querySelector('#conflictField').value.trim();
    const conflictValues = document.querySelector('#conflictValues').value.split(',').map(value => value.trim()).filter(Boolean);
    const conflictResolution = document.querySelector('#conflictResolution').value.trim();
    if (conflictField || conflictValues.length || conflictResolution) { if (!conflictField || !conflictValues.length || !conflictResolution) { setStatus('Completa campo, valores y resolución del conflicto.', 'error'); return; } evidence.conflicts.push({ field: conflictField, values: conflictValues, references: [sourceIndex], resolution: conflictResolution }); }
    mutate('/api/admin/clinic-proposals/', 'POST', { slug, newClinic: false, baseCommit: detail.baseCommit, blobSha: detail.blobSha, clinic, bodyMarkdown: document.querySelector('#bodyMarkdown').value, evidence }, event.currentTarget);
  };
  load();
</script>
