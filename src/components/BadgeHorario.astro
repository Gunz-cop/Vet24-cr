---
interface Props {
  categoriaHorario: "24/7 Emergencias" | "Cierra después 21h" | "Horario normal";
  class?: string;
}

const { categoriaHorario, class: className = "" } = Astro.props;

let badgeStyles = "";
let text = "";

switch (categoriaHorario) {
  case "24/7 Emergencias":
    badgeStyles = "bg-brand-danger-bg text-brand-emergency border-brand-danger-border";
    text = "Emergencias 24/7";
    break;
  case "Cierra después 21h":
    badgeStyles = "bg-brand-warning-bg text-brand-warning-text border-brand-warning-border";
    text = "Cierra tarde (después de 9 p.m.)";
    break;
  case "Horario normal":
  default:
    badgeStyles = "bg-brand-surface text-brand-text-muted border-brand-card-border";
    text = "Horario diurno";
    break;
}
---

<span class={`inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-bold rounded-full border ${badgeStyles} ${className}`}>
  {categoriaHorario === "24/7 Emergencias" && (
    <span class="relative flex h-2 w-2">
      <span class="animate-sos-ping absolute inline-flex h-full w-full rounded-full bg-brand-emergency opacity-70"></span>
      <span class="relative inline-flex rounded-full h-2 w-2 bg-brand-emergency"></span>
    </span>
  )}
  {text}
</span>
