---
---

<div class="contents" aria-labelledby="filtros-rapidos-title">
  <!-- Emergency banner -->
  <div class="mb-4 rounded-2xl border border-brand-danger-border bg-brand-danger-bg p-4 sm:p-5">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div class="flex flex-col gap-1">
        <h2 class="text-base sm:text-lg font-bold text-brand-text font-['Outfit',sans-serif]">
          ¿Es una emergencia?
        </h2>
        <p class="text-sm text-brand-text-muted">
          Te llevamos directo a la veterinaria abierta más cercana a tu ubicación.
        </p>
      </div>
      <button
        type="button"
        data-sos-trigger
        class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-brand-emergency text-white text-sm font-bold hover:bg-brand-emergency-hover transition-colors shadow-lg shadow-brand-emergency/20 cursor-pointer shrink-0"
        id="cta-sos-directorio"
      >
        <span class="relative flex h-2 w-2">
          <span class="animate-sos-ping absolute inline-flex h-full w-full rounded-full bg-white opacity-80"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-white"></span>
        </span>
        Buscar ayuda ahora
      </button>
    </div>
  </div>

  <!-- SOS Highlight section (shown when SOS mode is activated).
       Lives ABOVE the sticky toolbar so the card is never covered by it. -->
  <div id="sos-highlight-container" class="hidden mb-6 scroll-mt-24"></div>

  <!-- Search + filter toolbar (not sticky: it must never cover the clinic cards) -->
  <div class="py-3 px-4 bg-brand-card-bg/60 border border-brand-card-border rounded-2xl mb-4 flex flex-col gap-3 transition-colors duration-200">
    <h2 id="filtros-rapidos-title" class="sr-only">Buscar y filtrar veterinarias</h2>

    <!-- Search Bar -->
    <div class="relative rounded-xl bg-brand-card-bg border border-brand-card-border focus-within:border-brand-primary/60 focus-within:ring-2 focus-within:ring-brand-primary/15 transition-all">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"
        class="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-brand-text-muted pointer-events-none">
        <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
      </svg>
      <input
        type="search"
        id="search-input"
        placeholder="Busca por nombre, zona o cantón…"
        autocomplete="off"
        aria-label="Buscar veterinarias por nombre, zona o cantón"
        class="w-full pl-11 pr-10 py-3 bg-transparent text-brand-text placeholder-brand-text-muted/60 text-sm focus:outline-none"
      />
      <button id="btn-clear-search" class="absolute right-3.5 top-1/2 -translate-y-1/2 text-brand-text-muted hover:text-brand-text transition-colors cursor-pointer hidden" aria-label="Limpiar búsqueda">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Filter chips -->
    <div class="flex items-center gap-2 overflow-x-auto scrollbar-none" role="group" aria-label="Filtros rápidos">
      <button id="filter-quick-open" class="filter-chip shrink-0" aria-pressed="false">
        <span class="h-2 w-2 rounded-full bg-brand-success"></span>
        Abierto ahora
      </button>

      <button id="filter-quick-247" class="filter-chip filter-chip--emergency shrink-0" aria-pressed="false">
        <span class="h-2 w-2 rounded-full bg-brand-emergency"></span>
        Emergencias 24/7
      </button>

      <button id="btn-use-location" class="filter-chip shrink-0" title="Ordenar por cercanía a tu ubicación">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
        </svg>
        <span id="geo-btn-text">Cerca de mí</span>
      </button>

      <span class="h-5 w-px bg-brand-card-border shrink-0 mx-1" aria-hidden="true"></span>

      <div class="flex items-center gap-2 shrink-0" id="animal-filters-container" role="group" aria-label="Filtrar por tipo de animal">
        <button data-filter-animal="todos" class="filter-chip is-active shrink-0" aria-pressed="true">Todos</button>
        <button data-filter-animal="domesticos" class="filter-chip shrink-0" aria-pressed="false">🐶🐱 Domésticos</button>
        <button data-filter-animal="exoticos" class="filter-chip shrink-0" aria-pressed="false">🐢 Exóticos</button>
        <button data-filter-animal="peces" class="filter-chip shrink-0" aria-pressed="false">🐠 Peces</button>
        <button data-filter-animal="granja" class="filter-chip shrink-0" aria-pressed="false">🐴 Granja</button>
      </div>

      <button id="filter-hotel" class="filter-chip shrink-0" aria-pressed="false" title="Mostrar veterinarias con hotel, hospedaje o guardería para mascotas">
        🏨 Hotel para mascotas
      </button>
    </div>

    <!-- Results meta -->
    <div class="flex items-center justify-between gap-3 text-sm">
      <p class="text-brand-text-muted" aria-live="polite">
        Mostrando <span id="results-count" class="font-bold text-brand-text">—</span> veterinarias
      </p>
      <button
        id="reset-all-filters"
        class="text-sm font-semibold text-brand-text-muted hover:text-brand-primary transition-colors cursor-pointer underline-offset-2 hover:underline"
        title="Restablecer todos los filtros"
      >
        Restablecer filtros
      </button>
    </div>
  </div>

  <!-- Enhanced empty state with fallback clinics -->
  <div id="empty-state" class="hidden w-full">
    <div class="text-center py-10 bg-brand-card-bg border border-dashed border-brand-card-border rounded-2xl p-8 mb-6">
      <div class="text-4xl mb-3" aria-hidden="true">🔍</div>
      <h3 class="text-base font-bold text-brand-text mb-1">No encontramos veterinarias con estos filtros</h3>
      <p class="text-sm text-brand-text-muted max-w-md mx-auto">Prueba con otros filtros o amplía la búsqueda.</p>
      <button id="reset-all-filters-empty" class="mt-4 px-4 py-2.5 text-sm font-bold rounded-xl bg-brand-primary text-white hover:bg-brand-primary-hover transition-colors cursor-pointer">
        Restablecer filtros
      </button>
    </div>

    <!-- Nearby fallback section (shown when geolocation is active) -->
    <div id="fallback-cercanas" class="hidden">
      <div class="flex flex-wrap items-center gap-2 mb-4">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-bold rounded-full bg-brand-warning-bg text-brand-warning-text border border-brand-warning-border">
          ⚠️ Llama antes de salir
        </span>
        <span class="text-sm text-brand-text-muted">Las más cercanas a ti (aunque estén cerradas ahora)</span>
      </div>
      <div id="empty-state-fallback-list" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4"></div>
    </div>
  </div>
</div>

<script>
  // ─── Haversine distance (km) ───────────────────────────────────────────
  function haversineKm(lat1: number, lng1: number, lat2: number, lng2: number): number {
    const R = 6371;
    const dLat = (lat2 - lat1) * Math.PI / 180;
    const dLng = (lng2 - lng1) * Math.PI / 180;
    const a = Math.sin(dLat / 2) ** 2 +
      Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
      Math.sin(dLng / 2) ** 2;
    return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
  }

  // ─── SOS Helpers ───────────────────────────────────────────────────────
  function renderClosestSOSEmergency(lat: number, lng: number) {
    const cards = Array.from(document.querySelectorAll<HTMLElement>('#clinicas-grid article'));

    let closestTierAB: HTMLElement | null = null;
    let minDistanceTierAB = Infinity;

    let closestOverall: HTMLElement | null = null;
    let minDistanceOverall = Infinity;

    cards.forEach(card => {
      if (card.classList.contains('hidden')) return;
      const isOpen = card.getAttribute('data-is-open') === 'true';
      const cLat = parseFloat(card.getAttribute('data-latitude') || '0');
      const cLng = parseFloat(card.getAttribute('data-longitude') || '0');
      const tier = card.getAttribute('data-tier') || '';

      if (isOpen && cLat !== 0 && cLng !== 0) {
        const dist = haversineKm(lat, lng, cLat, cLng);

        if (dist < minDistanceOverall) {
          minDistanceOverall = dist;
          closestOverall = card;
        }

        if (tier === 'Tier A' || tier === 'Tier B') {
          if (dist < minDistanceTierAB) {
            minDistanceTierAB = dist;
            closestTierAB = card;
          }
        }
      }
    });

    let closestClinic: HTMLElement | null = null;
    let minDistance = Infinity;
    let isPreferredTier = false;

    // En SOS el tiempo manda: sugerimos la clínica abierta más cercana.
    // Solo preferimos Tier A/B si el rodeo es mínimo, para no enviar a alguien varios kilómetros extra.
    const maxSpecializedDetourKm = 0.75;
    if (closestTierAB && minDistanceTierAB <= minDistanceOverall + maxSpecializedDetourKm) {
      closestClinic = closestTierAB;
      minDistance = minDistanceTierAB;
      isPreferredTier = true;
    } else if (closestOverall) {
      closestClinic = closestOverall;
      minDistance = minDistanceOverall;
      const tier = (closestOverall as HTMLElement).getAttribute('data-tier') || '';
      isPreferredTier = (tier === 'Tier A' || tier === 'Tier B');
    }

    const sosContainer = document.getElementById('sos-highlight-container');
    if (!sosContainer) return;

    if (closestClinic) {
      const el = closestClinic as HTMLElement;
      const nombre = el.getAttribute('data-original-nombre') || '';
      const zona = el.getAttribute('data-zona-text') || '';
      const direccion = el.getAttribute('data-direccion') || '';
      const horarioTexto = el.getAttribute('data-horario-texto') || '';
      const copyDiferenciador = el.getAttribute('data-copy') || '';
      const telefono1 = el.getAttribute('data-telefono') || '';
      const waze_url = el.getAttribute('data-waze-url') || '';
      const maps_url = el.getAttribute('data-maps-url') || '';

      const wazeHref = waze_url || `https://waze.com/ul?q=${encodeURIComponent(nombre + ', ' + direccion)}`;
      const mapsHref = maps_url || `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(nombre + ', ' + direccion)}`;

      sosContainer.innerHTML = `
        <div class="relative overflow-hidden p-6 rounded-2xl border-2 border-brand-emergency/50 bg-brand-card-bg shadow-xl shadow-brand-emergency/10 flex flex-col gap-4" id="sos-emergency-card">
          <div class="flex flex-col items-start gap-2">
            <span class="inline-flex items-center gap-2 px-4 py-2 text-xs font-bold rounded-full bg-brand-emergency text-white">
              <span class="relative flex h-2 w-2">
                <span class="animate-sos-ping absolute inline-flex h-full w-full rounded-full bg-white opacity-80"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-white"></span>
              </span>
              ${isPreferredTier ? 'Veterinaria de emergencias abierta más cercana' : 'Veterinaria abierta más cercana (horario regular)'}
            </span>
            <span class="text-sm font-bold text-brand-emergency">
              A ${minDistance.toFixed(1)} km de ti
            </span>
          </div>

          <div class="flex flex-col gap-2">
            <h3 class="text-2xl font-bold text-brand-text capitalize font-['Outfit',sans-serif]">${nombre}</h3>
            <p class="text-sm text-brand-text-muted capitalize flex items-start gap-1.5">
              <span aria-hidden="true">📍</span> <span>${zona} — <span class="normal-case">${direccion}</span></span>
            </p>
            <p class="text-sm text-brand-text flex items-center gap-1.5">
              <span aria-hidden="true">🕒</span> <span><strong>Horario:</strong> ${horarioTexto}</span>
            </p>
            <p class="text-sm text-brand-text-muted leading-relaxed">${copyDiferenciador}</p>
          </div>

          <div class="border-t border-brand-card-border"></div>

          <div class="flex flex-col gap-3 w-full">
            ${telefono1 ? `
              <a href="tel:+506${telefono1.replace(/\D/g,'')}" class="w-full inline-flex items-center justify-center gap-2 px-6 py-4 text-base font-bold rounded-xl bg-brand-emergency text-white hover:bg-brand-emergency-hover transition-colors text-center shadow-lg shadow-brand-emergency/20" id="btn-sos-call">
                📞 Llamar de inmediato (${telefono1})
              </a>
            ` : ''}

            <div class="grid grid-cols-2 gap-3 w-full">
              <a href="${wazeHref}" target="_blank" rel="noopener" class="w-full inline-flex items-center justify-center gap-2 px-5 py-3 text-sm font-bold rounded-xl bg-brand-surface border border-brand-card-border text-brand-text hover:border-brand-primary/45 transition-colors text-center">
                🚗 Ir con Waze
              </a>
              <a href="${mapsHref}" target="_blank" rel="noopener" class="w-full inline-flex items-center justify-center gap-2 px-5 py-3 text-sm font-bold rounded-xl bg-brand-surface border border-brand-card-border text-brand-text hover:border-brand-primary/45 transition-colors text-center">
                🗺️ Google Maps
              </a>
            </div>
          </div>
        </div>
      `;
      sosContainer.classList.remove('hidden');
      sosContainer.scrollIntoView({ behavior: 'smooth', block: 'start' });
    } else {
      showSOSSafetyNotice('No encontramos clínicas abiertas en este momento. Revisa el listado regular abajo:');
    }
  }

  function showSOSSafetyNotice(message: string) {
    const sosContainer = document.getElementById('sos-highlight-container');
    if (!sosContainer) return;

    sosContainer.innerHTML = `
      <div class="relative overflow-hidden p-6 rounded-2xl border border-brand-danger-border bg-brand-danger-bg shadow-lg flex flex-col gap-3">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 text-xs font-bold rounded-full bg-brand-emergency text-white w-fit">
          ⚠️ Atención de emergencia
        </span>
        <p class="text-sm font-semibold text-brand-text">${message}</p>
      </div>
    `;
    sosContainer.classList.remove('hidden');
    sosContainer.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  // ─── Costa Rica local time ─────────────────────────────────────────────
  function getCostaRicaTime() {
    const now = new Date();
    // Costa Rica is UTC-6 all year round (no DST)
    const crTime = new Date(now.getTime() - (6 * 60 * 60 * 1000));
    return {
      day: crTime.getUTCDay(),
      hour: crTime.getUTCHours(),
      minute: crTime.getUTCMinutes()
    };
  }

  // ─── Status update ─────────────────────────────────────────────────────
  function updateClinicsStatus() {
    const { day, hour } = getCostaRicaTime();
    const cards = document.querySelectorAll<HTMLElement>('#clinicas-grid article');
    let openCount = 0;

    cards.forEach(card => {
      const is247 = card.getAttribute('data-247') === 'true';
      const schedule = card.getAttribute('data-schedule');
      const statusBadge = card.querySelector<HTMLElement>('[data-status-for]');

      let isOpen = false;

      if (is247) {
        isOpen = true;
      } else if (schedule && schedule !== '24h') {
        const rules = schedule.split(',');
        for (const rule of rules) {
          const [daysPart, hoursPart] = rule.split(':');
          const [startHour, endHour] = hoursPart.split('-').map(Number);
          if (daysPart.includes('-')) {
            const [startDay, endDay] = daysPart.split('-').map(Number);
            const isDayMatch = startDay <= endDay
              ? (day >= startDay && day <= endDay)
              : (day >= startDay || day <= endDay);
            if (isDayMatch) {
              isOpen = hour >= startHour && hour < endHour;
              break;
            }
          } else {
            if (day === Number(daysPart)) {
              isOpen = hour >= startHour && hour < endHour;
              break;
            }
          }
        }
      }

      card.setAttribute('data-is-open', isOpen ? 'true' : 'false');
      if (isOpen) openCount++;

      if (statusBadge) {
        statusBadge.classList.add('status-pill');
        statusBadge.classList.toggle('is-open', isOpen);
        statusBadge.classList.toggle('is-closed', !isOpen);
        statusBadge.textContent = isOpen ? 'Abierto ahora' : 'Cerrado ahora';
      }
    });

    // Update the live "open now" counter in the hero, if present
    const openNowEl = document.getElementById('open-now-count');
    if (openNowEl) {
      openNowEl.textContent = String(openCount);
    }
  }

  // ─── State ─────────────────────────────────────────────────────────────
  let userLat: number | null = null;
  let userLng: number | null = null;
  let geoActive = false;
  let edgeGeoActive = false;
  let searchQuery = '';
  let filterOnlyOpen = false;
  let filterOnly247 = false;
  let filterOnlyHotel = false;
  let activeAnimal = 'todos';
  let inSOSFlow = false;
  let originalCardsOrder: HTMLElement[] = [];
  let autoGeoTimeoutId: any = null;
  let debounceTimeoutId: any = null;

  async function logInteraction(data: { query?: string; province?: string; canton?: string; filter_type?: string }) {
    try {
      let province = data.province || null;
      if (!province) {
        const pathParts = window.location.pathname.split('/').filter(Boolean);
        if (pathParts[0] === 'provincia' && pathParts[1]) {
          province = pathParts[1];
        }
      }
      await fetch('/api/analytics', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          query: data.query || null,
          province: province,
          canton: data.canton || null,
          filter_type: data.filter_type || null
        })
      });
    } catch (e) {
      console.warn('Error recording search analytics:', e);
    }
  }

  function scrollToFirstVisibleResult() {
    const firstVisibleCard = document.querySelector<HTMLElement>('#clinicas-grid article:not(.hidden)');
    const emptyState = document.getElementById('empty-state');
    const target = firstVisibleCard || (emptyState && !emptyState.classList.contains('hidden') ? emptyState : null);
    if (!target) return;

    window.setTimeout(() => {
      const top = target.getBoundingClientRect().top + window.scrollY - 90;
      window.scrollTo({ top: Math.max(top, 0), behavior: 'smooth' });
    }, 80);
  }

  function setChipActive(el: HTMLElement | null, active: boolean) {
    if (!el) return;
    el.classList.toggle('is-active', active);
    el.setAttribute('aria-pressed', active ? 'true' : 'false');
  }

  // Helper to restore original order and reset proximity status
  function restoreDefaultSorting() {
    const grid = document.getElementById('clinicas-grid');
    if (!grid || originalCardsOrder.length === 0) return;

    // Re-append in original priority order
    originalCardsOrder.forEach(card => grid.appendChild(card));

    const edgeActive = grid.getAttribute('data-edge-active') === 'true';
    const edgeLatAttr = grid.getAttribute('data-edge-lat');
    const edgeLngAttr = grid.getAttribute('data-edge-lng');

    // Hide or update distance badges based on server-side geolocation fallback
    originalCardsOrder.forEach(card => {
      const distBadge = card.querySelector<HTMLElement>('[data-distance-for]');
      if (distBadge) {
        if (edgeActive && edgeLatAttr && edgeLngAttr) {
          const cLat = parseFloat(card.getAttribute('data-latitude') || '0');
          const cLng = parseFloat(card.getAttribute('data-longitude') || '0');
          if (cLat !== 0 || cLng !== 0) {
            const km = haversineKm(parseFloat(edgeLatAttr), parseFloat(edgeLngAttr), cLat, cLng);
            distBadge.textContent = `A ${km.toFixed(1)} km`;
            distBadge.classList.remove('hidden');
          } else {
            distBadge.classList.add('hidden');
            distBadge.textContent = '';
          }
        } else {
          distBadge.classList.add('hidden');
          distBadge.textContent = '';
        }
      }
    });

    // Reset state variables
    geoActive = false;

    const geoBtn = document.getElementById('btn-use-location');
    const geoBtnText = document.getElementById('geo-btn-text');

    if (edgeActive && edgeLatAttr && edgeLngAttr) {
      userLat = parseFloat(edgeLatAttr);
      userLng = parseFloat(edgeLngAttr);
      edgeGeoActive = true;

      const cityAttr = grid.getAttribute('data-edge-city');
      if (geoBtnText) geoBtnText.textContent = cityAttr ? 'Ubicación aproximada' : 'Cerca de tu zona';
      if (geoBtn) {
        geoBtn.classList.remove('opacity-60', 'pointer-events-none');
        geoBtn.classList.add('is-active');
      }
    } else {
      userLat = null;
      userLng = null;
      edgeGeoActive = false;

      if (geoBtnText) geoBtnText.textContent = 'Cerca de mí';
      if (geoBtn) {
        geoBtn.classList.remove('is-active', 'opacity-60', 'pointer-events-none');
      }
    }

    // Remove user pin from the map
    const map = (window as any).__vet24Map;
    if (map) {
      map.eachLayer((layer: any) => {
        if (layer.options && layer.options.icon && layer.options.icon.options && layer.options.icon.options.className === 'user-location-pin') {
          map.removeLayer(layer);
        }
      });
    }
  }

  // ─── Apply all filters ─────────────────────────────────────────────────
  function applyAllFilters() {
    if (!inSOSFlow) {
      const sosContainer = document.getElementById('sos-highlight-container');
      if (sosContainer) sosContainer.classList.add('hidden');
    }

    const cards = Array.from(document.querySelectorAll<HTMLElement>('#clinicas-grid article'));
    const emptyState = document.getElementById('empty-state');
    const fallbackSection = document.getElementById('fallback-cercanas');
    const fallbackGrid = document.getElementById('empty-state-fallback-list');
    let visibleCount = 0;
    const visibleCoords: [number, number][] = [];

    cards.forEach(card => {
      const isOpen = card.getAttribute('data-is-open') === 'true';
      const is247 = card.getAttribute('data-247') === 'true';
      const atiendeExoticos = card.getAttribute('data-exoticos') === 'true';
      const atiendeGranja = card.getAttribute('data-granja') === 'true';
      const atiendePeces = card.getAttribute('data-peces') === 'true';
      const ofreceHotel = card.getAttribute('data-hotel') === 'true';
      const confidence = card.getAttribute('data-confidence');
      const status = card.getAttribute('data-record-status');
      const emergencyVerified = card.getAttribute('data-emergency-verified') === 'true';
      const nombre = card.getAttribute('data-nombre') || '';
      const zona = card.getAttribute('data-zona-text') || '';

      let show = true;

      // Safety: hide unverified clinics when filtering for emergency help
      if (filterOnly247) {
        if (confidence === 'low' || status === 'REVIEW_REQUIRED' || !emergencyVerified) {
          show = false;
        }
      } else if (filterOnlyOpen) {
        // En búsqueda diurna (Abierto Ahora), permitimos veterinarias diurnas normales que sean confiables,
        // pero seguimos filtrando aquellas con baja confianza, en revisión, o si dicen ser 24/7 sin verificación.
        if (confidence === 'low' || status === 'REVIEW_REQUIRED') {
          show = false;
        } else if (is247 && !emergencyVerified) {
          show = false;
        }
      }

      if (filterOnlyOpen && !isOpen) show = false;
      if (filterOnly247 && !is247) show = false;
      if (filterOnlyHotel && !ofreceHotel) show = false;
      if (activeAnimal === 'exoticos' && !atiendeExoticos) show = false;
      if (activeAnimal === 'granja' && !atiendeGranja) show = false;
      if (activeAnimal === 'peces' && !atiendePeces) show = false;

      // Text search
      if (searchQuery) {
        const q = searchQuery.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
        const nameNorm = nombre.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
        const zoneNorm = zona.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
        const provinceNorm = card.getAttribute('data-provincia-text') || '';
        const directionNorm = (card.getAttribute('data-direccion') || '').toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");

        let match = nameNorm.includes(q) || zoneNorm.includes(q) || provinceNorm.includes(q) || directionNorm.includes(q);

        // Tags/services matching
        if (q.includes("exotic") && atiendeExoticos) match = true;
        if (q.includes("granja") && atiendeGranja) match = true;
        if (q.includes("pece") && atiendePeces) match = true;
        if ((q.includes("hotel") || q.includes("hosped") || q.includes("guarder")) && ofreceHotel) match = true;
        if ((q.includes("domes") || q.includes("perro") || q.includes("gato")) && true) match = true;

        if (!match) {
          show = false;
        }
      }

      if (show) {
        card.classList.remove('hidden');
        visibleCount++;

        const lat = parseFloat(card.getAttribute('data-latitude') || '0');
        const lng = parseFloat(card.getAttribute('data-longitude') || '0');
        if (lat !== 0 && lng !== 0) {
          visibleCoords.push([lat, lng]);
        }
      } else {
        card.classList.add('hidden');
      }

      // Sync map markers with filter state
      const slug = card.getAttribute('data-slug') || '';
      const markers = (window as any).__vet24Markers;
      const map = (window as any).__vet24Map;

      if (markers && map && slug && markers[slug]) {
        if (show) {
          markers[slug].addTo(map);
        } else {
          map.removeLayer(markers[slug]);
        }
      }
    });

    // Live results count
    const resultsCountEl = document.getElementById('results-count');
    if (resultsCountEl) {
      resultsCountEl.textContent = `${visibleCount} de ${cards.length}`;
    }

    // Empty state handling
    if (emptyState) {
      if (visibleCount === 0) {
        emptyState.classList.remove('hidden');

        // Show nearby fallback if geolocation is active (either browser GPS or server Edge IP)
        if ((geoActive || edgeGeoActive) && userLat !== null && userLng !== null && fallbackSection && fallbackGrid) {
          const cardsWithCoords = cards
            .filter(c => parseFloat(c.getAttribute('data-latitude') || '0') !== 0)
            .map(c => ({
              el: c,
              dist: haversineKm(userLat!, userLng!, parseFloat(c.getAttribute('data-latitude')!), parseFloat(c.getAttribute('data-longitude')!)),
              nombre: c.getAttribute('data-original-nombre') || '',
              zone: c.getAttribute('data-zona-text') || '',
              href: `/clinica/${c.getAttribute('data-slug') || ''}/`,
              is247: c.getAttribute('data-247') === 'true',
            }))
            .sort((a, b) => a.dist - b.dist)
            .slice(0, 3);

          if (cardsWithCoords.length > 0) {
            fallbackGrid.innerHTML = cardsWithCoords.map(({ dist, nombre, zone, href, is247 }) => `
              <a href="${href}" class="flex flex-col gap-1.5 p-4 rounded-xl bg-brand-card-bg border border-brand-card-border hover:border-brand-primary/40 transition-colors">
                <div class="flex items-center gap-2 justify-between">
                  <span class="text-sm font-bold text-brand-text">${nombre}</span>
                  <span class="text-xs font-bold px-2 py-0.5 rounded-full ${is247 ? 'bg-brand-danger-bg text-brand-emergency border border-brand-danger-border' : 'bg-brand-surface border border-brand-card-border text-brand-text-muted'}">
                    ${is247 ? '24/7' : 'Horario regular'}
                  </span>
                </div>
                <span class="text-xs text-brand-text-muted capitalize">📍 ${zone}</span>
                <span class="text-xs font-semibold text-brand-primary">A ${dist.toFixed(1)} km de ti</span>
              </a>
            `).join('');
            fallbackSection.classList.remove('hidden');
          }
        } else if (fallbackSection) {
          fallbackSection.classList.add('hidden');
        }
      } else {
        emptyState.classList.add('hidden');
        if (fallbackSection) fallbackSection.classList.add('hidden');
      }
    }

    // Auto-fit map bounds to visible markers
    const map = (window as any).__vet24Map;
    const L = (window as any).__vet24L;
    if (map && L) {
      const allCoords = [...visibleCoords];
      if (geoActive && userLat !== null && userLng !== null) {
        allCoords.push([userLat, userLng]);
      }
      if (allCoords.length > 0) {
        const bounds = L.latLngBounds(allCoords);
        // animate:false — a stuck zoom transition would swallow later map moves.
        map.fitBounds(bounds, { padding: [40, 40], maxZoom: 14, animate: false });
      }
    }
  }

  // Helper to draw user location marker on the map safely when Leaflet is ready
  function drawUserPinOnMap(lat: number, lng: number) {
    const L = (window as any).__vet24L;
    const map = (window as any).__vet24Map;
    if (L && map) {
      // First clean up any existing user pins
      map.eachLayer((layer: any) => {
        if (layer.options && layer.options.icon && layer.options.icon.options && layer.options.icon.options.className === 'user-location-pin') {
          map.removeLayer(layer);
        }
      });

      const userIcon = L.divIcon({
        html: `<div style="
          width:16px;height:16px;
          background:var(--brand-secondary, #38bdf8);
          border:3px solid white;
          border-radius:50%;
          box-shadow:0 0 0 4px rgba(56,189,248,0.3);
          pointer-events: none;
        "></div>`,
        className: 'user-location-pin',
        iconSize: [16, 16],
        iconAnchor: [8, 8],
      });
      L.marker([lat, lng], { icon: userIcon })
        .addTo(map)
        .bindPopup('<strong>📍 Tu ubicación</strong>')
        .openPopup();
      map.setView([lat, lng], 11, { animate: false });
    }
  }

  // ─── Sort by proximity ────────────────────────────────────────────────
  function sortByProximity(lat: number, lng: number) {
    // Dynamically trigger map initialization in background without rendering block if not ready yet
    if (!(window as any).__vet24Map && (window as any).__triggerMapInitialization) {
      (window as any).__triggerMapInitialization().then(() => {
        drawUserPinOnMap(lat, lng);
      });
    } else {
      drawUserPinOnMap(lat, lng);
    }

    const grid = document.getElementById('clinicas-grid');
    if (!grid) return;

    const cards = Array.from(grid.querySelectorAll<HTMLElement>('article'));
    cards.sort((a, b) => {
      const aLat = parseFloat(a.getAttribute('data-latitude') || '0');
      const aLng = parseFloat(a.getAttribute('data-longitude') || '0');
      const bLat = parseFloat(b.getAttribute('data-latitude') || '0');
      const bLng = parseFloat(b.getAttribute('data-longitude') || '0');

      const aDist = (aLat === 0 && aLng === 0) ? Infinity : haversineKm(lat, lng, aLat, aLng);
      const bDist = (bLat === 0 && bLng === 0) ? Infinity : haversineKm(lat, lng, bLat, bLng);
      return aDist - bDist;
    });

    // Re-append in sorted order
    cards.forEach(card => grid.appendChild(card));

    // Update distance badges
    cards.forEach(card => {
      const lat2 = parseFloat(card.getAttribute('data-latitude') || '0');
      const lng2 = parseFloat(card.getAttribute('data-longitude') || '0');
      const distBadge = card.querySelector<HTMLElement>('[data-distance-for]');
      if (distBadge) {
        if (lat2 !== 0 || lng2 !== 0) {
          const km = haversineKm(lat, lng, lat2, lng2);
          distBadge.textContent = `A ${km.toFixed(1)} km`;
          distBadge.classList.remove('hidden', 'opacity-40');
        } else {
          distBadge.textContent = 'Sin coordenadas';
          distBadge.classList.remove('hidden');
          distBadge.classList.add('opacity-40');
        }
      }
    });
  }

  // ─── Setup event listeners ─────────────────────────────────────────────
  function setupFilters() {
    const filterOpenBtn = document.getElementById('filter-quick-open');
    const filter247Btn = document.getElementById('filter-quick-247');
    const hotelBtn = document.getElementById('filter-hotel');
    const geoBtn = document.getElementById('btn-use-location');
    const geoBtnText = document.getElementById('geo-btn-text');
    const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
    const clearBtn = document.getElementById('btn-clear-search');
    const resetBtn = document.getElementById('reset-all-filters');
    const emptyResetBtn = document.getElementById('reset-all-filters-empty');
    const animalFilters = document.querySelectorAll<HTMLElement>('[data-filter-animal]');

    // ── Search ──
    searchInput?.addEventListener('input', () => {
      searchQuery = searchInput.value.trim().toLowerCase();
      if (clearBtn) clearBtn.classList.toggle('hidden', !searchQuery);
      applyAllFilters();

      // Debounce analytics
      if (debounceTimeoutId) clearTimeout(debounceTimeoutId);
      if (searchQuery) {
        debounceTimeoutId = setTimeout(() => {
          logInteraction({ query: searchQuery, filter_type: 'search' });
        }, 1500);
      }
    });

    searchInput?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        scrollToFirstVisibleResult();
      }
    });

    clearBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      searchQuery = '';
      clearBtn.classList.add('hidden');
      applyAllFilters();
    });

    // ── Reset all ──
    const handleReset = () => {
      filterOnlyOpen = false;
      filterOnly247 = false;
      filterOnlyHotel = false;
      activeAnimal = 'todos';
      searchQuery = '';
      if (searchInput) searchInput.value = '';
      if (clearBtn) clearBtn.classList.add('hidden');

      setChipActive(filterOpenBtn, false);
      setChipActive(filter247Btn, false);
      setChipActive(hotelBtn, false);

      animalFilters.forEach(b => setChipActive(b, b.getAttribute('data-filter-animal') === 'todos'));

      restoreDefaultSorting();
      applyAllFilters();
      scrollToFirstVisibleResult();
    };

    resetBtn?.addEventListener('click', handleReset);
    emptyResetBtn?.addEventListener('click', handleReset);

    // ── Open Now ──
    filterOpenBtn?.addEventListener('click', () => {
      filterOnlyOpen = !filterOnlyOpen;
      setChipActive(filterOpenBtn, filterOnlyOpen);
      applyAllFilters();
      scrollToFirstVisibleResult();
      logInteraction({ filter_type: filterOnlyOpen ? 'filter_open_true' : 'filter_open_false' });
    });

    // ── Solo 24/7 ──
    filter247Btn?.addEventListener('click', () => {
      filterOnly247 = !filterOnly247;
      setChipActive(filter247Btn, filterOnly247);
      applyAllFilters();
      scrollToFirstVisibleResult();
      logInteraction({ filter_type: filterOnly247 ? 'filter_247_true' : 'filter_247_false' });
    });

    // ── Hotel para mascotas ──
    hotelBtn?.addEventListener('click', () => {
      filterOnlyHotel = !filterOnlyHotel;
      setChipActive(hotelBtn, filterOnlyHotel);
      applyAllFilters();
      scrollToFirstVisibleResult();
      logInteraction({ filter_type: filterOnlyHotel ? 'filter_hotel_true' : 'filter_hotel_false' });
    });

    // ── Geolocation ──
    geoBtn?.addEventListener('click', () => {
      if (autoGeoTimeoutId) {
        clearTimeout(autoGeoTimeoutId);
      }
      if (geoActive) {
        restoreDefaultSorting();
        applyAllFilters();
        return;
      }

      if (!navigator.geolocation) {
        alert('Tu navegador no soporta geolocalización.');
        return;
      }

      if (geoBtnText) geoBtnText.textContent = 'Obteniendo ubicación…';
      geoBtn.classList.add('opacity-60', 'pointer-events-none');

      navigator.geolocation.getCurrentPosition(
        (pos) => {
          userLat = pos.coords.latitude;
          userLng = pos.coords.longitude;
          geoActive = true;

          if (geoBtnText) geoBtnText.textContent = 'Ordenado por cercanía';
          geoBtn.classList.remove('opacity-60', 'pointer-events-none');
          geoBtn.classList.add('is-active');

          sortByProximity(userLat, userLng);
          applyAllFilters();
          scrollToFirstVisibleResult();
          logInteraction({ filter_type: 'geo_gps_success' });
        },
        (err) => {
          console.warn('Geolocation error:', err.message);
          if (geoBtnText) geoBtnText.textContent = 'Cerca de mí';
          geoBtn.classList.remove('opacity-60', 'pointer-events-none');
          alert('No pudimos acceder a tu ubicación. Revisa los permisos del navegador.');
          logInteraction({ filter_type: 'geo_gps_error' });
        },
        { enableHighAccuracy: true, timeout: 10000, maximumAge: 60000 }
      );
    });

    // ── Animal filters ──
    animalFilters.forEach(btn => {
      btn.addEventListener('click', () => {
        animalFilters.forEach(b => setChipActive(b, b === btn));
        activeAnimal = btn.getAttribute('data-filter-animal') || 'todos';
        applyAllFilters();
        scrollToFirstVisibleResult();
        logInteraction({ filter_type: `filter_animal_${activeAnimal}` });
      });
    });

    // ── SOS Emergency Trigger ──
    const triggerSOSEmergency = () => {
      if (autoGeoTimeoutId) {
        clearTimeout(autoGeoTimeoutId);
      }
      inSOSFlow = true;
      filterOnlyOpen = true;
      filterOnly247 = false; // Permitimos cualquier clínica abierta, no solo 24/7, para atender emergencias diurnas localmente

      setChipActive(filterOpenBtn, true);
      setChipActive(filter247Btn, false);

      const sosContainer = document.getElementById('sos-highlight-container');
      if (sosContainer) sosContainer.classList.add('hidden');

      if (!navigator.geolocation) {
        applyAllFilters();
        inSOSFlow = false;
        showSOSSafetyNotice('Tu navegador no soporta geolocalización, pero filtramos todas las clínicas abiertas en este momento.');
        return;
      }

      if (geoBtnText) geoBtnText.textContent = 'Obteniendo ubicación…';
      if (geoBtn) geoBtn.classList.add('opacity-60', 'pointer-events-none');

      navigator.geolocation.getCurrentPosition(
        (pos) => {
          userLat = pos.coords.latitude;
          userLng = pos.coords.longitude;
          geoActive = true;

          if (geoBtnText) geoBtnText.textContent = 'Ordenado por cercanía';
          if (geoBtn) {
            geoBtn.classList.remove('opacity-60', 'pointer-events-none');
            geoBtn.classList.add('is-active');
          }

          sortByProximity(userLat, userLng);
          applyAllFilters();
          renderClosestSOSEmergency(userLat, userLng);
          inSOSFlow = false;
        },
        (err) => {
          console.warn('Geolocation error during SOS:', err.message);
          if (geoBtnText) geoBtnText.textContent = 'Cerca de mí';
          if (geoBtn) geoBtn.classList.remove('opacity-60', 'pointer-events-none');

          applyAllFilters();
          showSOSSafetyNotice('No pudimos acceder a tu ubicación. Mostrando todas las clínicas abiertas en este momento:');
          inSOSFlow = false;
        },
        // SOS: exige GPS de alta precisión y posición fresca (máx. 30 s de caché);
        // una posición vieja o aproximada puede sugerir la clínica equivocada.
        { enableHighAccuracy: true, timeout: 10000, maximumAge: 30000 }
      );
    };

    window.addEventListener('sos-trigger', triggerSOSEmergency);

    let hasPendingSOS = window.location.search.includes('sos=true');
    try {
      hasPendingSOS = hasPendingSOS || window.sessionStorage.getItem('vet24-sos-pending') === 'true';
      window.sessionStorage.removeItem('vet24-sos-pending');
    } catch (e) {
      console.warn('No se pudo leer el estado SOS pendiente:', e);
    }

    if (hasPendingSOS) {
      setTimeout(triggerSOSEmergency, 300);
    }
  }

  function init() {
    updateClinicsStatus();

    // Store original order of clinic cards
    const grid = document.getElementById('clinicas-grid');
    if (grid) {
      originalCardsOrder = Array.from(grid.querySelectorAll<HTMLElement>('article'));

      const edgeActive = grid.getAttribute('data-edge-active') === 'true';
      if (edgeActive) {
        const latAttr = grid.getAttribute('data-edge-lat');
        const lngAttr = grid.getAttribute('data-edge-lng');
        const cityAttr = grid.getAttribute('data-edge-city');

        if (latAttr && lngAttr) {
          userLat = parseFloat(latAttr);
          userLng = parseFloat(lngAttr);
          edgeGeoActive = true;

          // Update button text to show it is sorted by Edge IP location
          const geoBtnText = document.getElementById('geo-btn-text');
          const geoBtn = document.getElementById('btn-use-location');
          if (geoBtnText) {
            geoBtnText.textContent = cityAttr ? 'Ubicación aproximada' : 'Cerca de tu zona';
          }
          if (geoBtn) {
            geoBtn.classList.add('is-active');
          }
        }
      }
    }

    // Initialize the results counter
    applyAllFilters();

    setupFilters();

    // Refresh open/closed status every minute so long-lived tabs stay accurate
    setInterval(() => {
      updateClinicsStatus();
    }, 60000);

    // Auto-locate if permission is already granted or on the home page (Todas las provincias)
    const isTodasProvincias = window.location.pathname === '/' || window.location.pathname === '/index.html' || !window.location.pathname.includes('/provincia/');
    const geoBtn = document.getElementById('btn-use-location');
    const geoBtnText = document.getElementById('geo-btn-text');

    if (navigator.geolocation && geoBtn) {
      const triggerAutoGeo = () => {
        if (geoActive) return; // Don't run if already active or clicked
        if (geoBtnText) geoBtnText.textContent = 'Obteniendo ubicación…';
        geoBtn.classList.add('opacity-60', 'pointer-events-none');

        navigator.geolocation.getCurrentPosition(
          (pos) => {
            userLat = pos.coords.latitude;
            userLng = pos.coords.longitude;
            geoActive = true;

            if (geoBtnText) geoBtnText.textContent = 'Ordenado por cercanía';
            geoBtn.classList.remove('opacity-60', 'pointer-events-none');
            geoBtn.classList.add('is-active');

            sortByProximity(userLat, userLng);
            applyAllFilters();
          },
          (err) => {
            console.warn('Auto-geolocation error:', err.message);
            if (geoBtnText) geoBtnText.textContent = 'Cerca de mí';
            geoBtn.classList.remove('opacity-60', 'pointer-events-none');
          },
          { timeout: 10000, maximumAge: 300000 }
        );
      };

      if (navigator.permissions && navigator.permissions.query) {
        try {
          navigator.permissions.query({ name: 'geolocation' })
            .then((result) => {
              if (result.state === 'granted') {
                triggerAutoGeo();
              } else if (result.state === 'prompt' && isTodasProvincias) {
                // Only prompt automatically on the home page (Todas las provincias) after a short delay
                autoGeoTimeoutId = setTimeout(triggerAutoGeo, 800);
              }
            })
            .catch((err) => {
              console.warn('Permissions query rejected:', err);
              if (isTodasProvincias) autoGeoTimeoutId = setTimeout(triggerAutoGeo, 800);
            });
        } catch (e) {
          console.warn('Permissions query threw error:', e);
          if (isTodasProvincias) autoGeoTimeoutId = setTimeout(triggerAutoGeo, 800);
        }
      } else if (isTodasProvincias) {
        // Fallback for browsers that don't support query permission
        autoGeoTimeoutId = setTimeout(triggerAutoGeo, 800);
      }
    }
  }

  if (document.readyState !== 'loading') {
    init();
  } else {
    document.addEventListener('DOMContentLoaded', init);
  }
</script>
