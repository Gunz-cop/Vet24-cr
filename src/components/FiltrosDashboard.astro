---
---

<div class="w-full mb-8 flex flex-col gap-3">
  <!-- Search Bar -->
  <div class="relative">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" 
      class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-500 pointer-events-none">
      <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
    </svg>
    <input 
      type="search" 
      id="search-input" 
      placeholder="Buscar por nombre, zona, cantón…"
      autocomplete="off"
      class="w-full pl-10 pr-4 py-3 rounded-xl bg-slate-900/60 border border-slate-800 text-slate-100 placeholder-slate-500 text-sm focus:outline-none focus:border-rose-500/50 focus:ring-1 focus:ring-rose-500/20 transition-all"
    />
    <button id="btn-clear-search" class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-500 hover:text-slate-300 hidden" aria-label="Limpiar búsqueda font-semibold">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Filters row -->
  <div class="p-3 rounded-2xl bg-slate-900/20 border border-slate-900 backdrop-blur-sm flex flex-col gap-3">
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-3">
      <!-- Status Toggles + Geolocation -->
      <div class="flex items-center gap-2 flex-wrap">
        <span class="text-xs text-slate-500 font-bold mr-1 uppercase">Estado:</span>
        <button 
          id="filter-quick-open" 
          class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-lg border border-slate-800 bg-slate-950/60 text-slate-400 hover:text-white transition-all cursor-pointer active:scale-95"
        >
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
          Abierto Ahora
        </button>
        
        <button 
          id="filter-quick-247" 
          class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-lg border border-slate-800 bg-slate-950/60 text-slate-400 hover:text-white transition-all cursor-pointer active:scale-95"
        >
          <span class="h-1.5 w-1.5 rounded-full bg-rose-500"></span>
          Solo 24/7
        </button>

        <button
          id="btn-use-location"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-lg border border-slate-800 bg-slate-950/60 text-slate-400 hover:text-blue-300 hover:border-blue-500/30 transition-all cursor-pointer active:scale-95"
          title="Ordenar por cercanía a tu ubicación"
        >
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
          </svg>
          <span id="geo-btn-text">Ordenar por cercanía</span>
        </button>

        <button
          id="reset-all-filters"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-lg border border-slate-800 bg-slate-950/60 text-slate-400 hover:text-rose-350 hover:border-rose-500/30 transition-all cursor-pointer active:scale-95"
          title="Restablecer todos los filtros"
        >
          Restablecer filtros
        </button>
      </div>

      <!-- Animal Types -->
      <div class="flex items-center gap-1.5 overflow-x-auto pb-1 lg:pb-0 scrollbar-none" id="animal-filters-container">
        <span class="text-xs text-slate-500 font-bold mr-1 shrink-0 uppercase">Especie:</span>
        <button 
          data-filter-animal="todos" 
          class="px-3 py-1.5 text-xs font-bold rounded-lg border border-transparent bg-rose-500 text-white transition-all cursor-pointer active:scale-95 shrink-0"
        >
          Todos
        </button>
        <button 
          data-filter-animal="domesticos" 
          class="px-3 py-1.5 text-xs font-bold rounded-lg border border-slate-800 bg-slate-950/40 text-slate-400 hover:text-white transition-all cursor-pointer active:scale-95 shrink-0"
        >
          🐶🐱 Domésticos
        </button>
        <button 
          data-filter-animal="exoticos" 
          class="px-3 py-1.5 text-xs font-bold rounded-lg border border-slate-800 bg-slate-950/40 text-slate-400 hover:text-white transition-all cursor-pointer active:scale-95 shrink-0"
        >
          🐢 Exóticos
        </button>
        <button 
          data-filter-animal="peces" 
          class="px-3 py-1.5 text-xs font-bold rounded-lg border border-slate-800 bg-slate-950/40 text-slate-400 hover:text-white transition-all cursor-pointer active:scale-95 shrink-0"
        >
          🐠 Peces
        </button>
        <button 
          data-filter-animal="granja" 
          class="px-3 py-1.5 text-xs font-bold rounded-lg border border-slate-800 bg-slate-950/40 text-slate-400 hover:text-white transition-all cursor-pointer active:scale-95 shrink-0"
        >
          🐴 Granja (Vacas/Caballos)
        </button>
      </div>
    </div>
  </div>
</div>

<!-- SOS Highlight section (shown when SOS mode is activated) -->
<div id="sos-highlight-container" class="hidden mb-8 scroll-mt-24"></div>

<!-- Enhanced empty state with fallback clinics -->
<div id="empty-state" class="hidden w-full">
  <div class="text-center py-10 bg-slate-900/20 border border-dashed border-slate-800 rounded-2xl p-8 mb-6">
    <div class="text-4xl mb-3">🔍</div>
    <h3 class="text-base font-semibold text-slate-200 mb-1">No encontramos veterinarias con estos filtros</h3>
    <p class="text-sm text-slate-500 max-w-md mx-auto">Prueba cambiando los filtros o amplía la búsqueda.</p>
    <button id="reset-all-filters-empty" class="mt-4 px-4 py-2 text-xs font-bold rounded-lg bg-rose-500/10 text-rose-400 border border-rose-500/20 hover:bg-rose-500/20 transition-colors cursor-pointer">
      Restablecer filtros
    </button>
  </div>

  <!-- Nearby fallback section (shown when geolocation is active) -->
  <div id="fallback-cercanas" class="hidden">
    <div class="flex items-center gap-2 mb-4">
      <span class="inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-bold rounded-full bg-amber-500/10 text-amber-400 border border-amber-500/20">
        ⚠️ Llamar antes de salir
      </span>
      <span class="text-xs text-slate-400">Las más cercanas a ti (aunque estén cerradas ahora)</span>
    </div>
    <div id="empty-state-fallback-list" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4"></div>
  </div>
</div>

<style>
  .scrollbar-none::-webkit-scrollbar { display: none; }
  .scrollbar-none { -ms-overflow-style: none; scrollbar-width: none; }
</style>

<script>
  // ─── Haversine distance (km) ───────────────────────────────────────────
  function haversineKm(lat1: number, lng1: number, lat2: number, lng2: number): number {
    const R = 6371;
    const dLat = (lat2 - lat1) * Math.PI / 180;
    const dLng = (lng2 - lng1) * Math.PI / 180;
    const a = Math.sin(dLat / 2) ** 2 +
      Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
      Math.sin(dLng / 2) ** 2;
    return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
  }

  // ─── SOS Helpers ───────────────────────────────────────────────────────
  function renderClosestSOSEmergency(lat: number, lng: number) {
    const cards = Array.from(document.querySelectorAll<HTMLElement>('#clinicas-grid article'));
    let closestClinic: HTMLElement | null = null;
    let minDistance = Infinity;

    cards.forEach(card => {
      const isOpen = card.getAttribute('data-is-open') === 'true';
      const is247 = card.getAttribute('data-247') === 'true';
      const cLat = parseFloat(card.getAttribute('data-latitude') || '0');
      const cLng = parseFloat(card.getAttribute('data-longitude') || '0');
      
      if (isOpen && is247 && cLat !== 0 && cLng !== 0) {
        const dist = haversineKm(lat, lng, cLat, cLng);
        if (dist < minDistance) {
          minDistance = dist;
          closestClinic = card;
        }
      }
    });

    const sosContainer = document.getElementById('sos-highlight-container');
    if (!sosContainer) return;

    if (closestClinic) {
      const el = closestClinic as HTMLElement;
      const nombre = el.getAttribute('data-original-nombre') || '';
      const zona = el.getAttribute('data-zona-text') || '';
      const direccion = el.getAttribute('data-direccion') || '';
      const horarioTexto = el.getAttribute('data-horario-texto') || '';
      const copyDiferenciador = el.getAttribute('data-copy') || '';
      const telefono1 = el.getAttribute('data-telefono') || '';
      const waze_url = el.getAttribute('data-waze-url') || '';
      const maps_url = el.getAttribute('data-maps-url') || '';

      sosContainer.innerHTML = `
        <div class="relative overflow-hidden p-6 rounded-2xl border-2 border-rose-500 bg-gradient-to-r from-rose-950/60 to-slate-900/90 shadow-2xl shadow-rose-900/10 flex flex-col gap-4 animate-[pulse_3s_infinite]" id="sos-emergency-card">
          <!-- Badge -->
          <div class="flex items-center justify-between flex-wrap gap-2">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 text-xs font-black rounded-full bg-rose-500 text-white animate-pulse">
              🚨 LA VETERINARIA ABIERTA 24/7 MÁS CERCANA
            </span>
            <span class="text-xs font-black text-rose-450 uppercase tracking-widest font-['Outfit',sans-serif]">
              A ${minDistance.toFixed(1)} km de ti
            </span>
          </div>

          <!-- Content -->
          <div>
            <h3 class="text-xl font-black text-white capitalize mb-1 font-['Outfit',sans-serif]">${nombre}</h3>
            <p class="text-xs text-slate-300 capitalize mb-1">📍 ${zona} — <span class="font-normal text-slate-450">${direccion}</span></p>
            <p class="text-xs text-rose-450 font-bold mb-3">🕒 Horario de emergencias: ${horarioTexto}</p>
            <p class="text-xs text-slate-450 font-light leading-relaxed">${copyDiferenciador}</p>
          </div>

          <!-- CTAs -->
          <div class="flex flex-wrap items-center gap-3 border-t border-rose-500/20 pt-4 mt-1">
            ${telefono1 ? `
              <a href="tel:+506${telefono1.replace(/\D/g,'')}" class="flex-grow sm:flex-grow-0 inline-flex items-center justify-center gap-2 px-6 py-3 text-sm font-extrabold rounded-xl bg-rose-500 hover:bg-rose-600 text-white transition-all shadow-lg shadow-rose-500/20 active:scale-95 text-center">
                📞 LLAMAR DE INMEDIATO
              </a>
            ` : ''}
            ${waze_url ? `
              <a href="${waze_url}" target="_blank" rel="noopener" class="flex-grow sm:flex-grow-0 inline-flex items-center justify-center gap-2 px-5 py-3 text-sm font-bold rounded-xl bg-slate-950 border border-slate-800 text-amber-400 hover:text-amber-300 transition-all active:scale-95 text-center">
                🚗 Waze
              </a>
            ` : ''}
            ${maps_url ? `
              <a href="${maps_url}" target="_blank" rel="noopener" class="flex-grow sm:flex-grow-0 inline-flex items-center justify-center gap-2 px-5 py-3 text-sm font-bold rounded-xl bg-slate-950 border border-slate-800 text-slate-300 hover:text-white transition-all active:scale-95 text-center">
                🗺️ Google Maps
              </a>
            ` : ''}
          </div>
        </div>
      `;
      sosContainer.classList.remove('hidden');
      sosContainer.scrollIntoView({ behavior: 'smooth', block: 'start' });
    } else {
      showSOSSafetyNotice('No encontramos clínicas 24/7 abiertas en este momento. Revisa el listado regular abajo:');
    }
  }

  function showSOSSafetyNotice(message: string) {
    const sosContainer = document.getElementById('sos-highlight-container');
    if (!sosContainer) return;
    
    sosContainer.innerHTML = `
      <div class="relative overflow-hidden p-6 rounded-2xl border border-rose-500/30 bg-rose-950/20 shadow-xl flex flex-col gap-3">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 text-xs font-black rounded-full bg-rose-500/10 text-rose-455 border border-rose-500/20 w-fit">
          ⚠️ ATENCIÓN DE EMERGENCIA
        </span>
        <p class="text-sm font-semibold text-slate-200">${message}</p>
      </div>
    `;
    sosContainer.classList.remove('hidden');
    sosContainer.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  // ─── Costa Rica local time ─────────────────────────────────────────────
  function getCostaRicaTime() {
    const options = { timeZone: "America/Costa_Rica", hour12: false } as const;
    const localeString = new Date().toLocaleString("en-US", options);
    const crDate = new Date(localeString);
    return { day: crDate.getDay(), hour: crDate.getHours(), minute: crDate.getMinutes() };
  }

  // ─── Status update ─────────────────────────────────────────────────────
  function updateClinicsStatus() {
    const { day, hour } = getCostaRicaTime();
    const cards = document.querySelectorAll<HTMLElement>('#clinicas-grid article');

    cards.forEach(card => {
      const is247 = card.getAttribute('data-247') === 'true';
      const schedule = card.getAttribute('data-schedule');
      const statusBadge = card.querySelector<HTMLElement>('[data-status-for]');
      
      let isOpen = false;

      if (is247) {
        isOpen = true;
      } else if (schedule && schedule !== '24h') {
        const rules = schedule.split(',');
        for (const rule of rules) {
          const [daysPart, hoursPart] = rule.split(':');
          const [startHour, endHour] = hoursPart.split('-').map(Number);
          if (daysPart.includes('-')) {
            const [startDay, endDay] = daysPart.split('-').map(Number);
            if (day >= startDay && day <= endDay) {
              isOpen = hour >= startHour && hour < endHour;
              break;
            }
          } else {
            if (day === Number(daysPart)) {
              isOpen = hour >= startHour && hour < endHour;
              break;
            }
          }
        }
      }

      card.setAttribute('data-is-open', isOpen ? 'true' : 'false');

      if (statusBadge) {
        if (isOpen) {
          statusBadge.textContent = '🟢 Abierto ahora';
          statusBadge.className = 'status-indicator-badge text-[9px] font-bold px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 w-fit';
        } else {
          statusBadge.textContent = '🔴 Cerrado ahora';
          statusBadge.className = 'status-indicator-badge text-[9px] font-bold px-2 py-0.5 rounded-full bg-slate-900 text-slate-500 border border-slate-800 w-fit';
        }
      }
    });
  }

  // ─── State ─────────────────────────────────────────────────────────────
  let userLat: number | null = null;
  let userLng: number | null = null;
  let geoActive = false;
  let searchQuery = '';
  let filterOnlyOpen = false;
  let filterOnly247 = false;
  let activeAnimal = 'todos';
  let inSOSFlow = false;

  // ─── Apply all filters ─────────────────────────────────────────────────
  function applyAllFilters() {
    if (!inSOSFlow) {
      const sosContainer = document.getElementById('sos-highlight-container');
      if (sosContainer) sosContainer.classList.add('hidden');
    }

    const cards = Array.from(document.querySelectorAll<HTMLElement>('#clinicas-grid article'));
    const emptyState = document.getElementById('empty-state');
    const fallbackSection = document.getElementById('fallback-cercanas');
    const fallbackGrid = document.getElementById('empty-state-fallback-list');
    let visibleCount = 0;
    const visibleCoords: [number, number][] = [];

    cards.forEach(card => {
      const isOpen = card.getAttribute('data-is-open') === 'true';
      const is247 = card.getAttribute('data-247') === 'true';
      const atiendeExoticos = card.getAttribute('data-exoticos') === 'true';
      const atiendeGranja = card.getAttribute('data-granja') === 'true';
      const atiendePeces = card.getAttribute('data-peces') === 'true';
      const confidence = card.getAttribute('data-confidence');
      const status = card.getAttribute('data-record-status');
      const emergencyVerified = card.getAttribute('data-emergency-verified') === 'true';
      const nombre = card.getAttribute('data-nombre') || '';
      const zona = card.getAttribute('data-zona-text') || '';

      let show = true;

      // Safety: hide unverified clinics when filtering for emergency help
      if (filterOnlyOpen || filterOnly247) {
        if (confidence === 'low' || status === 'REVIEW_REQUIRED' || !emergencyVerified) {
          show = false;
        }
      }

      if (filterOnlyOpen && !isOpen) show = false;
      if (filterOnly247 && !is247) show = false;
      if (activeAnimal === 'exoticos' && !atiendeExoticos) show = false;
      if (activeAnimal === 'granja' && !atiendeGranja) show = false;
      if (activeAnimal === 'peces' && !atiendePeces) show = false;

      // Text search
      if (searchQuery) {
        const q = searchQuery.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
        const nameNorm = nombre.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
        const zoneNorm = zona.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
        const provinceNorm = card.getAttribute('data-provincia-text') || '';
        const directionNorm = (card.querySelector('.line-clamp-2')?.textContent || '').toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
        const copyNorm = (card.querySelector('.line-clamp-3')?.textContent || '').toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");

        let match = nameNorm.includes(q) || zoneNorm.includes(q) || provinceNorm.includes(q);

        // Tags/services matching
        if (q.includes("exotic") && atiendeExoticos) match = true;
        if (q.includes("granja") && atiendeGranja) match = true;
        if (q.includes("pece") && atiendePeces) match = true;
        if ((q.includes("domes") || q.includes("perro") || q.includes("gato")) && true) match = true;

        if (!match) {
          show = false;
        }
      }

      if (show) {
        card.classList.remove('hidden');
        visibleCount++;

        const lat = parseFloat(card.getAttribute('data-latitude') || '0');
        const lng = parseFloat(card.getAttribute('data-longitude') || '0');
        if (lat !== 0 && lng !== 0) {
          visibleCoords.push([lat, lng]);
        }
      } else {
        card.classList.add('hidden');
      }

      // Sync map markers with filter state
      const linkEl = card.querySelector('a[id^="clinica-link"]');
      const hrefAttr = linkEl ? linkEl.getAttribute('href') : '';
      const slug = hrefAttr ? hrefAttr.split('/').pop() : '';
      const markers = (window as any).__vet24Markers;
      const map = (window as any).__vet24Map;

      if (markers && map && slug && markers[slug]) {
        if (show) {
          markers[slug].addTo(map);
        } else {
          map.removeLayer(markers[slug]);
        }
      }
    });

    // Empty state handling
    if (emptyState) {
      if (visibleCount === 0) {
        emptyState.classList.remove('hidden');

        // Show nearby fallback if geolocation is active
        if (geoActive && userLat !== null && userLng !== null && fallbackSection && fallbackGrid) {
          const cardsWithCoords = cards
            .filter(c => parseFloat(c.getAttribute('data-latitude') || '0') !== 0)
            .map(c => ({
              el: c,
              dist: haversineKm(userLat!, userLng!, parseFloat(c.getAttribute('data-latitude')!), parseFloat(c.getAttribute('data-longitude')!)),
              nombre: c.getAttribute('data-nombre') || '',
              zone: c.getAttribute('data-zona-text') || '',
              href: c.querySelector('a[id^="clinica-link"]')?.getAttribute('href') || '#',
              is247: c.getAttribute('data-247') === 'true',
            }))
            .sort((a, b) => a.dist - b.dist)
            .slice(0, 3);

          if (cardsWithCoords.length > 0) {
            fallbackGrid.innerHTML = cardsWithCoords.map(({ dist, nombre, zone, href, is247 }) => `
              <a href="${href}" class="flex flex-col gap-1.5 p-4 rounded-xl bg-slate-900/40 border border-amber-500/20 hover:border-amber-500/40 transition-all">
                <div class="flex items-center gap-2 justify-between">
                  <span class="text-xs font-bold text-slate-200 capitalize">${nombre}</span>
                  <span class="text-[9px] font-bold px-1.5 py-0.5 rounded-full ${is247 ? 'bg-rose-500/10 text-rose-400 border border-rose-500/20' : 'bg-slate-800 text-slate-500 border border-slate-700'}">
                    ${is247 ? '24/7' : 'Horario regular'}
                  </span>
                </div>
                <span class="text-[10px] text-slate-500 capitalize">📍 ${zone}</span>
                <span class="text-[10px] font-semibold text-blue-400">🗺️ A ${dist.toFixed(1)} km de ti</span>
              </a>
            `).join('');
            fallbackSection.classList.remove('hidden');
          }
        } else if (fallbackSection) {
          fallbackSection.classList.add('hidden');
        }
      } else {
        emptyState.classList.add('hidden');
        if (fallbackSection) fallbackSection.classList.add('hidden');
      }
    }

    // Auto-fit map bounds to visible markers
    const map = (window as any).__vet24Map;
    const L = (window as any).__vet24L;
    if (map && L) {
      const allCoords = [...visibleCoords];
      if (geoActive && userLat !== null && userLng !== null) {
        allCoords.push([userLat, userLng]);
      }
      if (allCoords.length > 0) {
        const bounds = L.latLngBounds(allCoords);
        map.fitBounds(bounds, { padding: [40, 40], maxZoom: 14 });
      }
    }
  }

  // ─── Sort by proximity ────────────────────────────────────────────────
  function sortByProximity(lat: number, lng: number) {
    const grid = document.getElementById('clinicas-grid');
    if (!grid) return;

    const cards = Array.from(grid.querySelectorAll<HTMLElement>('article'));
    cards.sort((a, b) => {
      const aLat = parseFloat(a.getAttribute('data-latitude') || '0');
      const aLng = parseFloat(a.getAttribute('data-longitude') || '0');
      const bLat = parseFloat(b.getAttribute('data-latitude') || '0');
      const bLng = parseFloat(b.getAttribute('data-longitude') || '0');
      
      const aDist = (aLat === 0 && aLng === 0) ? Infinity : haversineKm(lat, lng, aLat, aLng);
      const bDist = (bLat === 0 && bLng === 0) ? Infinity : haversineKm(lat, lng, bLat, bLng);
      return aDist - bDist;
    });

    // Re-append in sorted order
    cards.forEach(card => grid.appendChild(card));

    // Update distance badges
    cards.forEach(card => {
      const lat2 = parseFloat(card.getAttribute('data-latitude') || '0');
      const lng2 = parseFloat(card.getAttribute('data-longitude') || '0');
      const distBadge = card.querySelector<HTMLElement>('[data-distance-for]');
      if (distBadge) {
        if (lat2 !== 0 || lng2 !== 0) {
          const km = haversineKm(lat, lng, lat2, lng2);
          distBadge.textContent = `📍 A ${km.toFixed(1)} km`;
          distBadge.classList.remove('hidden');
        } else {
          distBadge.textContent = '📍 Sin coordenadas';
          distBadge.classList.remove('hidden');
          distBadge.classList.add('opacity-40');
        }
      }
    });

    // Add user pin to the map if available
    const L = (window as any).__vet24L;
    const map = (window as any).__vet24Map;
    if (L && map) {
      const userIcon = L.divIcon({
        html: `<div style="
          width:16px;height:16px;
          background:#3b82f6;
          border:3px solid white;
          border-radius:50%;
          box-shadow:0 0 0 4px rgba(59,130,246,0.3);
          pointer-events: none;
        "></div>`,
        className: 'user-location-pin',
        iconSize: [16, 16],
        iconAnchor: [8, 8],
      });
      L.marker([lat, lng], { icon: userIcon })
        .addTo(map)
        .bindPopup('<strong style="color:#93c5fd">📍 Tu ubicación</strong>')
        .openPopup();
      map.setView([lat, lng], 11, { animate: true });
    }
  }

  // ─── Setup event listeners ─────────────────────────────────────────────
  function setupFilters() {
    const filterOpenBtn = document.getElementById('filter-quick-open');
    const filter247Btn = document.getElementById('filter-quick-247');
    const geoBtn = document.getElementById('btn-use-location');
    const geoBtnText = document.getElementById('geo-btn-text');
    const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
    const clearBtn = document.getElementById('btn-clear-search');
    const resetBtn = document.getElementById('reset-all-filters');
    const emptyResetBtn = document.getElementById('reset-all-filters-empty');
    const animalFilters = document.querySelectorAll('[data-filter-animal]');

    // ── Search ──
    searchInput?.addEventListener('input', () => {
      searchQuery = searchInput.value.trim().toLowerCase();
      if (clearBtn) clearBtn.classList.toggle('hidden', !searchQuery);
      applyAllFilters();
    });

    clearBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      searchQuery = '';
      clearBtn.classList.add('hidden');
      applyAllFilters();
    });

    // ── Reset all ──
    const handleReset = () => {
      filterOnlyOpen = false;
      filterOnly247 = false;
      activeAnimal = 'todos';
      searchQuery = '';
      if (searchInput) searchInput.value = '';
      if (clearBtn) clearBtn.classList.add('hidden');

      filterOpenBtn?.classList.remove('bg-emerald-500/10', 'text-emerald-400', 'border-emerald-500/25');
      filter247Btn?.classList.remove('bg-rose-500/15', 'text-rose-400', 'border-rose-500/25');

      animalFilters.forEach(b => {
        b.classList.remove('bg-rose-500', 'text-white', 'border-transparent');
        b.classList.add('bg-slate-950/40', 'text-slate-400', 'border-slate-800');
      });
      const todosBtn = document.querySelector<HTMLElement>('[data-filter-animal="todos"]');
      if (todosBtn) {
        todosBtn.classList.remove('bg-slate-950/40', 'text-slate-400', 'border-slate-800');
        todosBtn.classList.add('bg-rose-500', 'text-white', 'border-transparent');
      }
      applyAllFilters();
    };

    resetBtn?.addEventListener('click', handleReset);
    emptyResetBtn?.addEventListener('click', handleReset);

    // ── Open Now ──
    filterOpenBtn?.addEventListener('click', () => {
      filterOnlyOpen = !filterOnlyOpen;
      filterOpenBtn.classList.toggle('bg-emerald-500/10');
      filterOpenBtn.classList.toggle('text-emerald-400');
      filterOpenBtn.classList.toggle('border-emerald-500/25');
      applyAllFilters();
    });

    // ── Solo 24/7 ──
    filter247Btn?.addEventListener('click', () => {
      filterOnly247 = !filterOnly247;
      filter247Btn.classList.toggle('bg-rose-500/15');
      filter247Btn.classList.toggle('text-rose-400');
      filter247Btn.classList.toggle('border-rose-500/25');
      applyAllFilters();
    });

    // ── Geolocation ──
    geoBtn?.addEventListener('click', () => {
      if (!navigator.geolocation) {
        alert('Tu navegador no soporta geolocalización.');
        return;
      }

      if (geoBtnText) geoBtnText.textContent = 'Obteniendo ubicación…';
      geoBtn.classList.add('opacity-60', 'pointer-events-none');

      navigator.geolocation.getCurrentPosition(
        (pos) => {
          userLat = pos.coords.latitude;
          userLng = pos.coords.longitude;
          geoActive = true;

          if (geoBtnText) geoBtnText.textContent = '📍 Ordenado por cercanía';
          geoBtn.classList.remove('opacity-60', 'pointer-events-none');
          geoBtn.classList.add('text-blue-400', 'border-blue-500/30', 'bg-blue-500/5');

          sortByProximity(userLat, userLng);
          applyAllFilters();
        },
        (err) => {
          console.warn('Geolocation error:', err.message);
          if (geoBtnText) geoBtnText.textContent = 'Ordenar por cercanía';
          geoBtn.classList.remove('opacity-60', 'pointer-events-none');
          alert('No pudimos acceder a tu ubicación. Revisa los permisos del navegador.');
        },
        { timeout: 10000, maximumAge: 300000 }
      );
    });

    // ── Animal filters ──
    animalFilters.forEach(btn => {
      btn.addEventListener('click', () => {
        animalFilters.forEach(b => {
          b.classList.remove('bg-rose-500', 'text-white', 'border-transparent');
          b.classList.add('bg-slate-950/40', 'text-slate-400', 'border-slate-800');
        });
        btn.classList.add('bg-rose-500', 'text-white', 'border-transparent');
        btn.classList.remove('bg-slate-950/40', 'text-slate-400', 'border-slate-800');
        activeAnimal = btn.getAttribute('data-filter-animal') || 'todos';
        applyAllFilters();
      });
    });

    // ── SOS Emergency Trigger ──
    const triggerSOSEmergency = () => {
      inSOSFlow = true;
      filterOnlyOpen = true;
      filterOnly247 = true;

      if (filterOpenBtn) {
        filterOpenBtn.classList.add('bg-emerald-500/10', 'text-emerald-400', 'border-emerald-500/25');
      }
      if (filter247Btn) {
        filter247Btn.classList.add('bg-rose-500/15', 'text-rose-400', 'border-rose-500/25');
      }

      const sosContainer = document.getElementById('sos-highlight-container');
      if (sosContainer) sosContainer.classList.add('hidden');

      if (!navigator.geolocation) {
        applyAllFilters();
        inSOSFlow = false;
        showSOSSafetyNotice('Tu navegador no soporta geolocalización, pero filtramos todas las de emergencia 24/7 abiertas ahora.');
        return;
      }

      if (geoBtnText) geoBtnText.textContent = 'Obteniendo ubicación…';
      if (geoBtn) geoBtn.classList.add('opacity-60', 'pointer-events-none');

      navigator.geolocation.getCurrentPosition(
        (pos) => {
          userLat = pos.coords.latitude;
          userLng = pos.coords.longitude;
          geoActive = true;

          if (geoBtnText) geoBtnText.textContent = '📍 Ordenado por cercanía';
          if (geoBtn) {
            geoBtn.classList.remove('opacity-60', 'pointer-events-none');
            geoBtn.classList.add('text-blue-400', 'border-blue-500/30', 'bg-blue-500/5');
          }

          sortByProximity(userLat, userLng);
          applyAllFilters();
          renderClosestSOSEmergency(userLat, userLng);
          inSOSFlow = false;
        },
        (err) => {
          console.warn('Geolocation error during SOS:', err.message);
          if (geoBtnText) geoBtnText.textContent = 'Ordenar por cercanía';
          if (geoBtn) geoBtn.classList.remove('opacity-60', 'pointer-events-none');

          applyAllFilters();
          showSOSSafetyNotice('No pudimos acceder a tu ubicación. Mostrando todas las clínicas de emergencia 24/7 abiertas ahora:');
          inSOSFlow = false;
        },
        { timeout: 10000, maximumAge: 300000 }
      );
    };

    window.addEventListener('sos-trigger', triggerSOSEmergency);

    if (window.location.search.includes('sos=true')) {
      setTimeout(triggerSOSEmergency, 300);
    }
  }

  function init() {
    updateClinicsStatus();
    setupFilters();
  }

  if (document.readyState !== 'loading') {
    init();
  } else {
    document.addEventListener('DOMContentLoaded', init);
  }
</script>
