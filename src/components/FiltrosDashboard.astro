        <span class="text-[10px] text-brand-text-muted font-extrabold uppercase tracking-wider font-['Outfit',sans-serif] mr-1 shrink-0">Especie:</span>
        <button 
          data-filter-animal="todos" 
          class="px-4 py-2 text-xs font-black rounded-xl border border-transparent bg-brand-primary text-white shadow-lg shadow-brand-primary/25 transition-all cursor-pointer active:scale-95 shrink-0 duration-300"
        >
          Todos
        </button>
        <button 
          data-filter-animal="domesticos" 
          class="px-4 py-2 text-xs font-bold rounded-xl border border-brand-card-border bg-brand-bg/40 text-brand-text-muted hover:text-brand-text hover:border-brand-primary/30 transition-all cursor-pointer active:scale-95 shrink-0 duration-200"
        >
          🐶🐱 Domésticos
