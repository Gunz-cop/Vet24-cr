</div>

<!-- SOS Highlight section (shown when SOS mode is activated) -->
<div id="sos-highlight-container" class="hidden mb-8 scroll-mt-24"></div>

<!-- Enhanced empty state with fallback clinics -->
<div id="empty-state" class="hidden w-full">
  <div class="text-center py-10 bg-brand-card-bg/20 border border-dashed border-brand-card-border rounded-2xl p-8 mb-6">
    <div class="text-4xl mb-3">🔍</div>
    <h3 class="text-base font-semibold text-brand-text mb-1">No encontramos veterinarias con estos filtros</h3>
    <p class="text-sm text-brand-text-muted max-w-md mx-auto">Prueba cambiando los filtros o amplía la búsqueda.</p>
    <button id="reset-all-filters-empty" class="mt-4 px-4 py-2 text-xs font-bold rounded-lg bg-brand-primary/10 text-brand-primary border border-brand-primary/20 hover:bg-brand-primary/20 transition-colors cursor-pointer duration-200">
      Restablecer filtros
    </button>
  </div>

  <!-- Nearby fallback section (shown when geolocation is active) -->
  <div id="fallback-cercanas" class="hidden">
    <div class="flex items-center gap-2 mb-4">
      <span class="inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-bold rounded-full bg-brand-secondary/10 text-brand-secondary border border-brand-secondary/20">
        ⚠️ Llamar antes de salir
      </span>
      <span class="text-xs text-brand-text-muted">Las más cercanas a ti (aunque estén cerradas ahora)</span>
    </div>
    <div id="empty-state-fallback-list" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4"></div>
  </div>
</div>

<style>
  .scrollbar-none::-webkit-scrollbar { display: none; }
  .scrollbar-none { -ms-overflow-style: none; scrollbar-width: none; }
</style>

<script>
  // ─── Haversine distance (km) ───────────────────────────────────────────
  function haversineKm(lat1: number, lng1: number, lat2: number, lng2: number): number {
    const R = 6371;
    const dLat = (lat2 - lat1) * Math.PI / 180;
    const dLng = (lng2 - lng1) * Math.PI / 180;
    const a = Math.sin(dLat / 2) ** 2 +
      Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
      Math.sin(dLng / 2) ** 2;
    return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
  }

  // ─── SOS Helpers ───────────────────────────────────────────────────────
  function renderClosestSOSEmergency(lat: number, lng: number) {
    const cards = Array.from(document.querySelectorAll<HTMLElement>('#clinicas-grid article'));
    
    let closestTierAB: HTMLElement | null = null;
    let minDistanceTierAB = Infinity;
    
    let closestOverall: HTMLElement | null = null;
    let minDistanceOverall = Infinity;

    cards.forEach(card => {
      if (card.classList.contains('hidden')) return;
      const isOpen = card.getAttribute('data-is-open') === 'true';
      const cLat = parseFloat(card.getAttribute('data-latitude') || '0');
      const cLng = parseFloat(card.getAttribute('data-longitude') || '0');
      const tier = card.getAttribute('data-tier') || '';
      
      if (isOpen && cLat !== 0 && cLng !== 0) {
        const dist = haversineKm(lat, lng, cLat, cLng);
        
        if (dist < minDistanceOverall) {
          minDistanceOverall = dist;
          closestOverall = card;
        }

        if (tier === 'Tier A' || tier === 'Tier B') {
          if (dist < minDistanceTierAB) {
            minDistanceTierAB = dist;
            closestTierAB = card;
          }
        }
      }
    });

    let closestClinic: HTMLElement | null = null;
    let minDistance = Infinity;
    let isPreferredTier = false;

    // Si hay una clínica de Tier A o B abierta a menos de 15 km, la preferimos por estar más equipada para emergencias.
    // De lo contrario, sugerimos la clínica abierta más cercana en general (que puede ser de horario regular Tier C/D).
    if (closestTierAB && minDistanceTierAB <= 15) {
      closestClinic = closestTierAB;
      minDistance = minDistanceTierAB;
      isPreferredTier = true;
    } else if (closestOverall) {
      closestClinic = closestOverall;
      minDistance = minDistanceOverall;
      const tier = closestClinic.getAttribute('data-tier') || '';
      isPreferredTier = (tier === 'Tier A' || tier === 'Tier B');
    }

    const sosContainer = document.getElementById('sos-highlight-container');
    if (!sosContainer) return;

    if (closestClinic) {
      const el = closestClinic as HTMLElement;
      const nombre = el.getAttribute('data-original-nombre') || '';
      const zona = el.getAttribute('data-zona-text') || '';
      const direccion = el.getAttribute('data-direccion') || '';
      const horarioTexto = el.getAttribute('data-horario-texto') || '';
      const copyDiferenciador = el.getAttribute('data-copy') || '';
      const telefono1 = el.getAttribute('data-telefono') || '';
      const waze_url = el.getAttribute('data-waze-url') || '';
      const maps_url = el.getAttribute('data-maps-url') || '';

      sosContainer.innerHTML = `
        <div class="relative overflow-hidden p-6 rounded-2xl border border-brand-primary/35 bg-brand-card-bg shadow-xl shadow-brand-primary/10 flex flex-col gap-4" id="sos-emergency-card">
          <!-- Badge -->
          <div class="flex flex-col items-start gap-1">
            <span class="inline-flex items-center gap-1.5 px-4 py-2 text-xs font-black rounded-full bg-gradient-to-r from-brand-primary to-brand-primary-hover text-white shadow-lg shadow-brand-primary/20">
              🚨 ${isPreferredTier ? 'LA VETERINARIA ABIERTA 24/7 MÁS CERCANA' : 'LA VETERINARIA ABIERTA MÁS CERCANA (HORARIO REGULAR)'}
            </span>
            <span class="text-xs font-black text-brand-primary uppercase tracking-wider mt-2">
              A ${minDistance.toFixed(1)} KM DE TI
            </span>
          </div>

          <!-- Content -->
          <div class="flex flex-col gap-2">
            <h3 class="text-2xl font-black text-brand-text capitalize font-['Outfit',sans-serif]">${nombre}</h3>
            <p class="text-xs text-brand-text-muted capitalize font-semibold flex items-start gap-1">
              <span>📍</span> <span>${zona} — <span class="font-normal text-brand-text-muted">${direccion}</span></span>
            </p>
            <p class="text-xs text-brand-text font-semibold mb-1 flex items-center gap-1.5">
              <span>🕒</span> <span><strong class="font-black text-brand-text">Horario de emergencias:</strong> ${horarioTexto}</span>
            </p>
            <p class="text-xs text-brand-text-muted font-medium leading-relaxed">${copyDiferenciador}</p>
          </div>

          <!-- Divider -->
          <div class="border-t border-brand-card-border my-1"></div>

          <!-- CTAs -->
          <div class="flex flex-col gap-3 w-full">
            ${telefono1 ? `
              <a href="tel:+506${telefono1.replace(/\D/g,'')}" class="w-full inline-flex items-center justify-center gap-2 px-6 py-3.5 text-sm font-extrabold rounded-xl bg-brand-primary text-white hover:bg-brand-primary-hover hover:scale-[1.02] active:scale-[0.98] transition-all duration-200 text-center shadow-lg shadow-brand-primary/20" id="btn-sos-call">
                📞 LLAMAR DE INMEDIATO
              </a>
            ` : ''}
            
            <div class="grid grid-cols-2 gap-3 w-full">
              ${waze_url ? `
                <a href="${waze_url}" target="_blank" rel="noopener" class="w-full inline-flex items-center justify-center gap-2 px-5 py-3 text-sm font-bold rounded-xl bg-brand-bg border border-brand-card-border text-brand-text hover:border-brand-primary/35 hover:bg-brand-primary/10 transition-all active:scale-95 text-center">
                  🚗 Waze
                </a>
              ` : `
                <a href="https://waze.com/ul?q=${encodeURIComponent(nombre + ', ' + direccion)}" target="_blank" rel="noopener" class="w-full inline-flex items-center justify-center gap-2 px-5 py-3 text-sm font-bold rounded-xl bg-brand-bg border border-brand-card-border text-brand-text hover:border-brand-primary/35 hover:bg-brand-primary/10 transition-all active:scale-95 text-center">
                  🚗 Waze
                </a>
              `}
              ${maps_url ? `
                <a href="${maps_url}" target="_blank" rel="noopener" class="w-full inline-flex items-center justify-center gap-2 px-5 py-3 text-sm font-bold rounded-xl bg-brand-bg border border-brand-card-border text-brand-text hover:border-brand-secondary/35 hover:bg-brand-secondary/10 transition-all active:scale-95 text-center">
                  🗺️ Google Maps
                </a>
              ` : `
                <a href="https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(nombre + ', ' + direccion)}" target="_blank" rel="noopener" class="w-full inline-flex items-center justify-center gap-2 px-5 py-3 text-sm font-bold rounded-xl bg-brand-bg border border-brand-card-border text-brand-text hover:border-brand-secondary/35 hover:bg-brand-secondary/10 transition-all active:scale-95 text-center">
                  🗺️ Google Maps
                </a>
              `}
            </div>
          </div>
        </div>
      `;
      sosContainer.classList.remove('hidden');
      sosContainer.scrollIntoView({ behavior: 'smooth', block: 'start' });
    } else {
      showSOSSafetyNotice('No encontramos clínicas abiertas en este momento. Revisa el listado regular abajo:');
    }
  }

  function showSOSSafetyNotice(message: string) {
    const sosContainer = document.getElementById('sos-highlight-container');
    if (!sosContainer) return;
    
    sosContainer.innerHTML = `
      <div class="relative overflow-hidden p-6 rounded-2xl border border-brand-primary/25 bg-brand-primary/5 shadow-xl flex flex-col gap-3">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 text-xs font-black rounded-full bg-brand-primary/10 text-brand-primary border border-brand-primary/20 w-fit">
          ⚠️ ATENCIÓN DE EMERGENCIA
        </span>
        <p class="text-sm font-semibold text-brand-text">${message}</p>
      </div>
    `;
    sosContainer.classList.remove('hidden');
    sosContainer.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  // ─── Costa Rica local time ─────────────────────────────────────────────
  function getCostaRicaTime() {
    const now = new Date();
    // Costa Rica is UTC-6 all year round (no DST)
    const crTime = new Date(now.getTime() - (6 * 60 * 60 * 1000));
    return {
      day: crTime.getUTCDay(),
      hour: crTime.getUTCHours(),
      minute: crTime.getUTCMinutes()
    };
  }

  // ─── Status update ─────────────────────────────────────────────────────
  function updateClinicsStatus() {
    const { day, hour } = getCostaRicaTime();
    const cards = document.querySelectorAll<HTMLElement>('#clinicas-grid article');

    cards.forEach(card => {
      const is247 = card.getAttribute('data-247') === 'true';
      const schedule = card.getAttribute('data-schedule');
      const statusBadge = card.querySelector<HTMLElement>('[data-status-for]');
      
      let isOpen = false;

      if (is247) {
        isOpen = true;
      } else if (schedule && schedule !== '24h') {
        const rules = schedule.split(',');
        for (const rule of rules) {
          const [daysPart, hoursPart] = rule.split(':');
          const [startHour, endHour] = hoursPart.split('-').map(Number);
          if (daysPart.includes('-')) {
            const [startDay, endDay] = daysPart.split('-').map(Number);
            const isDayMatch = startDay <= endDay 
              ? (day >= startDay && day <= endDay) 
              : (day >= startDay || day <= endDay);
            if (isDayMatch) {
              isOpen = hour >= startHour && hour < endHour;
              break;
            }
          } else {
            if (day === Number(daysPart)) {
              isOpen = hour >= startHour && hour < endHour;
              break;
            }
          }
        }
      }

      card.setAttribute('data-is-open', isOpen ? 'true' : 'false');

      if (statusBadge) {
        if (isOpen) {
          statusBadge.textContent = '🟢 Abierto ahora';
          statusBadge.className = 'status-indicator-badge text-[9px] font-bold px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 w-fit';
        } else {
          statusBadge.textContent = '🔴 Cerrado ahora';
          statusBadge.className = 'status-indicator-badge text-[9px] font-bold px-2 py-0.5 rounded-full bg-slate-900 text-slate-500 border border-slate-800 w-fit';
        }
      }
    });
  }

  // ─── State ─────────────────────────────────────────────────────────────
  let userLat: number | null = null;
  let userLng: number | null = null;
  let geoActive = false;
  let edgeGeoActive = false;
  let searchQuery = '';
  let filterOnlyOpen = false;
  let filterOnly247 = false;
  let activeAnimal = 'todos';
  let inSOSFlow = false;
  let originalCardsOrder: HTMLElement[] = [];
  let autoGeoTimeoutId: any = null;
  let debounceTimeoutId: any = null;

  async function logInteraction(data: { query?: string; province?: string; canton?: string; filter_type?: string }) {
    try {
      let province = data.province || null;
      if (!province) {
        const pathParts = window.location.pathname.split('/').filter(Boolean);
        if (pathParts[0] === 'provincia' && pathParts[1]) {
          province = pathParts[1];
        }
      }
      await fetch('/api/analytics', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          query: data.query || null,
          province: province,
          canton: data.canton || null,
          filter_type: data.filter_type || null
        })
      });
    } catch (e) {
      console.warn('Error recording search analytics:', e);
    }
  }

  function scrollToFirstVisibleResult() {
    const firstVisibleCard = document.querySelector<HTMLElement>('#clinicas-grid article:not(.hidden)');
    const emptyState = document.getElementById('empty-state');
    const target = firstVisibleCard || (emptyState && !emptyState.classList.contains('hidden') ? emptyState : null);
    if (!target) return;

    window.setTimeout(() => {
      const top = target.getBoundingClientRect().top + window.scrollY - 88;
      window.scrollTo({ top: Math.max(top, 0), behavior: 'smooth' });
    }, 80);
  }

  // Helper to restore original order and reset proximity status
  function restoreDefaultSorting() {
    const grid = document.getElementById('clinicas-grid');
    if (!grid || originalCardsOrder.length === 0) return;

    // Re-append in original priority order
    originalCardsOrder.forEach(card => grid.appendChild(card));

    const edgeActive = grid.getAttribute('data-edge-active') === 'true';
    const edgeLatAttr = grid.getAttribute('data-edge-lat');
    const edgeLngAttr = grid.getAttribute('data-edge-lng');

    // Hide or update distance badges based on server-side geolocation fallback
    originalCardsOrder.forEach(card => {
      const distBadge = card.querySelector<HTMLElement>('[data-distance-for]');
      if (distBadge) {
        if (edgeActive && edgeLatAttr && edgeLngAttr) {
          const cLat = parseFloat(card.getAttribute('data-latitude') || '0');
          const cLng = parseFloat(card.getAttribute('data-longitude') || '0');
          if (cLat !== 0 || cLng !== 0) {
            const km = haversineKm(parseFloat(edgeLatAttr), parseFloat(edgeLngAttr), cLat, cLng);
            distBadge.textContent = `📍 A ${km.toFixed(1)} km`;
            distBadge.classList.remove('hidden');
          } else {
            distBadge.classList.add('hidden');
            distBadge.textContent = '';
          }
        } else {
          distBadge.classList.add('hidden');
          distBadge.textContent = '';
        }
      }
    });

    // Reset state variables
    geoActive = false;

    if (edgeActive && edgeLatAttr && edgeLngAttr) {
      userLat = parseFloat(edgeLatAttr);
      userLng = parseFloat(edgeLngAttr);
      edgeGeoActive = true;

      const geoBtn = document.getElementById('btn-use-location');
      const geoBtnText = document.getElementById('geo-btn-text');
      const cityAttr = grid.getAttribute('data-edge-city');
      if (geoBtnText) geoBtnText.textContent = cityAttr ? 'Ubicación aproximada' : 'Cerca de tu zona';
      if (geoBtn) {
        geoBtn.classList.remove('opacity-60', 'pointer-events-none');
        geoBtn.classList.add('text-brand-primary', 'border-brand-primary/25', 'bg-brand-primary/10');
      }
    } else {
      userLat = null;
      userLng = null;
      edgeGeoActive = false;

      const geoBtn = document.getElementById('btn-use-location');
      const geoBtnText = document.getElementById('geo-btn-text');
      if (geoBtnText) geoBtnText.textContent = 'Ordenar por cercanía';
      if (geoBtn) {
        geoBtn.classList.remove('text-brand-primary', 'border-brand-primary/25', 'bg-brand-primary/10', 'opacity-60', 'pointer-events-none');
      }
    }

    // Remove user pin from the map
    const map = (window as any).__vet24Map;
    if (map) {
      map.eachLayer((layer: any) => {
        if (layer.options && layer.options.icon && layer.options.icon.options && layer.options.icon.options.className === 'user-location-pin') {
          map.removeLayer(layer);
        }
      });
    }
  }

  // ─── Apply all filters ─────────────────────────────────────────────────
  function applyAllFilters() {
    if (!inSOSFlow) {
      const sosContainer = document.getElementById('sos-highlight-container');
      if (sosContainer) sosContainer.classList.add('hidden');
    }

    const cards = Array.from(document.querySelectorAll<HTMLElement>('#clinicas-grid article'));
    const emptyState = document.getElementById('empty-state');
    const fallbackSection = document.getElementById('fallback-cercanas');
    const fallbackGrid = document.getElementById('empty-state-fallback-list');
    let visibleCount = 0;
    const visibleCoords: [number, number][] = [];

    cards.forEach(card => {
      const isOpen = card.getAttribute('data-is-open') === 'true';
      const is247 = card.getAttribute('data-247') === 'true';
      const atiendeExoticos = card.getAttribute('data-exoticos') === 'true';
      const atiendeGranja = card.getAttribute('data-granja') === 'true';
      const atiendePeces = card.getAttribute('data-peces') === 'true';
      const confidence = card.getAttribute('data-confidence');
      const status = card.getAttribute('data-record-status');
      const emergencyVerified = card.getAttribute('data-emergency-verified') === 'true';
      const nombre = card.getAttribute('data-nombre') || '';
      const zona = card.getAttribute('data-zona-text') || '';

      let show = true;

      // Safety: hide unverified clinics when filtering for emergency help
      if (filterOnly247) {
        if (confidence === 'low' || status === 'REVIEW_REQUIRED' || !emergencyVerified) {
          show = false;
        }
      } else if (filterOnlyOpen) {
        // En búsqueda diurna (Abierto Ahora), permitimos veterinarias diurnas normales que sean confiables,
        // pero seguimos filtrando aquellas con baja confianza, en revisión, o si dicen ser 24/7 sin verificación.
        if (confidence === 'low' || status === 'REVIEW_REQUIRED') {
          show = false;
        } else if (is247 && !emergencyVerified) {
          show = false;
        }
      }

      if (filterOnlyOpen && !isOpen) show = false;
      if (filterOnly247 && !is247) show = false;
      if (activeAnimal === 'exoticos' && !atiendeExoticos) show = false;
      if (activeAnimal === 'granja' && !atiendeGranja) show = false;
      if (activeAnimal === 'peces' && !atiendePeces) show = false;

      // Text search
      if (searchQuery) {
        const q = searchQuery.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
        const nameNorm = nombre.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
        const zoneNorm = zona.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
        const provinceNorm = card.getAttribute('data-provincia-text') || '';
        const directionNorm = (card.querySelector('.line-clamp-2')?.textContent || '').toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
        const copyNorm = (card.querySelector('.line-clamp-3')?.textContent || '').toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");

        let match = nameNorm.includes(q) || zoneNorm.includes(q) || provinceNorm.includes(q);

        // Tags/services matching
        if (q.includes("exotic") && atiendeExoticos) match = true;
        if (q.includes("granja") && atiendeGranja) match = true;
        if (q.includes("pece") && atiendePeces) match = true;
        if ((q.includes("domes") || q.includes("perro") || q.includes("gato")) && true) match = true;

        if (!match) {
          show = false;
        }
      }

      if (show) {
        card.classList.remove('hidden');
        visibleCount++;

        const lat = parseFloat(card.getAttribute('data-latitude') || '0');
        const lng = parseFloat(card.getAttribute('data-longitude') || '0');
        if (lat !== 0 && lng !== 0) {
          visibleCoords.push([lat, lng]);
        }
      } else {
        card.classList.add('hidden');
      }

      // Sync map markers with filter state
      const linkEl = card.querySelector('a[id^="clinica-link"]');
      const hrefAttr = linkEl ? linkEl.getAttribute('href') : '';
      const slug = hrefAttr ? hrefAttr.split('/').filter(Boolean).pop() : '';
      const markers = (window as any).__vet24Markers;
      const map = (window as any).__vet24Map;

      if (markers && map && slug && markers[slug]) {
        if (show) {
          markers[slug].addTo(map);
        } else {
          map.removeLayer(markers[slug]);
        }
      }
    });

    // Empty state handling
    if (emptyState) {
      if (visibleCount === 0) {
        emptyState.classList.remove('hidden');

        // Show nearby fallback if geolocation is active (either browser GPS or server Edge IP)
        if ((geoActive || edgeGeoActive) && userLat !== null && userLng !== null && fallbackSection && fallbackGrid) {
          const cardsWithCoords = cards
            .filter(c => parseFloat(c.getAttribute('data-latitude') || '0') !== 0)
            .map(c => ({
              el: c,
              dist: haversineKm(userLat!, userLng!, parseFloat(c.getAttribute('data-latitude')!), parseFloat(c.getAttribute('data-longitude')!)),
              nombre: c.getAttribute('data-nombre') || '',
              zone: c.getAttribute('data-zona-text') || '',
              href: c.querySelector('a[id^="clinica-link"]')?.getAttribute('href') || '#',
              is247: c.getAttribute('data-247') === 'true',
            }))
            .sort((a, b) => a.dist - b.dist)
            .slice(0, 3);

          if (cardsWithCoords.length > 0) {
            fallbackGrid.innerHTML = cardsWithCoords.map(({ dist, nombre, zone, href, is247 }) => `
              <a href="${href}" class="flex flex-col gap-1.5 p-4 rounded-xl bg-brand-card-bg border border-brand-card-border hover:border-brand-primary/35 transition-all">
                <div class="flex items-center gap-2 justify-between">
                  <span class="text-xs font-bold text-brand-text capitalize">${nombre}</span>
                  <span class="text-[9px] font-bold px-1.5 py-0.5 rounded-full ${is247 ? 'bg-brand-danger-bg text-brand-primary border border-brand-danger-border' : 'bg-brand-card-bg border border-brand-card-border text-brand-text-muted'}">
                    ${is247 ? '24/7' : 'Horario regular'}
                  </span>
                </div>
                <span class="text-[10px] text-brand-text-muted capitalize">📍 ${zone}</span>
                <span class="text-[10px] font-semibold text-brand-primary">🗺️ A ${dist.toFixed(1)} km de ti</span>
              </a>
            `).join('');
            fallbackSection.classList.remove('hidden');
          }
        } else if (fallbackSection) {
          fallbackSection.classList.add('hidden');
        }
      } else {
        emptyState.classList.add('hidden');
        if (fallbackSection) fallbackSection.classList.add('hidden');
      }
    }

    // Auto-fit map bounds to visible markers
    const map = (window as any).__vet24Map;
    const L = (window as any).__vet24L;
    if (map && L) {
      const allCoords = [...visibleCoords];
      if (geoActive && userLat !== null && userLng !== null) {
        allCoords.push([userLat, userLng]);
      }
      if (allCoords.length > 0) {
        const bounds = L.latLngBounds(allCoords);
        map.fitBounds(bounds, { padding: [40, 40], maxZoom: 14 });
      }
    }
  }

  // Helper to draw user location marker on the map safely when Leaflet is ready
  function drawUserPinOnMap(lat: number, lng: number) {
    const L = (window as any).__vet24L;
    const map = (window as any).__vet24Map;
    if (L && map) {
      // First clean up any existing user pins
      map.eachLayer((layer: any) => {
        if (layer.options && layer.options.icon && layer.options.icon.options && layer.options.icon.options.className === 'user-location-pin') {
          map.removeLayer(layer);
        }
      });

      const userIcon = L.divIcon({
        html: `<div style="
          width:16px;height:16px;
          background:#f43f5e;
          border:3px solid white;
          border-radius:50%;
          box-shadow:0 0 0 4px rgba(244,63,94,0.3);
          pointer-events: none;
        "></div>`,
        className: 'user-location-pin',
        iconSize: [16, 16],
        iconAnchor: [8, 8],
      });
      L.marker([lat, lng], { icon: userIcon })
        .addTo(map)
        .bindPopup('<strong style="color:#f43f5e">📍 Tu ubicación</strong>')
        .openPopup();
      map.setView([lat, lng], 11, { animate: true });
    }
  }

  // ─── Sort by proximity ────────────────────────────────────────────────
  function sortByProximity(lat: number, lng: number) {
    // Dynamically trigger map initialization in background without rendering block if not ready yet
    if (!(window as any).__vet24Map && (window as any).__triggerMapInitialization) {
      (window as any).__triggerMapInitialization().then(() => {
        drawUserPinOnMap(lat, lng);
      });
    } else {
      drawUserPinOnMap(lat, lng);
    }

    const grid = document.getElementById('clinicas-grid');
    if (!grid) return;

    const cards = Array.from(grid.querySelectorAll<HTMLElement>('article'));
    cards.sort((a, b) => {
      const aLat = parseFloat(a.getAttribute('data-latitude') || '0');
      const aLng = parseFloat(a.getAttribute('data-longitude') || '0');
      const bLat = parseFloat(b.getAttribute('data-latitude') || '0');
      const bLng = parseFloat(b.getAttribute('data-longitude') || '0');
      
      const aDist = (aLat === 0 && aLng === 0) ? Infinity : haversineKm(lat, lng, aLat, aLng);
      const bDist = (bLat === 0 && bLng === 0) ? Infinity : haversineKm(lat, lng, bLat, bLng);
      return aDist - bDist;
    });

    // Re-append in sorted order
    cards.forEach(card => grid.appendChild(card));

    // Update distance badges
    cards.forEach(card => {
      const lat2 = parseFloat(card.getAttribute('data-latitude') || '0');
      const lng2 = parseFloat(card.getAttribute('data-longitude') || '0');
      const distBadge = card.querySelector<HTMLElement>('[data-distance-for]');
      if (distBadge) {
        if (lat2 !== 0 || lng2 !== 0) {
          const km = haversineKm(lat, lng, lat2, lng2);
          distBadge.textContent = `📍 A ${km.toFixed(1)} km`;
          distBadge.classList.remove('hidden');
        } else {
          distBadge.textContent = '📍 Sin coordenadas';
          distBadge.classList.remove('hidden');
          distBadge.classList.add('opacity-40');
        }
      }
    });
  }

  // ─── Setup event listeners ─────────────────────────────────────────────
  function setupFilters() {
    const filterOpenBtn = document.getElementById('filter-quick-open');
    const filter247Btn = document.getElementById('filter-quick-247');
    const geoBtn = document.getElementById('btn-use-location');
    const geoBtnText = document.getElementById('geo-btn-text');
    const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
    const clearBtn = document.getElementById('btn-clear-search');
    const resetBtn = document.getElementById('reset-all-filters');
    const emptyResetBtn = document.getElementById('reset-all-filters-empty');
    const animalFilters = document.querySelectorAll('[data-filter-animal]');

    // ── Search ──
    searchInput?.addEventListener('input', () => {
      searchQuery = searchInput.value.trim().toLowerCase();
      if (clearBtn) clearBtn.classList.toggle('hidden', !searchQuery);
      applyAllFilters();

      // Debounce analytics
      if (debounceTimeoutId) clearTimeout(debounceTimeoutId);
      if (searchQuery) {
        debounceTimeoutId = setTimeout(() => {
          logInteraction({ query: searchQuery, filter_type: 'search' });
        }, 1500);
      }
    });

    clearBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      searchQuery = '';
      clearBtn.classList.add('hidden');
      applyAllFilters();
    });

    // ── Reset all ──
    const handleReset = () => {
      filterOnlyOpen = false;
      filterOnly247 = false;
      activeAnimal = 'todos';
      searchQuery = '';
      if (searchInput) searchInput.value = '';
      if (clearBtn) clearBtn.classList.add('hidden');

      filterOpenBtn?.classList.remove('bg-brand-success-bg', 'text-brand-success', 'border-brand-success-border');
      filter247Btn?.classList.remove('bg-brand-danger-bg', 'text-brand-danger-text', 'border-brand-danger-border');

      animalFilters.forEach(b => {
        b.classList.remove('bg-brand-primary', 'text-white', 'border-transparent');
        b.classList.add('bg-brand-card-bg', 'text-brand-text-muted', 'border-brand-card-border');
      });
      const todosBtn = document.querySelector<HTMLElement>('[data-filter-animal="todos"]');
      if (todosBtn) {
        todosBtn.classList.remove('bg-brand-card-bg', 'text-brand-text-muted', 'border-brand-card-border');
        todosBtn.classList.add('bg-brand-primary', 'text-white', 'border-transparent');
      }

      restoreDefaultSorting();
      applyAllFilters();
      scrollToFirstVisibleResult();
    };

    resetBtn?.addEventListener('click', handleReset);
    emptyResetBtn?.addEventListener('click', handleReset);

    // ── Open Now ──
    filterOpenBtn?.addEventListener('click', () => {
      filterOnlyOpen = !filterOnlyOpen;
      filterOpenBtn.classList.toggle('bg-brand-success-bg');
      filterOpenBtn.classList.toggle('text-brand-success');
      filterOpenBtn.classList.toggle('border-brand-success-border');
      applyAllFilters();
      scrollToFirstVisibleResult();
      logInteraction({ filter_type: filterOnlyOpen ? 'filter_open_true' : 'filter_open_false' });
    });

    // ── Solo 24/7 ──
    filter247Btn?.addEventListener('click', () => {
      filterOnly247 = !filterOnly247;
      filter247Btn.classList.toggle('bg-brand-danger-bg');
      filter247Btn.classList.toggle('text-brand-danger-text');
      filter247Btn.classList.toggle('border-brand-danger-border');
      applyAllFilters();
      scrollToFirstVisibleResult();
      logInteraction({ filter_type: filterOnly247 ? 'filter_247_true' : 'filter_247_false' });
    });

    // ── Geolocation ──
    geoBtn?.addEventListener('click', () => {
      if (autoGeoTimeoutId) {
        clearTimeout(autoGeoTimeoutId);
      }
      if (geoActive) {
        restoreDefaultSorting();
        applyAllFilters();
        return;
      }

      if (!navigator.geolocation) {
        alert('Tu navegador no soporta geolocalización.');
        return;
      }

      if (geoBtnText) geoBtnText.textContent = 'Obteniendo ubicación…';
      geoBtn.classList.add('opacity-60', 'pointer-events-none');

      navigator.geolocation.getCurrentPosition(
        (pos) => {
          userLat = pos.coords.latitude;
          userLng = pos.coords.longitude;
          geoActive = true;

          if (geoBtnText) geoBtnText.textContent = '📍 Ordenado por cercanía';
          geoBtn.classList.remove('opacity-60', 'pointer-events-none');
          geoBtn.classList.add('text-brand-primary', 'border-brand-primary/25', 'bg-brand-primary/10');

          sortByProximity(userLat, userLng);
          applyAllFilters();
          scrollToFirstVisibleResult();
          logInteraction({ filter_type: 'geo_gps_success' });
        },
        (err) => {
          console.warn('Geolocation error:', err.message);
          if (geoBtnText) geoBtnText.textContent = 'Ordenar por cercanía';
          geoBtn.classList.remove('opacity-60', 'pointer-events-none');
          alert('No pudimos acceder a tu ubicación. Revisa los permisos del navegador.');
          logInteraction({ filter_type: 'geo_gps_error' });
        },
        { timeout: 10000, maximumAge: 300000 }
      );
    });

    // ── Animal filters ──
    animalFilters.forEach(btn => {
      btn.addEventListener('click', () => {
        animalFilters.forEach(b => {
          b.classList.remove('bg-brand-primary', 'text-white', 'border-transparent');
          b.classList.add('bg-brand-card-bg', 'text-brand-text-muted', 'border-brand-card-border');
        });
        btn.classList.add('bg-brand-primary', 'text-white', 'border-transparent');
        btn.classList.remove('bg-brand-card-bg', 'text-brand-text-muted', 'border-brand-card-border');
        activeAnimal = btn.getAttribute('data-filter-animal') || 'todos';
        applyAllFilters();
        scrollToFirstVisibleResult();
        logInteraction({ filter_type: `filter_animal_${activeAnimal}` });
      });
    });

    // ── SOS Emergency Trigger ──
    const triggerSOSEmergency = () => {
      if (autoGeoTimeoutId) {
        clearTimeout(autoGeoTimeoutId);
      }
      inSOSFlow = true;
      filterOnlyOpen = true;
      filterOnly247 = false; // Permitimos cualquier clínica abierta, no solo 24/7, para atender emergencias diurnas localmente

      if (filterOpenBtn) {
        filterOpenBtn.classList.add('bg-brand-success-bg', 'text-brand-success', 'border-brand-success-border');
      }
      if (filter247Btn) {
        // En SOS diurno no forzamos el filtro visual de 24/7
        filter247Btn.classList.remove('bg-brand-danger-bg', 'text-brand-danger-text', 'border-brand-danger-border');
      }

      const sosContainer = document.getElementById('sos-highlight-container');
      if (sosContainer) sosContainer.classList.add('hidden');

      if (!navigator.geolocation) {
        applyAllFilters();
        inSOSFlow = false;
        showSOSSafetyNotice('Tu navegador no soporta geolocalización, pero filtramos todas las clínicas abiertas en este momento.');
        return;
      }

      if (geoBtnText) geoBtnText.textContent = 'Obteniendo ubicación…';
      if (geoBtn) geoBtn.classList.add('opacity-60', 'pointer-events-none');

      navigator.geolocation.getCurrentPosition(
        (pos) => {
          userLat = pos.coords.latitude;
          userLng = pos.coords.longitude;
          geoActive = true;

          if (geoBtnText) geoBtnText.textContent = '📍 Ordenado por cercanía';
          if (geoBtn) {
            geoBtn.classList.remove('opacity-60', 'pointer-events-none');
            geoBtn.classList.add('text-brand-primary', 'border-brand-primary/25', 'bg-brand-primary/10');
          }

          sortByProximity(userLat, userLng);
          applyAllFilters();
          renderClosestSOSEmergency(userLat, userLng);
          inSOSFlow = false;
        },
        (err) => {
          console.warn('Geolocation error during SOS:', err.message);
          if (geoBtnText) geoBtnText.textContent = 'Ordenar por cercanía';
          if (geoBtn) geoBtn.classList.remove('opacity-60', 'pointer-events-none');

          applyAllFilters();
          showSOSSafetyNotice('No pudimos acceder a tu ubicación. Mostrando todas las clínicas abiertas en este momento:');
          inSOSFlow = false;
        },
        { timeout: 10000, maximumAge: 300000 }
      );
    };

    window.addEventListener('sos-trigger', triggerSOSEmergency);

    let hasPendingSOS = window.location.search.includes('sos=true');
    try {
      hasPendingSOS = hasPendingSOS || window.sessionStorage.getItem('vet24-sos-pending') === 'true';
      window.sessionStorage.removeItem('vet24-sos-pending');
    } catch (e) {
      console.warn('No se pudo leer el estado SOS pendiente:', e);
    }

    if (hasPendingSOS) {
      setTimeout(triggerSOSEmergency, 300);
    }
  }

  function init() {
    updateClinicsStatus();
    
    // Store original order of clinic cards
    const grid = document.getElementById('clinicas-grid');
    if (grid) {
      originalCardsOrder = Array.from(grid.querySelectorAll<HTMLElement>('article'));

      const edgeActive = grid.getAttribute('data-edge-active') === 'true';
      if (edgeActive) {
        const latAttr = grid.getAttribute('data-edge-lat');
        const lngAttr = grid.getAttribute('data-edge-lng');
        const cityAttr = grid.getAttribute('data-edge-city');
        
        if (latAttr && lngAttr) {
          userLat = parseFloat(latAttr);
          userLng = parseFloat(lngAttr);
          edgeGeoActive = true;
          
          // Update button text to show it is sorted by Edge IP location
          const geoBtnText = document.getElementById('geo-btn-text');
          const geoBtn = document.getElementById('btn-use-location');
          if (geoBtnText) {
            geoBtnText.textContent = cityAttr ? 'Ubicación aproximada' : 'Cerca de tu zona';
          }
          if (geoBtn) {
            geoBtn.classList.add('text-brand-primary', 'border-brand-primary/25', 'bg-brand-primary/10');
          }
        }
      }
    }

    setupFilters();

    // Auto-locate if permission is already granted or on the home page (Todas las provincias)
    const isTodasProvincias = window.location.pathname === '/' || window.location.pathname === '/index.html' || !window.location.pathname.includes('/provincia/');
    const geoBtn = document.getElementById('btn-use-location');
    const geoBtnText = document.getElementById('geo-btn-text');

    if (navigator.geolocation && geoBtn) {
      const triggerAutoGeo = () => {
        if (geoActive) return; // Don't run if already active or clicked
        if (geoBtnText) geoBtnText.textContent = 'Obteniendo ubicación…';
        geoBtn.classList.add('opacity-60', 'pointer-events-none');

        navigator.geolocation.getCurrentPosition(
          (pos) => {
            userLat = pos.coords.latitude;
            userLng = pos.coords.longitude;
            geoActive = true;

            if (geoBtnText) geoBtnText.textContent = '📍 Ordenado por cercanía';
            geoBtn.classList.remove('opacity-60', 'pointer-events-none');
            geoBtn.classList.add('text-brand-primary', 'border-brand-primary/25', 'bg-brand-primary/10');

            sortByProximity(userLat, userLng);
            applyAllFilters();
          },
          (err) => {
            console.warn('Auto-geolocation error:', err.message);
            if (geoBtnText) geoBtnText.textContent = 'Ordenar por cercanía';
            geoBtn.classList.remove('opacity-60', 'pointer-events-none');
          },
          { timeout: 10000, maximumAge: 300000 }
        );
      };

      if (navigator.permissions && navigator.permissions.query) {
        try {
          navigator.permissions.query({ name: 'geolocation' })
            .then((result) => {
              if (result.state === 'granted') {
                triggerAutoGeo();
              } else if (result.state === 'prompt' && isTodasProvincias) {
                // Only prompt automatically on the home page (Todas las provincias) after a short delay
                autoGeoTimeoutId = setTimeout(triggerAutoGeo, 800);
              }
            })
            .catch((err) => {
              console.warn('Permissions query rejected:', err);
              if (isTodasProvincias) autoGeoTimeoutId = setTimeout(triggerAutoGeo, 800);
            });
        } catch (e) {
          console.warn('Permissions query threw error:', e);
          if (isTodasProvincias) autoGeoTimeoutId = setTimeout(triggerAutoGeo, 800);
        }
      } else if (isTodasProvincias) {
        // Fallback for browsers that don't support query permission
        autoGeoTimeoutId = setTimeout(triggerAutoGeo, 800);
      }
    }
  }

  if (document.readyState !== 'loading') {
    init();
  } else {
    document.addEventListener('DOMContentLoaded', init);
  }
</script>
