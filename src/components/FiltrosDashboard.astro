        >
          <span class="h-2 w-2 rounded-full bg-brand-success"></span>
          Abierto Ahora
        </button>
        
        <button 
          id="filter-quick-247" 
          class="inline-flex items-center justify-center gap-1.5 px-3.5 py-2.5 sm:py-2 text-xs font-bold rounded-xl border border-brand-card-border bg-brand-card-bg text-brand-text-muted hover:text-brand-text hover:border-brand-primary/30 transition-all cursor-pointer active:scale-95 duration-200"
        >
          <span class="h-2 w-2 rounded-full bg-brand-danger-text animate-pulse"></span>
          24/7
