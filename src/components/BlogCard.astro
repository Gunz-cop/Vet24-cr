---
import { PILAR_NAMES, blogArticlePath, type BlogEntry } from '../lib/blog';
interface Props { entry: BlogEntry }
const { entry } = Astro.props;
const { title, metaDescription, pilar, slug, autor, datePublished } = entry.data;
---
<article class="h-full rounded-2xl border border-brand-card-border bg-brand-card-bg p-6 flex flex-col gap-3">
  <p class="text-xs font-bold uppercase tracking-wider text-brand-primary">{PILAR_NAMES[pilar]}</p>
  <h2 class="text-xl font-bold leading-tight"><a class="hover:text-brand-primary" href={blogArticlePath(pilar, slug)}>{title}</a></h2>
  <p class="text-sm leading-relaxed text-brand-text-muted flex-grow">{metaDescription}</p>
  <p class="text-xs text-brand-text-muted">Por {autor}{datePublished ? ` · ${datePublished}` : ''}</p>
</article>
