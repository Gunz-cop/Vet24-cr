---
import BadgeHorario from './BadgeHorario.astro';

interface Props {
  clinica: {
    id: number | string;
    nombre: string;
    provincia: string;
    zona: string;
    direccion: string;
    telefono1?: string;
    telefono2?: string;
    whatsapp?: string;
    horarioTexto: string;
    categoriaHorario: "24/7 Emergencias" | "Cierra después 21h" | "Horario normal";
    emergencias24h: boolean;
    atiendeExoticos: boolean;
    cirugiaEmergencia: boolean;
    atiendeGranja?: boolean;
    atiendePeces?: boolean;
    confidence_score?: "high" | "medium" | "low";
    record_status?: "VERIFIED" | "PARTIAL" | "REVIEW_REQUIRED" | "CANDIDATE_REMOVAL";
    emergency_tier?: "Tier A" | "Tier B" | "Tier C" | "Tier D";
    emergency_verified?: boolean;
    last_verified?: string;
    latitude?: number;
    longitude?: number;
    web?: string;
    slug: string;
    copyDiferenciador: string;
  };
}

const { clinica } = Astro.props;

// Helper to clean phone numbers for href links
const cleanPhone = (num: string) => num.replace(/\D/g, '');
const tel1Href = clinica.telefono1 ? `tel:+506${cleanPhone(clinica.telefono1)}` : null;
const whatsappHref = clinica.whatsapp ? `https://wa.me/506${cleanPhone(clinica.whatsapp)}` : null;

// Calculate schedule pattern for client-side JS open/closed status check
let scheduleAttr = "";
if (clinica.emergencias24h) {
  scheduleAttr = "24h";
} else {
  const text = clinica.horarioTexto.toLowerCase();
  if (text.includes("oxígeno") || text.includes("10am-9pm")) {
    scheduleAttr = "1-6:10-21,0:10-20";
  } else if (text.includes("concasa") || text.includes("8am-9pm")) {
    scheduleAttr = "1-5:8-21,6:9-19,0:9-17";
  } else if (text.includes("medical care") || text.includes("9am-9pm")) {
    scheduleAttr = "1-0:9-21";
  } else if (text.includes("hems") || text.includes("9am-7pm")) {
    scheduleAttr = "1-5:9-19,6-0:10-17";
  } else {
    scheduleAttr = "1-6:8-20,0:8-19"; // Default L-S 8-20, D 8-19
  }
}
---

<article 
  class="relative flex flex-col justify-between bg-slate-900/30 border border-slate-800/80 rounded-2xl p-6 hover:border-slate-700/80 hover:bg-slate-900/50 hover:shadow-xl hover:shadow-rose-500/2 transition-all duration-300 group"
  data-247={clinica.emergencias24h ? "true" : "false"}
  data-exoticos={clinica.atiendeExoticos ? "true" : "false"}
  data-granja={clinica.atiendeGranja ? "true" : "false"}
  data-peces={clinica.atiendePeces ? "true" : "false"}
  data-schedule={scheduleAttr}
  data-province={clinica.provincia.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/[^a-z0-9]/g, "-").replace(/-+/g, "-").replace(/^-+|-+$/g, "")}
  data-tier={clinica.emergency_tier || "Tier C"}
  data-record-status={clinica.record_status || "PARTIAL"}
  data-confidence={clinica.confidence_score || "medium"}
  data-emergency-verified={clinica.emergency_verified ? "true" : "false"}
  data-nombre={clinica.nombre.toLowerCase()}
  data-zona-text={clinica.zona.toLowerCase()}
  data-lat={clinica.latitude ?? 0}
  data-lng={clinica.longitude ?? 0}
>
  <div>
    <!-- Header: Schedule Badge & Specializations -->
    <div class="flex flex-wrap items-start justify-between gap-2 mb-4">
      <div class="flex flex-col gap-1.5">
        <BadgeHorario categoriaHorario={clinica.categoriaHorario} />
        <!-- Real-time Status Badge placeholder -->
        <span class="status-indicator-badge text-[10px] font-extrabold px-2 py-0.5 rounded-full bg-slate-950/80 text-slate-400 border border-slate-800 w-fit" data-status-for={clinica.slug}>
          Horario...
        </span>
        {/* Distance badge — injected by geolocation JS */}
        <span class="dist-badge hidden text-[9px] font-semibold px-2 py-0.5 rounded-full bg-blue-500/10 text-blue-400 border border-blue-500/20 w-fit">
          📍 — km
        </span>
        {clinica.last_verified && (
          <span class="text-[9px] text-slate-600 font-medium">
            ✓ Verificado: {clinica.last_verified}
          </span>
        )}
      </div>
      
      <div class="flex flex-wrap items-center gap-1.5 max-w-[55%] justify-end">
        <span class="inline-flex items-center px-1.5 py-0.5 text-[9px] font-medium rounded bg-slate-800/40 text-slate-400 border border-slate-700/40" title="Atiende perros y gatos">
          🐶🐱 Domésticos
        </span>
        {clinica.atiendeExoticos && (
          <span class="inline-flex items-center px-1.5 py-0.5 text-[9px] font-medium rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20" title="Atiende Animales Exóticos">
            🐢 Exóticos
          </span>
        )}
        {clinica.atiendePeces && (
          <span class="inline-flex items-center px-1.5 py-0.5 text-[9px] font-medium rounded bg-cyan-500/10 text-cyan-400 border border-cyan-500/20" title="Atiende Peces">
            🐠 Peces
          </span>
        )}
        {clinica.atiendeGranja && (
          <span class="inline-flex items-center px-1.5 py-0.5 text-[9px] font-medium rounded bg-sky-500/10 text-sky-400 border border-sky-500/20" title="Atiende Animales de Granja (Caballos, Vacas)">
            🐴 Granja
          </span>
        )}
      </div>
    </div>

    <!-- Title & Location -->
    <h3 class="text-lg font-bold text-slate-100 group-hover:text-rose-400 transition-colors mb-2">
      <a href={`/clinica/${clinica.slug}`} id={`clinica-link-${clinica.id}`}>
        {clinica.nombre}
      </a>
    </h3>
    
    <div class="flex items-start gap-1.5 text-xs text-slate-400 mb-3">
      <!-- Location Pin Icon -->
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5 mt-0.5 text-slate-500 shrink-0">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
      </svg>
      <span>
        <strong>{clinica.zona}, {clinica.provincia}</strong> — <span class="line-clamp-2">{clinica.direccion}</span>
      </span>
    </div>

    <!-- Schedule info -->
    <p class="text-xs text-slate-300 font-semibold bg-slate-950/50 px-2.5 py-1.5 rounded-lg border border-slate-800/40 mb-4 flex items-center gap-1.5">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5 text-rose-400">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
      </svg>
      <span>{clinica.horarioTexto}</span>
    </p>

    <!-- Copy snippet -->
    <p class="text-xs text-slate-400 line-clamp-3 mb-6">
      {clinica.copyDiferenciador}
    </p>
  </div>

  <!-- Footer CTA Actions -->
  <div class="mt-auto pt-4 border-t border-slate-800/60 flex flex-col gap-2">
    <div class="grid grid-cols-2 gap-2">
      {tel1Href ? (
        <a href={tel1Href} class="flex items-center justify-center gap-1.5 px-3 py-2 text-xs font-semibold rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 hover:text-white border border-slate-700/50 hover:border-slate-600 transition-colors" id={`btn-call-${clinica.id}`}>
          <!-- Phone Icon -->
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.824-1.802-5.14-4.117-6.942-6.942l1.293-.97c.362-.272.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
          </svg>
          Llamar
        </a>
      ) : (
        <span class="flex items-center justify-center px-3 py-2 text-xs text-slate-600 bg-slate-900/20 border border-slate-900 rounded-lg cursor-not-allowed">
          Sin teléfono
        </span>
      )}

      {whatsappHref ? (
        <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-1.5 px-3 py-2 text-xs font-semibold rounded-lg bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-400 hover:text-emerald-300 border border-emerald-500/25 hover:border-emerald-500/40 transition-colors" id={`btn-wa-${clinica.id}`}>
          <!-- Whatsapp Icon -->
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
            <path d="M13.601 2.326A7.85 7.85 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.93a7.9 7.9 0 0 0 1.08 3.951L0 16l4.2-1.1a7.9 7.9 0 0 0 3.79 1.1h.004c4.368 0 7.926-3.558 7.93-7.93A7.9 7.9 0 0 0 13.6 2.326zM7.994 14.521a6.6 6.6 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.56 6.56 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592m3.69-4.98c-.202-.101-1.202-.594-1.385-.66-.18-.066-.313-.1-.443.1-.129.199-.5.63-.614.763-.114.133-.227.15-.429.049-.202-.102-.852-.314-1.624-.997-.6-.537-1.005-1.201-1.123-1.401-.118-.2-.012-.307.089-.408.09-.091.201-.233.301-.35.1-.117.135-.198.201-.33.067-.133.033-.25-.017-.35-.05-.1-1.385-3.322-1.385-3.322-.202-.489-.406-.407-.55-.407h-.469c-.18 0-.47.067-.716.337-.247.27-1.17 1.144-1.17 2.789s1.202 3.23 1.368 3.45c.166.22 2.36 3.6 5.717 5.048.8.345 1.424.551 1.912.707.8.254 1.528.218 2.102.132.64-.096 1.202-.492 1.372-1.026.17-.534.17-1.001.12-1.096-.05-.095-.18-.147-.38-.25"/>
          </svg>
          WhatsApp
        </a>
      ) : (
        <span class="flex items-center justify-center px-3 py-2 text-xs text-slate-600 bg-slate-900/20 border border-slate-900 rounded-lg cursor-not-allowed">
          Sin WhatsApp
        </span>
      )}
    </div>

    <div class="flex items-center justify-between gap-2 mt-2">
      <a href={`/clinica/${clinica.slug}`} class="flex items-center gap-1 py-1.5 text-xs text-slate-450 hover:text-rose-450 font-medium transition-colors" id={`btn-details-${clinica.id}`}>
        Ver detalles y mapa
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-3 h-3">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
        </svg>
      </a>

      <button 
        class="share-btn flex items-center gap-1.5 py-1 px-2.5 text-xs text-slate-450 hover:text-rose-450 font-semibold transition-all cursor-pointer bg-slate-950/30 hover:bg-slate-900 border border-slate-800/60 rounded-lg"
        data-url={`/clinica/${clinica.slug}`}
        data-title={clinica.nombre}
        id={`btn-share-${clinica.id}`}
      >
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M7.217 10.907a2.25 2.25 0 1 0 0 2.186m0-2.186.002-.006a2.25 2.25 0 1 0-.002.006m0 0a2.25 2.25 0 1 0-.002.006m0 0 3.562-2.078m-3.562 2.078 3.562 2.078M15.75 6.125a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm0 9.75a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z" />
        </svg>
        <span>Compartir</span>
      </button>
    </div>
  </div>
</article>
