---
import BadgeHorario from './BadgeHorario.astro';

interface Props {
  clinica: {
    id: number | string;
    nombre: string;
    provincia: string;
    zona: string;
    direccion: string;
    telefono1?: string;
    telefono2?: string;
    whatsapp?: string;
    horarioTexto: string;
    categoriaHorario: "24/7 Emergencias" | "Cierra después 21h" | "Horario normal";
    emergencias24h: boolean;
    atiendeExoticos: boolean;
    cirugiaEmergencia: boolean;
    atiendeGranja?: boolean;
    atiendePeces?: boolean;
    hotelMascotas?: boolean;
    hotelVerificacion?: "confirmado" | "reportado" | "no-confirmado";
    confidence_score?: "high" | "medium" | "low";
    record_status?: "VERIFIED" | "PARTIAL" | "REVIEW_REQUIRED" | "CANDIDATE_REMOVAL";
    emergency_tier?: "Tier A" | "Tier B" | "Tier C" | "Tier D";
    emergency_verified?: boolean;
    last_verified?: string;
    latitude?: number;
    longitude?: number;
    waze_url?: string;
    maps_url?: string;
    web?: string;
    slug: string;
    copyDiferenciador: string;
  };
  distance?: number;
}

const { clinica, distance } = Astro.props;

// Helper to clean phone numbers for href links
const cleanPhone = (num: string) => num.replace(/\D/g, '');
const tel1Href = clinica.telefono1 ? `tel:+506${cleanPhone(clinica.telefono1)}` : null;
const whatsappHref = clinica.whatsapp ? `https://wa.me/506${cleanPhone(clinica.whatsapp)}` : null;
const wazeHref = clinica.waze_url || `https://waze.com/ul?q=${encodeURIComponent(clinica.nombre + ', ' + clinica.direccion)}`;

// Calculate schedule pattern for client-side JS open/closed status check
const normalizeHours = (text: string) => {
  return text
    .toLowerCase()
    .replace(/\s+/g, '')
    .replace(/:00/g, '')
    .replace(/a\.m\.|am/g, 'am')
    .replace(/p\.m\.|pm/g, 'pm');
};

const hourTo24 = (value: string) => {
  const match = value.match(/^(\d{1,2})(?::(\d{2}))?(am|pm)$/);
  if (!match) return null;
  let hour = Number(match[1]);
  const minutes = match[2] ? Number(match[2]) : 0;
  const period = match[3];
  if (period === 'pm' && hour < 12) hour += 12;
  if (period === 'am' && hour === 12) hour = 0;
  return hour + minutes / 60;
};

const rangeToSchedule = (days: string, start: string, end: string) => {
  const startHour = hourTo24(start);
  const endHour = hourTo24(end);
  if (startHour === null || endHour === null) return "";
  return `${days}:${startHour}-${endHour}`;
};

let scheduleAttr = "";
if (clinica.emergencias24h) {
  scheduleAttr = "24h";
} else {
  const text = normalizeHours(clinica.horarioTexto);
  if (text.includes("oxígeno") || text.includes("10am-9pm")) {
    scheduleAttr = "1-6:10-21,0:10-20";
  } else if (text.includes("concasa") || text.includes("8am-9pm")) {
    scheduleAttr = "1-5:8-21,6:9-19,0:9-17";
  } else if (text.includes("medical care") || text.includes("9am-9pm")) {
    scheduleAttr = "1-0:9-21";
  } else if (text.includes("hems") || text.includes("9am-7pm")) {
    scheduleAttr = "1-5:9-19,6-0:10-17";
  } else {
    const rules: string[] = [];
    const dayPatterns = [
      { pattern: /l-d(\d{1,2}(?::\d{2})?(?:am|pm))-(\d{1,2}(?::\d{2})?(?:am|pm))/, days: "1-0" },
      { pattern: /l-s(\d{1,2}(?::\d{2})?(?:am|pm))-(\d{1,2}(?::\d{2})?(?:am|pm))/, days: "1-6" },
      { pattern: /l-v(\d{1,2}(?::\d{2})?(?:am|pm))-(\d{1,2}(?::\d{2})?(?:am|pm))/, days: "1-5" },
      { pattern: /s-d(?:soloemergencias)?(\d{1,2}(?::\d{2})?(?:am|pm))-(\d{1,2}(?::\d{2})?(?:am|pm))/, days: "6-0" },
      { pattern: /d(?:yferiados)?(\d{1,2}(?::\d{2})?(?:am|pm))-(\d{1,2}(?::\d{2})?(?:am|pm))/, days: "0" },
      { pattern: /s(\d{1,2}(?::\d{2})?(?:am|pm))-(\d{1,2}(?::\d{2})?(?:am|pm))/, days: "6" },
    ];

    for (const { pattern, days } of dayPatterns) {
      const match = text.match(pattern);
      if (match) {
        const rule = rangeToSchedule(days, match[1], match[2]);
        if (rule) rules.push(rule);
      }
    }

    scheduleAttr = [...new Set(rules)].join(",");
  }
}
---
<article
  class="relative flex flex-col justify-between bg-brand-card-bg border border-brand-card-border rounded-2xl p-5 hover:border-brand-primary/40 hover:shadow-lg hover:shadow-black/10 transition-all duration-200 group overflow-hidden"
  data-247={clinica.emergencias24h ? "true" : "false"}
  data-exoticos={clinica.atiendeExoticos ? "true" : "false"}
  data-granja={clinica.atiendeGranja ? "true" : "false"}
  data-peces={clinica.atiendePeces ? "true" : "false"}
  data-hotel={clinica.hotelMascotas ? "true" : "false"}
  data-schedule={scheduleAttr}
  data-province={clinica.provincia.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/[^a-z0-9]/g, "-").replace(/-+/g, "-").replace(/^-+|-+$/g, "")}
  data-tier={clinica.emergency_tier || "Tier C"}
  data-record-status={clinica.record_status || "PARTIAL"}
  data-confidence={clinica.confidence_score || "medium"}
  data-emergency-verified={clinica.emergency_verified ? "true" : "false"}
  data-nombre={clinica.nombre.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "")}
  data-zona-text={clinica.zona.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "")}
  data-provincia-text={clinica.provincia.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "")}
  data-latitude={clinica.latitude ?? 0}
  data-longitude={clinica.longitude ?? 0}
  data-slug={clinica.slug}
  data-is-open="false"
  data-telefono={clinica.telefono1}
  data-waze-url={clinica.waze_url}
  data-maps-url={clinica.maps_url}
  data-original-nombre={clinica.nombre}
  data-direccion={clinica.direccion}
  data-horario-texto={clinica.horarioTexto}
  data-copy={clinica.copyDiferenciador}
>
  {clinica.emergencias24h && (
    <div class="absolute left-0 top-0 bottom-0 w-1 bg-brand-emergency" aria-hidden="true"></div>
  )}

  <div>
    <!-- Status row: live open/closed + distance + 24/7 -->
    <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
      <div class="flex flex-wrap items-center gap-2">
        <span class="status-pill" data-status-for={clinica.slug}>
          Verificando…
        </span>
        <span class={`text-xs font-bold text-brand-primary ${distance !== undefined ? '' : 'hidden'}`} data-distance-for={clinica.slug}>
          {distance !== undefined ? `A ${distance.toFixed(1)} km` : ''}
        </span>
      </div>
      {clinica.categoriaHorario !== "Horario normal" && (
        <BadgeHorario categoriaHorario={clinica.categoriaHorario} />
      )}
    </div>

    <!-- Title -->
    <h3 class="text-lg font-bold text-brand-text group-hover:text-brand-primary transition-colors mb-1.5 font-['Outfit',sans-serif] leading-snug">
      <a href={`/clinica/${clinica.slug}/`} id={`clinica-link-${clinica.id}`}>
        {clinica.nombre}
      </a>
      <span class="hidden" aria-hidden="true">{clinica.nombre.normalize("NFD").replace(/[\u0300-\u036f]/g, "")}</span>
    </h3>

    <!-- Location -->
    <div class="flex items-start gap-1.5 text-sm text-brand-text-muted mb-3 leading-relaxed">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 mt-0.5 shrink-0 text-brand-text-muted">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
      </svg>
      <span>
        <strong class="text-brand-text font-semibold">{clinica.zona}, {clinica.provincia}</strong>
        <span class="block line-clamp-1 text-brand-text-muted/90">{clinica.direccion}</span>
      </span>
    </div>

    <!-- Schedule info -->
    <p class="flex items-center gap-2 text-sm text-brand-text-muted mb-3">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 shrink-0">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
      </svg>
      <span class="line-clamp-1">{clinica.horarioTexto}</span>
    </p>

    <!-- Special species (only exceptions worth flagging) -->
    {(clinica.atiendeExoticos || clinica.atiendePeces || clinica.atiendeGranja || clinica.hotelMascotas) && (
      <div class="flex flex-wrap items-center gap-1.5 mb-3">
        {clinica.atiendeExoticos && (
          <span class="inline-flex items-center px-2 py-0.5 text-xs font-semibold rounded-md bg-brand-surface text-brand-text-muted border border-brand-card-border" title="Atiende animales exóticos">
            🐢 Exóticos
          </span>
        )}
        {clinica.atiendePeces && (
          <span class="inline-flex items-center px-2 py-0.5 text-xs font-semibold rounded-md bg-brand-surface text-brand-text-muted border border-brand-card-border" title="Atiende peces">
            🐠 Peces
          </span>
        )}
        {clinica.atiendeGranja && (
          <span class="inline-flex items-center px-2 py-0.5 text-xs font-semibold rounded-md bg-brand-surface text-brand-text-muted border border-brand-card-border" title="Atiende animales de granja">
            🐴 Granja
          </span>
        )}
        {clinica.hotelMascotas && (
          <span class={`inline-flex items-center px-2 py-0.5 text-xs font-semibold rounded-md border ${clinica.hotelVerificacion === 'confirmado' ? 'bg-brand-success-bg text-brand-success border-brand-success-border' : 'bg-brand-warning-bg text-brand-warning-text border-brand-warning-border'}`} title={clinica.hotelVerificacion === 'confirmado' ? 'Hotel para mascotas confirmado en una fuente pública' : 'Servicio de hotel reportado; confirma cupo y condiciones'}>
            🏨 {clinica.hotelVerificacion === 'confirmado' ? 'Hotel' : 'Hotel reportado'}
          </span>
        )}
      </div>
    )}

    <!-- Copy snippet -->
    <p class="text-sm text-brand-text-muted/90 leading-relaxed line-clamp-2 mb-5">
      {clinica.copyDiferenciador}
    </p>
  </div>

  <!-- Footer CTA Actions -->
  <div class="mt-auto pt-4 border-t border-brand-card-border flex flex-col gap-2.5">
    <div class="grid grid-cols-2 gap-2.5">
      {tel1Href ? (
        <a href={tel1Href} class="flex items-center justify-center gap-1.5 px-3 py-2.5 text-sm font-bold rounded-xl bg-brand-primary text-white hover:bg-brand-primary-hover transition-colors cursor-pointer" id={`btn-call-${clinica.id}`}>
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.824-1.802-5.14-4.117-6.942-6.942l1.293-.97c.362-.272.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
          </svg>
          Llamar
        </a>
      ) : (
        <span class="flex items-center justify-center px-3 py-2.5 text-sm font-semibold text-brand-text-muted/60 bg-brand-surface border border-brand-card-border rounded-xl cursor-not-allowed">
          Sin teléfono
        </span>
      )}

      {whatsappHref ? (
        <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-1.5 px-3 py-2.5 text-sm font-bold rounded-xl bg-brand-success-bg text-brand-success border border-brand-success-border hover:bg-brand-success/20 transition-colors cursor-pointer" id={`btn-wa-${clinica.id}`}>
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="currentColor" viewBox="0 0 16 16">
            <path d="M13.601 2.326A7.85 7.85 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.93a7.9 7.9 0 0 0 1.08 3.951L0 16l4.2-1.1a7.9 7.9 0 0 0 3.79 1.1h.004c4.368 0 7.926-3.558 7.93-7.93A7.9 7.9 0 0 0 13.6 2.326zM7.994 14.521a6.6 6.6 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.56 6.56 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592m3.69-4.98c-.202-.101-1.202-.594-1.385-.66-.18-.066-.313-.1-.443.1-.129.199-.5.63-.614.763-.114.133-.227.15-.429.049-.202-.102-.852-.314-1.624-.997-.6-.537-1.005-1.201-1.123-1.401-.118-.2-.012-.307.089-.408.09-.091.201-.233.301-.35.1-.117.135-.198.201-.33.067-.133.033-.25-.017-.35-.05-.1-1.385-3.322-1.385-3.322-.202-.489-.406-.407-.55-.407h-.469c-.18 0-.47.067-.716.337-.247.27-1.17 1.144-1.17 2.789s1.202 3.23 1.368 3.45c.166.22 2.36 3.6 5.717 5.048.8.345 1.424.551 1.912.707.8.254 1.528.218 2.102.132.64-.096 1.202-.492 1.372-1.026.17-.534.17-1.001.12-1.096-.05-.095-.18-.147-.38-.25"/>
          </svg>
          WhatsApp
        </a>
      ) : (
        <a href={wazeHref} target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-1.5 px-3 py-2.5 text-sm font-bold rounded-xl bg-brand-surface text-brand-text border border-brand-card-border hover:border-brand-primary/40 transition-colors cursor-pointer">
          🚗 Waze
        </a>
      )}
    </div>

    <div class="flex items-center justify-between gap-2 pt-1">
      <a href={`/clinica/${clinica.slug}/`} class="flex items-center gap-1.5 py-1.5 text-sm text-brand-primary hover:text-brand-primary-hover font-bold transition-colors" id={`btn-details-${clinica.id}`}>
        Ver detalles
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
        </svg>
      </a>

      <div class="flex items-center gap-2">
        {whatsappHref && (
          <a href={wazeHref} target="_blank" rel="noopener noreferrer" class="flex items-center gap-1.5 py-1.5 px-2.5 text-xs text-brand-text-muted hover:text-brand-text font-semibold transition-colors bg-brand-surface hover:bg-brand-card-bg border border-brand-card-border rounded-lg" title="Abrir ruta en Waze">
            🚗 Waze
          </a>
        )}
        <button
          class="share-btn flex items-center gap-1.5 py-1.5 px-2.5 text-xs text-brand-text-muted hover:text-brand-text font-semibold transition-colors cursor-pointer bg-brand-surface hover:bg-brand-card-bg border border-brand-card-border rounded-lg"
          data-url={`/clinica/${clinica.slug}/`}
          data-title={clinica.nombre}
          id={`btn-share-${clinica.id}`}
          aria-label={`Compartir ${clinica.nombre}`}
        >
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7.217 10.907a2.25 2.25 0 1 0 0 2.186m0-2.186.002-.006a2.25 2.25 0 1 0-.002.006m0 0a2.25 2.25 0 1 0-.002.006m0 0 3.562-2.078m-3.562 2.078 3.562 2.078M15.75 6.125a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm0 9.75a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z" />
          </svg>
          <span>Compartir</span>
        </button>
      </div>
    </div>
  </div>
</article>
