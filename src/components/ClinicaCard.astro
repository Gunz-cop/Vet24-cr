---
import BadgeHorario from './BadgeHorario.astro';

interface Props {
  clinica: {
    id: number | string;
    nombre: string;
    provincia: string;
    zona: string;
    direccion: string;
    telefono1?: string;
    telefono2?: string;
    whatsapp?: string;
    horarioTexto: string;
    categoriaHorario: "24/7 Emergencias" | "Cierra después 21h" | "Horario normal";
    emergencias24h: boolean;
    atiendeExoticos: boolean;
    cirugiaEmergencia: boolean;
    atiendeGranja?: boolean;
    atiendePeces?: boolean;
    confidence_score?: "high" | "medium" | "low";
    record_status?: "VERIFIED" | "PARTIAL" | "REVIEW_REQUIRED" | "CANDIDATE_REMOVAL";
    emergency_tier?: "Tier A" | "Tier B" | "Tier C" | "Tier D";
    emergency_verified?: boolean;
    last_verified?: string;
    latitude?: number;
    longitude?: number;
    web?: string;
    slug: string;
    copyDiferenciador: string;
  };
  distance?: number;
}

const { clinica, distance } = Astro.props;

// Helper to clean phone numbers for href links
const cleanPhone = (num: string) => num.replace(/\D/g, '');
const tel1Href = clinica.telefono1 ? `tel:+506${cleanPhone(clinica.telefono1)}` : null;
const whatsappHref = clinica.whatsapp ? `https://wa.me/506${cleanPhone(clinica.whatsapp)}` : null;

// Calculate schedule pattern for client-side JS open/closed status check
let scheduleAttr = "";
if (clinica.emergencias24h) {
  scheduleAttr = "24h";
} else {
  const text = clinica.horarioTexto.toLowerCase();
  if (text.includes("oxígeno") || text.includes("10am-9pm")) {
    scheduleAttr = "1-6:10-21,0:10-20";
  } else if (text.includes("concasa") || text.includes("8am-9pm")) {
    scheduleAttr = "1-5:8-21,6:9-19,0:9-17";
  } else if (text.includes("medical care") || text.includes("9am-9pm")) {
    scheduleAttr = "1-0:9-21";
  } else if (text.includes("hems") || text.includes("9am-7pm")) {
    scheduleAttr = "1-5:9-19,6-0:10-17";
  } else {
    scheduleAttr = "1-6:8-20,0:8-19"; // Default L-S 8-20, D 8-19
  }
}
---
<article 
  class="relative flex flex-col justify-between bg-brand-card-bg/40 backdrop-blur-md border border-brand-card-border rounded-2xl p-6 pl-8 hover:border-brand-primary/45 hover:shadow-2xl hover:shadow-brand-primary/5 hover:scale-[1.015] -translate-y-0.5 hover:-translate-y-1 transition-all duration-300 group overflow-hidden"
  data-247={clinica.emergencias24h ? "true" : "false"}
  data-exoticos={clinica.atiendeExoticos ? "true" : "false"}
  data-granja={clinica.atiendeGranja ? "true" : "false"}
  data-peces={clinica.atiendePeces ? "true" : "false"}
  data-schedule={scheduleAttr}
  data-province={clinica.provincia.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/[^a-z0-9]/g, "-").replace(/-+/g, "-").replace(/^-+|-+$/g, "")}
  data-tier={clinica.emergency_tier || "Tier C"}
  data-record-status={clinica.record_status || "PARTIAL"}
  data-confidence={clinica.confidence_score || "medium"}
  data-emergency-verified={clinica.emergency_verified ? "true" : "false"}
  data-nombre={clinica.nombre.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "")}
  data-zona-text={clinica.zona.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "")}
  data-provincia-text={clinica.provincia.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "")}
  data-latitude={clinica.latitude ?? 0}
  data-longitude={clinica.longitude ?? 0}
  data-slug={clinica.slug}
  data-is-open="false"
  data-telefono={clinica.telefono1}
  data-waze-url={clinica.waze_url}
  data-maps-url={clinica.maps_url}
  data-original-nombre={clinica.nombre}
  data-direccion={clinica.direccion}
  data-horario-texto={clinica.horarioTexto}
  data-copy={clinica.copyDiferenciador}
>
  <!-- Urgency indicator stripe on left edge -->
  <div class={`absolute left-0 top-0 bottom-0 w-2 transition-all duration-300 ${clinica.emergencias24h ? 'bg-gradient-to-b from-brand-primary to-brand-primary-hover shadow-[0_0_12px_rgba(255,46,99,0.3)]' : 'bg-brand-secondary/60'}`}></div>

  <div>
    <!-- Header: Schedule Badge & Specializations -->
    <div class="flex flex-wrap items-start justify-between gap-2 mb-4">
      <div class="flex flex-col gap-1.5">
        <BadgeHorario categoriaHorario={clinica.categoriaHorario} />
        <!-- Real-time Status Badge placeholder -->
        <span class="status-indicator-badge text-[10px] font-extrabold px-2 py-0.5 rounded-full bg-brand-bg/85 text-brand-text-muted border border-brand-card-border w-fit" data-status-for={clinica.slug}>
          Horario...
        </span>
        <span class={`text-[9px] font-black px-2 py-0.5 rounded-full bg-brand-primary/10 text-brand-primary border border-brand-primary/20 w-fit ${distance !== undefined ? '' : 'hidden'}`} data-distance-for={clinica.slug}>
          {distance !== undefined ? `📍 A ${distance.toFixed(1)} km` : ''}
        </span>
        {clinica.last_verified && (
          <span class="text-[9px] text-brand-text-muted/70 font-bold">
            ✓ Verificado: {clinica.last_verified}
          </span>
        )}
      </div>
      
      <div class="flex flex-wrap items-center gap-1.5 max-w-[55%] justify-end">
        <span class="inline-flex items-center px-1.5 py-0.5 text-[9px] font-extrabold rounded bg-brand-bg/60 text-brand-text-muted border border-brand-card-border/70" title="Atiende perros y gatos">
          🐶🐱 Domésticos
        </span>
        {clinica.atiendeExoticos && (
          <span class="inline-flex items-center px-1.5 py-0.5 text-[9px] font-extrabold rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20" title="Atiende Animales Exóticos">
            🐢 Exóticos
          </span>
        )}
        {clinica.atiendePeces && (
          <span class="inline-flex items-center px-1.5 py-0.5 text-[9px] font-extrabold rounded bg-cyan-500/10 text-cyan-400 border border-cyan-500/20" title="Atiende Peces">
            🐠 Peces
          </span>
        )}
        {clinica.atiendeGranja && (
          <span class="inline-flex items-center px-1.5 py-0.5 text-[9px] font-extrabold rounded bg-sky-500/10 text-sky-400 border border-sky-500/20" title="Atiende Animales de Granja (Caballos, Vacas)">
            🐴 Granja
          </span>
        )}
      </div>
    </div>

    <!-- Title & Location -->
    <h3 class="text-lg font-black text-brand-text group-hover:text-brand-primary transition-colors mb-2 font-['Outfit',sans-serif]">
      <a href={`/clinica/${clinica.slug}/`} id={`clinica-link-${clinica.id}`}>
        {clinica.nombre}
      </a>
      <span class="hidden" aria-hidden="true">{clinica.nombre.normalize("NFD").replace(/[\u0300-\u036f]/g, "")}</span>
    </h3>
    
    <div class="flex items-start gap-1.5 text-xs text-brand-text-muted mb-3 leading-relaxed">
      <!-- Location Pin Icon -->
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-3.5 h-3.5 mt-0.5 text-brand-primary shrink-0">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
      </svg>
      <span>
        <strong class="text-brand-text font-extrabold">{clinica.zona}, {clinica.provincia}</strong> — <span class="line-clamp-2 text-brand-text-muted/95 font-medium">{clinica.direccion}</span>
      </span>
    </div>

    <!-- Schedule info -->
    <p class="text-xs text-brand-text font-bold bg-brand-bg/50 px-2.5 py-2 rounded-xl border border-brand-card-border mb-4 flex items-center gap-2 transition-colors duration-200">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4 text-brand-primary">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
      </svg>
      <span>{clinica.horarioTexto}</span>
    </p>

    <!-- Copy snippet -->
    <p class="text-xs text-brand-text-muted/90 font-medium leading-relaxed line-clamp-3 mb-6">
      {clinica.copyDiferenciador}
    </p>
  </div>

  <!-- Footer CTA Actions -->
  <div class="mt-auto pt-4 border-t border-brand-card-border/60 flex flex-col gap-2">
    <div class="grid grid-cols-2 gap-2">
      {tel1Href ? (
        <a href={tel1Href} class="flex items-center justify-center gap-1.5 px-3.5 py-2.5 text-xs font-black rounded-xl bg-brand-primary text-white hover:bg-brand-primary-hover shadow-md shadow-brand-primary/10 hover:shadow-brand-primary/25 hover:scale-[1.03] active:scale-[0.97] transition-all duration-300 cursor-pointer" id={`btn-call-${clinica.id}`}>
          <!-- Phone Icon -->
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-3.5 h-3.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.824-1.802-5.14-4.117-6.942-6.942l1.293-.97c.362-.272.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
          </svg>
          Llamar
        </a>
      ) : (
        <span class="flex items-center justify-center px-3.5 py-2.5 text-xs font-bold text-brand-text-muted/60 bg-brand-bg/40 border border-brand-card-border/80 rounded-xl cursor-not-allowed">
          Sin teléfono
        </span>
      )}

      {whatsappHref ? (
        <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-1.5 px-3.5 py-2.5 text-xs font-black rounded-xl bg-brand-success-bg hover:bg-brand-success/15 text-brand-success border border-brand-success-border hover:scale-[1.03] active:scale-[0.97] transition-all duration-300 cursor-pointer animate-[pulse_6s_infinite]" id={`btn-wa-${clinica.id}`}>
          <!-- Whatsapp Icon -->
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
            <path d="M13.601 2.326A7.85 7.85 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.93a7.9 7.9 0 0 0 1.08 3.951L0 16l4.2-1.1a7.9 7.9 0 0 0 3.79 1.1h.004c4.368 0 7.926-3.558 7.93-7.93A7.9 7.9 0 0 0 13.6 2.326zM7.994 14.521a6.6 6.6 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.56 6.56 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592m3.69-4.98c-.202-.101-1.202-.594-1.385-.66-.18-.066-.313-.1-.443.1-.129.199-.5.63-.614.763-.114.133-.227.15-.429.049-.202-.102-.852-.314-1.624-.997-.6-.537-1.005-1.201-1.123-1.401-.118-.2-.012-.307.089-.408.09-.091.201-.233.301-.35.1-.117.135-.198.201-.33.067-.133.033-.25-.017-.35-.05-.1-1.385-3.322-1.385-3.322-.202-.489-.406-.407-.55-.407h-.469c-.18 0-.47.067-.716.337-.247.27-1.17 1.144-1.17 2.789s1.202 3.23 1.368 3.45c.166.22 2.36 3.6 5.717 5.048.8.345 1.424.551 1.912.707.8.254 1.528.218 2.102.132.64-.096 1.202-.492 1.372-1.026.17-.534.17-1.001.12-1.096-.05-.095-.18-.147-.38-.25"/>
          </svg>
          WhatsApp
        </a>
      ) : (
        <span class="flex items-center justify-center px-3.5 py-2.5 text-xs font-bold text-brand-text-muted/60 bg-brand-bg/40 border border-brand-card-border/80 rounded-xl cursor-not-allowed">
          Sin WhatsApp
        </span>
      )}
    </div>

    <div class="flex items-center justify-between gap-2 mt-2 pt-2 border-t border-brand-card-border/50">
      <a href={`/clinica/${clinica.slug}/`} class="flex items-center gap-1.5 py-1.5 text-xs text-brand-primary hover:text-brand-primary-hover font-black transition-colors" id={`btn-details-${clinica.id}`}>
        Ver detalles y mapa
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
        </svg>
      </a>

      <button 
        class="share-btn flex items-center gap-1.5 py-1.5 px-3 text-xs text-brand-text-muted hover:text-brand-primary font-bold transition-all cursor-pointer bg-brand-card-bg/60 hover:bg-brand-primary/10 border border-brand-card-border rounded-xl active:scale-95"
        data-url={`/clinica/${clinica.slug}/`}
        data-title={clinica.nombre}
        id={`btn-share-${clinica.id}`}
      >
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M7.217 10.907a2.25 2.25 0 1 0 0 2.186m0-2.186.002-.006a2.25 2.25 0 1 0-.002.006m0 0a2.25 2.25 0 1 0-.002.006m0 0 3.562-2.078m-3.562 2.078 3.562 2.078M15.75 6.125a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm0 9.75a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z" />
        </svg>
        <span>Compartir</span>
      </button>
    </div>
  </div>
</article>
