---
interface ClinicaMapData {
  nombre: string;
  slug: string;
  zona: string;
  telefono1?: string;
  emergencias24h: boolean;
  latitude: number;
  longitude: number;
  waze_url?: string;
  maps_url?: string;
  emergency_tier?: string;
  confidence_score?: string;
}

interface Props {
  clinicas: ClinicaMapData[];
}

const { clinicas } = Astro.props;

// Only include clinics with valid coordinates
const clinicasConCoords = clinicas.filter(c => c.latitude !== 0 && c.longitude !== 0);
const clinicasJson = JSON.stringify(clinicasConCoords);
---

<div class="w-full mb-8 rounded-2xl overflow-hidden border border-slate-800/60 bg-slate-950/40" id="mapa-container">
  <div class="flex items-center justify-between px-4 py-3 bg-slate-900/50 border-b border-slate-800/60">
    <div class="flex items-center gap-2">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-rose-400">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498 4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 0 0-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0Z" />
      </svg>
      <span class="text-xs font-bold text-slate-300 uppercase tracking-wide">Mapa Interactivo</span>
      <span class="text-xs text-slate-500">— {clinicasConCoords.length} clínicas con ubicación</span>
    </div>
    <button 
      id="toggle-mapa-btn"
      class="text-xs font-semibold text-slate-400 hover:text-slate-200 transition-colors px-2 py-1 rounded bg-slate-800/50 hover:bg-slate-800 border border-slate-700/50"
    >
      Ocultar mapa
    </button>
  </div>
  
  <div id="mapa-wrapper" style="height: 420px; position: relative;">
    <!-- Loading placeholder -->
    <div id="mapa-loading" class="absolute inset-0 flex flex-col items-center justify-center bg-slate-950 z-10">
      <div class="w-8 h-8 border-2 border-rose-500 border-t-transparent rounded-full animate-spin mb-3"></div>
      <p class="text-sm text-slate-400">Cargando mapa…</p>
    </div>
    <div id="mapa-vet24" style="height: 100%; width: 100%;"></div>
  </div>
</div>

<!-- Inject clinic data for the map script -->
<script type="application/json" id="clinicas-map-data" set:text={clinicasJson}></script>

<!-- Leaflet CSS -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />

<script>
  // Load Leaflet dynamically
  async function loadLeaflet(): Promise<any> {
    return new Promise((resolve, reject) => {
      if ((window as any).L) { resolve((window as any).L); return; }
      const script = document.createElement('script');
      script.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
      script.integrity = 'sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV/XN2GqnA=';
      script.crossOrigin = '';
      script.onload = () => resolve((window as any).L);
      script.onerror = reject;
      document.head.appendChild(script);
    });
  }

  interface ClinicaPoint {
    nombre: string;
    slug: string;
    zona: string;
    telefono1?: string;
    emergencias24h: boolean;
    latitude: number;
    longitude: number;
    waze_url?: string;
    maps_url?: string;
    emergency_tier?: string;
    confidence_score?: string;
  }

  async function initMap() {
    const dataEl = document.getElementById('clinicas-map-data');
    if (!dataEl) return;

    let clinicas: ClinicaPoint[] = [];
    try {
      clinicas = JSON.parse(dataEl.textContent || '[]');
    } catch (e) {
      console.error('Error parsing clinic data', e);
      return;
    }

    const L = await loadLeaflet();

    const mapEl = document.getElementById('mapa-vet24');
    const loading = document.getElementById('mapa-loading');
    if (!mapEl) return;

    // Init map centered on Costa Rica
    const map = L.map('mapa-vet24', {
      center: [9.95, -84.10],
      zoom: 9,
      zoomControl: true,
      attributionControl: true,
    });

    // OpenStreetMap tiles
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
      maxZoom: 18,
    }).addTo(map);

    // Custom icon factory
    function createIcon(color: string) {
      return L.divIcon({
        html: `<div style="
          width: 28px; height: 28px; 
          background: ${color}; 
          border: 3px solid white; 
          border-radius: 50% 50% 50% 0; 
          transform: rotate(-45deg);
          box-shadow: 0 2px 8px rgba(0,0,0,0.5);
        "></div>`,
        className: '',
        iconSize: [28, 28],
        iconAnchor: [14, 28],
        popupAnchor: [0, -30],
      });
    }

    const iconTierA  = createIcon('#ef4444'); // red - 24/7 real
    const iconTierB  = createIcon('#f59e0b'); // amber - extended hours
    const iconTierC  = createIcon('#64748b'); // slate - normal hours

    // Add markers for each clinic
    clinicas.forEach((c) => {
      if (!c.latitude || !c.longitude) return;

      const icon = c.emergencias24h ? iconTierA : 
                   (c.emergency_tier === 'Tier B' ? iconTierB : iconTierC);

      const callBtn = c.telefono1 
        ? `<a href="tel:+506${c.telefono1.replace(/\D/g,'')}" style="
            display:inline-flex;align-items:center;gap:4px;
            padding:6px 12px;border-radius:8px;
            background:#1e293b;color:#e2e8f0;
            font-size:11px;font-weight:700;text-decoration:none;
            border:1px solid #334155;
          ">📞 Llamar</a>` 
        : '';

      const wazeBtn = c.waze_url 
        ? `<a href="${c.waze_url}" target="_blank" rel="noopener" style="
            display:inline-flex;align-items:center;gap:4px;
            padding:6px 12px;border-radius:8px;
            background:#0f172a;color:#fb923c;
            font-size:11px;font-weight:700;text-decoration:none;
            border:1px solid #7c3aed55;
          ">🗺️ Waze</a>`
        : '';

      const statusBadge = c.emergencias24h 
        ? '<span style="background:#dc262620;color:#f87171;border:1px solid #dc262630;padding:2px 8px;border-radius:99px;font-size:10px;font-weight:700;">🔴 24/7</span>'
        : '<span style="background:#1e293b;color:#94a3b8;border:1px solid #334155;padding:2px 8px;border-radius:99px;font-size:10px;">Horario regular</span>';

      const popup = L.popup({
        maxWidth: 240,
        className: 'vet24-popup',
      }).setContent(`
        <div style="font-family:'Outfit',system-ui,sans-serif;padding:4px;">
          <div style="margin-bottom:8px;">${statusBadge}</div>
          <strong style="font-size:14px;color:#f1f5f9;display:block;margin-bottom:2px;">${c.nombre}</strong>
          <span style="font-size:11px;color:#94a3b8;">📍 ${c.zona}</span>
          <div style="margin-top:10px;display:flex;gap:6px;flex-wrap:wrap;">
            ${callBtn}
            ${wazeBtn}
          </div>
          <a href="/clinica/${c.slug}" style="
            display:block;margin-top:8px;
            font-size:10px;color:#f87171;text-decoration:none;font-weight:600;
          ">Ver detalles →</a>
        </div>
      `);

      L.marker([c.latitude, c.longitude], { icon })
        .addTo(map)
        .bindPopup(popup);
    });

    // Hide loading overlay
    if (loading) loading.style.display = 'none';

    // Expose map and leaflet instance globally for geolocation
    (window as any).__vet24Map = map;
    (window as any).__vet24L = L;
  }

  // Toggle map visibility
  document.getElementById('toggle-mapa-btn')?.addEventListener('click', () => {
    const wrapper = document.getElementById('mapa-wrapper');
    const btn = document.getElementById('toggle-mapa-btn');
    if (!wrapper || !btn) return;
    const hidden = wrapper.style.display === 'none';
    wrapper.style.display = hidden ? '' : 'none';
    btn.textContent = hidden ? 'Ocultar mapa' : 'Mostrar mapa';
  });

  // Init on load
  document.addEventListener('DOMContentLoaded', initMap);
</script>

<style is:global>
  /* Override Leaflet popup styles for dark theme */
  .leaflet-popup-content-wrapper {
    background: #0f172a !important;
    border: 1px solid #1e293b !important;
    border-radius: 12px !important;
    box-shadow: 0 8px 32px rgba(0,0,0,0.6) !important;
    color: #f1f5f9 !important;
  }
  .leaflet-popup-tip {
    background: #0f172a !important;
  }
  .leaflet-popup-close-button {
    color: #64748b !important;
  }
  .leaflet-popup-close-button:hover {
    color: #f87171 !important;
  }
  .leaflet-container {
    background: #020617 !important;
  }
  .leaflet-control-zoom a {
    background: #0f172a !important;
    color: #94a3b8 !important;
    border-color: #1e293b !important;
  }
  .leaflet-control-zoom a:hover {
    background: #1e293b !important;
    color: #f1f5f9 !important;
  }
  .leaflet-control-attribution {
    background: rgba(2, 6, 23, 0.7) !important;
    color: #475569 !important;
    font-size: 9px !important;
  }
  .leaflet-control-attribution a {
    color: #64748b !important;
  }
</style>
