---
import { EZOIC_ENABLED, EZOIC_PLACEHOLDERS, type AdSlot } from '../config/ads';

interface Props {
  /** Posición concreta dentro del sitio; mapea a un placeholder de Ezoic. */
  slot: AdSlot;
  /** Tamaño reservado, para evitar layout shift mientras carga el anuncio. */
  size: '320x50' | '300x250';
}

const { slot, size } = Astro.props;

const dimensions = {
  '320x50': { width: 320, height: 50 },
  '300x250': { width: 300, height: 250 },
} as const;

const { width, height } = dimensions[size];
const placeholderId = EZOIC_PLACEHOLDERS[slot];
const active = EZOIC_ENABLED && placeholderId !== null;
---

{active && (
  <div
    class={`ad-banner ad-banner--${size}`}
    role="region"
    aria-label="Publicidad"
    data-ad-size={size}
    data-ad-slot={slot}
  >
    <span class="ad-banner__label" aria-hidden="true">PUBLICIDAD</span>
    <div
      class="ad-banner__slot"
      style={`width: ${width}px; min-height: ${height}px;`}
    >
      <div id={`ezoic-pub-ad-placeholder-${placeholderId}`}></div>
      <script is:inline define:vars={{ placeholderId }}>
        // Se acumulan los IDs presentes en la página; BaseLayout hace una sola
        // llamada a showAds() al final del body con todos ellos.
        (window.__vet24EzoicIds = window.__vet24EzoicIds || []).push(placeholderId);
      </script>
    </div>
  </div>
)}
