---
interface Props {
  activeProvincia?: string; // normalized slug, e.g. "san-jose"
}

const { activeProvincia } = Astro.props;

const provincias = [
  { nombre: "Todas", code: "CR", slug: "todas", href: "/" },
  { nombre: "San José", code: "SJ", slug: "san-jose", href: "/provincia/san-jose" },
  { nombre: "Heredia", code: "HE", slug: "heredia", href: "/provincia/heredia" },
  { nombre: "Alajuela", code: "AL", slug: "alajuela", href: "/provincia/alajuela" },
  { nombre: "Cartago", code: "CA", slug: "cartago", href: "/provincia/cartago" },
  { nombre: "Guanacaste", code: "GU", slug: "guanacaste", href: "/provincia/guanacaste" },
  { nombre: "Puntarenas", code: "PU", slug: "puntarenas", href: "/provincia/puntarenas" },
  { nombre: "Limón", code: "LI", slug: "limon", href: "/provincia/limon" }
];

const currentSlug = activeProvincia || "todas";
---

<div class="w-full mb-8">
  <h2 class="text-xs font-black text-brand-text-muted uppercase tracking-wider mb-4 block font-['Outfit',sans-serif]">
    Filtrar por Provincia
  </h2>
  
  <nav class="flex items-center gap-3 overflow-x-auto pb-4 -mx-4 px-4 sm:mx-0 sm:px-0 scrollbar-none" aria-label="Filtro de provincias">
    {provincias.map((prov) => {
      const isActive = currentSlug === prov.slug;
      return (
        <a
          href={prov.href}
          id={`filter-prov-${prov.slug}`}
          class={`inline-flex items-center gap-2 px-4 py-2.5 text-xs sm:text-sm font-bold rounded-2xl border whitespace-nowrap transition-all duration-300 group cursor-pointer ${
            isActive
              ? "bg-gradient-to-r from-brand-primary to-brand-primary-hover text-white border-transparent shadow-lg shadow-brand-primary/25 scale-[1.03]"
              : "bg-brand-card-bg/55 backdrop-blur-md hover:bg-brand-primary/10 text-brand-text-muted hover:text-brand-text border-brand-card-border hover:border-brand-primary/30 hover:scale-[1.01]"
          }`}
        >
          <span class={`text-[9px] font-black px-1.5 py-0.5 rounded transition-colors duration-300 ${
            isActive
              ? "bg-white/20 text-white"
              : "bg-brand-bg/60 text-brand-text-muted group-hover:text-brand-primary group-hover:bg-brand-primary/10"
          }`}>
            {prov.code}
          </span>
          {prov.nombre}
        </a>
      );
    })}
  </nav>
</div>

<style>
  /* Hide scrollbar for Chrome, Safari and Opera */
  .scrollbar-none::-webkit-scrollbar {
    display: none;
  }
  /* Hide scrollbar for IE, Edge and Firefox */
  .scrollbar-none {
    -ms-overflow-style: none;  /* IE and Edge */
    scrollbar-width: none;  /* Firefox */
  }
</style>
