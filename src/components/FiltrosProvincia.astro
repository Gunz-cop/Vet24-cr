---
interface Props {
  activeProvincia?: string; // normalized slug, e.g. "san-jose"
}

const { activeProvincia } = Astro.props;

const provincias = [
  { nombre: "Todas", slug: "todas", href: "/#clinicas-grid" },
  { nombre: "San José", slug: "san-jose", href: "/provincia/san-jose/#clinicas-grid" },
  { nombre: "Heredia", slug: "heredia", href: "/provincia/heredia/#clinicas-grid" },
  { nombre: "Alajuela", slug: "alajuela", href: "/provincia/alajuela/#clinicas-grid" },
  { nombre: "Cartago", slug: "cartago", href: "/provincia/cartago/#clinicas-grid" },
  { nombre: "Guanacaste", slug: "guanacaste", href: "/provincia/guanacaste/#clinicas-grid" },
  { nombre: "Puntarenas", slug: "puntarenas", href: "/provincia/puntarenas/#clinicas-grid" },
  { nombre: "Limón", slug: "limon", href: "/provincia/limon/#clinicas-grid" }
];

const currentSlug = activeProvincia || "todas";
---

<div class="w-full mb-6">
  <h2 class="text-xs font-bold text-brand-text-muted uppercase tracking-wider mb-2.5 font-['Outfit',sans-serif]">
    Filtrar por provincia
  </h2>

  <nav class="flex items-center gap-2 overflow-x-auto pb-2 -mx-4 px-4 sm:mx-0 sm:px-0 scrollbar-none" aria-label="Filtro de provincias">
    {provincias.map((prov) => {
      const isActive = currentSlug === prov.slug;
      return (
        <a
          href={prov.href}
          id={`filter-prov-${prov.slug}`}
          class={`filter-chip shrink-0 ${isActive ? "is-active" : ""}`}
          aria-current={isActive ? "page" : undefined}
        >
          {prov.nombre}
        </a>
      );
    })}
  </nav>
</div>
