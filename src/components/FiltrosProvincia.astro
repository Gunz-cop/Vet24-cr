---
interface Props {
  activeProvincia?: string; // normalized slug, e.g. "san-jose"
}

const { activeProvincia } = Astro.props;

const provincias = [
  { nombre: "Todas las Provincias", slug: "todas", href: "/" },
  { nombre: "San José", slug: "san-jose", href: "/provincia/san-jose" },
  { nombre: "Heredia", slug: "heredia", href: "/provincia/heredia" },
  { nombre: "Alajuela", slug: "alajuela", href: "/provincia/alajuela" },
  { nombre: "Cartago", slug: "cartago", href: "/provincia/cartago" },
  { nombre: "Guanacaste", slug: "guanacaste", href: "/provincia/guanacaste" },
  { nombre: "Puntarenas", slug: "puntarenas", href: "/provincia/puntarenas" },
  { nombre: "Limón", slug: "limon", href: "/provincia/limon" }
];

const currentSlug = activeProvincia || "todas";
---

<div class="w-full mb-8">
  <h2 class="text-xs font-semibold text-brand-text-muted uppercase tracking-wider mb-3 block">
    Filtrar por Provincia
  </h2>
  
  <nav class="flex items-center gap-2 overflow-x-auto pb-3 -mx-4 px-4 sm:mx-0 sm:px-0 scrollbar-none" aria-label="Filtro de provincias">
    {provincias.map((prov) => {
      const isActive = currentSlug === prov.slug;
      return (
        <a
          href={prov.href}
          id={`filter-prov-${prov.slug}`}
          class={`inline-flex items-center justify-center px-4 py-2 text-xs sm:text-sm font-semibold rounded-full border whitespace-nowrap transition-all duration-200 ${
            isActive
              ? "bg-gradient-to-r from-brand-primary to-brand-secondary text-white border-transparent shadow-md shadow-brand-primary/25 scale-[1.02]"
              : "bg-brand-card-bg hover:bg-brand-primary/10 text-brand-text-muted hover:text-brand-text border-brand-card-border hover:border-brand-primary/30"
          }`}
        >
          {prov.nombre}
        </a>
      );
    })}
  </nav>
</div>

<style>
  /* Hide scrollbar for Chrome, Safari and Opera */
  .scrollbar-none::-webkit-scrollbar {
    display: none;
  }
  /* Hide scrollbar for IE, Edge and Firefox */
  .scrollbar-none {
    -ms-overflow-style: none;  /* IE and Edge */
    scrollbar-width: none;  /* Firefox */
  }
</style>
